---
/**
 * The one button component. Renders <a> when `href` is given, <button>
 * otherwise. Both use the global `.btn` class so they render identically.
 */
import { href as toHref } from '@lib/href';

interface Props {
  href?: string;
  /** solid = Geist primary, ghost = Geist secondary. */
  variant?: 'solid' | 'ghost';
  /** Geist sizes: small 32px, medium 40px (default), large 48px. */
  size?: 'small' | 'medium' | 'large';
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
}
const { href, variant = 'solid', size = 'medium', type = 'button', external = false, class: cls } = Astro.props;
const classes = ['btn', variant === 'ghost' && 'btn--ghost', size !== 'medium' && `btn--${size}`, cls];
---

{
  href ? (
    <a
      class:list={classes}
      href={toHref(href)}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <slot />
      {external && <span aria-hidden="true">&#8599;</span>}
      {external && <span class="visually-hidden">(opens in a new tab)</span>}
    </a>
  ) : (
    <button class:list={classes} type={type}>
      <slot />
    </button>
  )
}
