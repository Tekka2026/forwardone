---
/**
 * The FWD.one logo as a still mark: the owner's file
 * (src/assets/brand/fwd-one-logo.svg, 940 × 267, FWD and "one"; supplied
 * 2026-11-26, replacing the FWD.ONE drawn from the site logo on 2026-11-19).
 * Used in the LP portal preview's top bar. Drawn in the text colour
 * (currentColor), decorative (aria-hidden); size it by height.
 */
import logo from '../../assets/brand/fwd-one-logo.svg?raw';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const svg = logo
  .replace(/fill="#0F121A"/g, 'fill="currentColor"')
  .replace('<svg ', `<svg class="${['logo-mark', cls].filter(Boolean).join(' ')}" aria-hidden="true" focusable="false" `);
---

<Fragment set:html={svg} />

<style>
  :global(.logo-mark) {
    display: block;
    height: 100%;
    width: auto;
  }
</style>
