---
/**
 * The logo (owner, 2026-11-16): the FORWARD wordmark from the owner's
 * storyboard (glyphs and motion in src/lib/wordmark.mjs). It stays pinned
 * at its place top-left while the page scrolls, and follows the scroll
 * (owner, 2026-11-16): scrolling down closes it to FWD (W and D slide
 * together, O, R, A and R go back into their slots), scrolling up opens it
 * to FORWARD again, by how far you scroll (320px for the whole way); at the
 * top it is always FORWARD. No fade: solid letters,
 * revealed by their slots only. Colour (owner, 2026-11-16): FORWARD / FWD
 * white over dark areas, black elsewhere; ".ONE" yellow (#FFEA6D) for
 * investors and before a choice, light blue (#B3DAFF) for founders. 18px high (14px on narrow phones).
 *
 * A spacer keeps the logo's place in the header row; the link itself is
 * moved out of the header by the script and is position: fixed at the
 * spacer's spot. Without JavaScript it is simply FORWARD, in the header.
 *
 * `classic`: the old FORWARD.one wordmark (src/assets/brand/forwardone.svg),
 * static, in the text colour. Kept for the co-branded landing page
 * (/the-pitch, also pasted into Webflow), which shows partner logos beside it.
 */
import { href } from '@lib/href';
import { site } from '@content/nav';
import { GLYPHS, layout } from '@lib/wordmark.mjs';
import wordmark from '../../assets/brand/forwardone.svg?raw';
import dotOneSvg from '../../assets/brand/dot-one.svg?raw';

interface Props {
  classic?: boolean;
}
const { classic = false } = Astro.props;

const mark = wordmark.replace('<svg ', '<svg class="logo__mark" aria-hidden="true" focusable="false" ');
// FORWARD, as rendered before the script runs (and without it).
const open = layout(1);
const SLOTS = ['O', 'R', 'A', 'R2'] as const;
// ".ONE" after the D (owner, 2026-11-16): the owner's DOTONE.svg (the
// full stop, O, N, E; 452 × 159, the wordmark's own cap height), placed in
// the storyboard frame so the full stop sits 18 units after the D's bowl,
// on the same baseline. It moves with the D (FORWARD.ONE, FWD.ONE) and
// slides in from behind the D through a slanted slot a second after load.
const ONE_PATHS = [...dotOneSvg.matchAll(/<path d="([^"]+)"/g)].map((m) => m[1]);
const ONE_X = 1419 + 18 - 6.24; // D's right edge at the full stop's top, a gap, the stop's own inset
const ONE_Y = 461;
const SLANT = 0.1839;
// The slot: everything right of a slanted line just before the full stop.
const slotAt = (y: number) => ONE_X + 6.24 - 3 - SLANT * (y - 585);
const ONE_SLOT = `${slotAt(430).toFixed(1)},430 2200,430 2200,650 ${slotAt(650).toFixed(1)},650`;
// The storyboard's 1920×1080 frame, cropped to the wordmark and ".ONE".
const VIEWBOX = '498 456 1388 168';
---

{
  classic ? (
    <a class="logo" href={href('/')} aria-label={`${site.name} home`} set:html={mark} />
  ) : (
    <>
      <span class="logo-slot" aria-hidden="true" data-logo-slot />
      <a class="logo logo--forward" href={href('/')} aria-label={`${site.name} home`} data-logo>
        <svg class="logo__mark" viewBox={VIEWBOX} fill="currentColor" aria-hidden="true" focusable="false">
          <defs>
            {SLOTS.map((k) => (
              <clipPath id={`logo-slot-${k}`} clipPathUnits="userSpaceOnUse">
                <polygon points={open.slots[k]} data-slot={k} />
              </clipPath>
            ))}
          </defs>
          <path d={GLYPHS.F} />
          {SLOTS.map((k) => (
            <g clip-path={`url(#logo-slot-${k})`}>
              <g data-glyph={k}>
                <path d={GLYPHS[k]} />
              </g>
            </g>
          ))}
          <g data-glyph="W">
            <path d={GLYPHS.W} />
          </g>
          <g data-glyph="D">
            <path d={GLYPHS.D} />
            <clipPath id="logo-slot-one" clipPathUnits="userSpaceOnUse">
              <polygon points={ONE_SLOT} />
            </clipPath>
            <g clip-path="url(#logo-slot-one)">
              <g class="logo__one" transform={`translate(${ONE_X.toFixed(2)} ${ONE_Y})`}>
                <g class="logo__one-in">
                  {ONE_PATHS.map((d) => <path d={d} />)}
                </g>
              </g>
            </g>
          </g>
        </svg>
      </a>
    </>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration-line: none;
  }
  /* Classic: 199 × 20 artwork, 20px high (15px on narrow phones so the logo
     and the LP login button fit on one row, down to 320px wide). FORWARD:
     18px (14px on narrow phones; owner, 2026-11-16: 6px smaller than the
     24px before), its cropped frame with ".ONE" 1388 × 168, so 149 × 18. */
  .logo :global(.logo__mark),
  .logo-slot {
    display: block;
    height: 20px;
    width: auto;
  }
  .logo--forward :global(.logo__mark),
  .logo-slot {
    height: 18px;
  }
  .logo-slot {
    aspect-ratio: 1388 / 168;
  }
  /* ".ONE" waits just behind the D until the script brings it in (a second
     after load), gently (owner, 2026-11-16): a short slide out of the slot
     while it fades in, over 1.8s with a soft ease. Without scripting it is
     simply there. */
  @media (scripting: enabled) {
    .logo--forward:not(.is-one) :global(.logo__one-in) {
      transform: translateX(-160px);
      opacity: 0;
    }
  }
  @media (max-width: 420px) {
    .logo :global(.logo__mark) {
      height: 15px;
    }
    .logo--forward :global(.logo__mark),
    .logo-slot {
      height: 14px;
    }
  }

  /* Pinned at the spacer's place (measured by the script; these fallbacks
     match the header row: --gap above, centred in a small form height,
     at the content edge). Under the floating nav (z-index 60). */
  .logo--forward {
    position: fixed;
    z-index: 50;
    top: var(--logo-y, calc(var(--gap) + (var(--form-height-small) - 18px) / 2));
    left: var(--logo-x, max(var(--pad), calc((100vw - var(--max)) / 2)));
  }
  /* Colour (owner, 2026-11-16): FORWARD / FWD always white on dark and
     black on whites and light greys (before the script has placed it:
     white in the dark header). ".ONE" carries the visitor's side: yellow
     for investors (and before a choice), light blue once they chose
     founder, on every background. */
  :global(.theme-dark) .logo--forward {
    color: #ffffff;
  }
  .logo--forward.is-light {
    color: var(--black-ink);
  }
  .logo--forward.is-dark {
    color: #ffffff;
  }
  .logo--forward :global(.logo__one-in) {
    fill: var(--brand-yellow);
    transition:
      fill 200ms ease,
      transform 1800ms cubic-bezier(0.25, 0.1, 0.25, 1),
      opacity 1800ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .logo--forward.is-founder :global(.logo__one-in) {
    fill: var(--nav-bg-founder);
  }
  .logo--forward.is-ready {
    transition: color 200ms ease;
  }
  .logo--forward:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>

<script>
  import { layout, easeInOutCubic } from '@lib/wordmark.mjs';

  const logo = document.querySelector<HTMLElement>('[data-logo]');
  const slot = document.querySelector<HTMLElement>('[data-logo-slot]');
  if (logo && slot) {
    const glyphs = Object.fromEntries(
      Array.from(logo.querySelectorAll<SVGGElement>('[data-glyph]')).map((g) => [g.dataset.glyph!, g]),
    );
    const slots = Object.fromEntries(
      Array.from(logo.querySelectorAll<SVGPolygonElement>('[data-slot]')).map((p) => [p.dataset.slot!, p]),
    );
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Scroll-driven (owner, 2026-11-16): scrolling down closes it, scrolling
    // up opens it, anywhere on the page, by how far you scroll: DIST px for
    // the whole way. At the very top it is always FORWARD. The drawing
    // follows with a short lag (TAU), so it is never jumpy.
    const DIST = 320;
    const TAU = 140;

    // ---- Drawing: p = 0 is FWD, 1 is FORWARD ----
    function draw(p: number) {
      const l = layout(p, true);
      for (const k of ['W', 'D', 'O', 'R', 'A', 'R2'] as const) {
        glyphs[k]?.setAttribute('transform', `translate(${l[k].toFixed(2)} 0)`);
      }
      for (const k of ['O', 'R', 'A', 'R2'] as const) slots[k]?.setAttribute('points', l.slots[k]);
    }

    // ---- Motion: `target` moves with the scroll; `shown` eases after it ----
    let lastY = window.scrollY;
    let target = lastY > 0 ? 0 : 1;
    let shown = target;
    let last = 0;
    let frame = 0;
    function step(now: number) {
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;
      shown += (target - shown) * (1 - Math.exp(-dt / TAU));
      if (Math.abs(target - shown) < 0.001) shown = target;
      draw(easeInOutCubic(shown));
      if (shown !== target) frame = requestAnimationFrame(step);
      else frame = 0;
    }
    function onScroll() {
      const y = Math.max(0, window.scrollY);
      const next = y <= 0 ? 1 : Math.min(1, Math.max(0, target - (y - lastY) / DIST));
      lastY = y;
      if (next === target) return;
      target = next;
      if (reduceMotion.matches) {
        shown = target = Math.round(target);
        draw(shown);
        return;
      }
      if (!frame) {
        last = 0;
        frame = requestAnimationFrame(step);
      }
    }
    draw(easeInOutCubic(shown));

    // Out of the header (which can be its own stacking layer, under the
    // sections that scroll up over the intro), to just before the page: so
    // it stays above the content, and under the floating nav and its scrim.
    // Tab order is kept: skip link, logo, then the page.
    document.querySelector('[data-page]')?.before(logo);

    // ---- Place: the spacer's spot in the header, at the top of the page ----
    function place() {
      const r = slot!.getBoundingClientRect();
      logo!.style.setProperty('--logo-x', `${r.left + window.scrollX}px`);
      logo!.style.setProperty('--logo-y', `${r.top + window.scrollY}px`);
    }
    place();
    window.addEventListener('resize', place);
    window.addEventListener('load', place);

    // ---- Colour: yellow over dark areas, black elsewhere ----
    // What is actually painted under the logo decides (owner, 2026-11-16: a
    // white block sliding over the sticky dark intro must turn it black): of
    // the elements at the logo's spot, front to back, the first with a solid
    // background of its own; dark if that background is dark. Pictures,
    // video and canvases are looked past (to the card behind them); a box
    // drawn with a gradient can be marked [data-nav-light].
    function solidBg(el: Element): number | null {
      if (el.hasAttribute('data-nav-light')) return 1; // a light box drawn with a gradient or a canvas
      if (el.matches('img, video, canvas, picture, svg')) return null; // look past pictures to the box behind
      const m = getComputedStyle(el).backgroundColor.match(/[\d.]+/g);
      if (!m) return null;
      const [r, g, b, a = '1'] = m;
      if (Number(a) < 0.5) return null;
      const lin = (c: string) => {
        const v = Number(c) / 255;
        return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
      };
      return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b); // relative luminance
    }
    function tone() {
      const r = logo!.getBoundingClientRect();
      const x = r.left + Math.min(r.width / 2, 24), y = r.top + r.height / 2;
      let lum = 1;
      for (const el of document.elementsFromPoint(x, y)) {
        if (logo!.contains(el)) continue;
        const l = solidBg(el);
        if (l !== null) { lum = l; break; }
      }
      const dark = lum < 0.35;
      logo!.classList.toggle('is-dark', dark);
      logo!.classList.toggle('is-light', !dark);
    }
    tone();
    requestAnimationFrame(() => logo!.classList.add('is-ready'));

    // ".ONE" slides in from behind the D a second after the page is there
    // (owner, 2026-11-16); at once with reduced motion.
    const showOne = () => logo!.classList.add('is-one');
    if (reduceMotion.matches) showOne();
    else if (document.readyState === 'complete') setTimeout(showOne, 1000);
    else addEventListener('load', () => setTimeout(showOne, 1000), { once: true });

    // ---- Founder or investor: follows the choice in the floating nav,
    // which marks itself [data-founder] (and remembers it for the visit) ----
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const audience = () => {
      if (nav) return nav.hasAttribute('data-founder');
      try { return sessionStorage.getItem('forwardone-audience') === 'founder'; } catch { return false; }
    };
    logo.classList.toggle('is-founder', audience());
    if (nav) {
      new MutationObserver(() => logo!.classList.toggle('is-founder', audience())).observe(nav, {
        attributes: true,
        attributeFilter: ['data-founder'],
      });
    }

    let queued = 0;
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = requestAnimationFrame(() => {
          queued = 0;
          onScroll();
          tone();
        });
      },
      { passive: true },
    );
  }
</script>
