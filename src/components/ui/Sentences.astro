---
/**
 * Renders heading text with a line break after every sentence, so
 * "One strategy. Executed without exception." becomes two lines.
 * A "\n" in the text forces an extra break mid-sentence
 * ("Performance\nis our product.").
 * Used for Display (H1) and Section (H2) headings.
 *
 * With `reveal`, each word enters from the bottom in discrete frames:
 *   frame 0  invisible
 *   frame 1  visible, 2 steps down
 *   frame 2  visible, 1 step down
 *   frame 3  visible, at rest
 * The last word appears the same way (invisible for one frame, then fully
 * visible) but rises smoothly from 7 steps down over the span of 8 frames.
 * It appears as a left-to-right gradient, heading colour to --reveal-tint
 * (#FFEA6D); from the moment it is visible the yellow slides out to the right
 * over --reveal-tint-duration (32 frames), leaving the heading colour.
 * With `tick`, every word (the last one too) uses the stepped motion; used
 * for the eyebrow above the H1, which ticks in alongside it.
 * With `onScroll`, the reveal waits until the heading scrolls into view
 * (above the bottom 15% of the window, where the floating nav sits) and then
 * starts without the page-load pause (--reveal-start: 0).
 * Frame length and step size are tokens: --reveal-frame, --reveal-step.
 */
interface Props {
  text: string;
  reveal?: boolean;
  /** All words tick in; no smooth rise or gradient on the last word. */
  tick?: boolean;
  /** Start the reveal when the heading scrolls into view, not on load. */
  onScroll?: boolean;
}
const { text, reveal = false, tick = false, onScroll = false } = Astro.props;
const parts = text.split(/(?<=[.?!])\s+|\s*\n\s*/).filter(Boolean);

// Word index runs across all sentences so the stagger is continuous.
const sentences = parts.map((part) => part.split(/\s+/).filter(Boolean));
const total = sentences.reduce((n, words) => n + words.length, 0);
let index = 0;
---

{
  reveal
    ? sentences.map((words, si) => (
        <>
          {si > 0 && <br />}
          {words.map((word, wi) => {
            const i = index++;
            const last = !tick && i === total - 1;
            return (
              <>
                {wi > 0 && ' '}
                <span class:list={['rw', last && 'rw--last']} style={`--i: ${i}`}>
                  {word}
                </span>
              </>
            );
          })}
        </>
      ))
    : parts.map((part, i) => (
        <>
          {i > 0 && <br />}
          {part}
        </>
      ))
}
{
  reveal && onScroll && (
    <script is:inline>
      // Hold this heading's word reveal until it scrolls into view. Runs
      // while the page is parsed, before the words are first styled.
      (function () {
        var el = document.currentScript.parentElement;
        if (!el || !('IntersectionObserver' in window)) return;
        el.style.setProperty('--reveal-start', '0ms');
        el.classList.add('reveal-waiting');
        var io = new IntersectionObserver(
          function (entries) {
            if (!entries.some(function (e) { return e.isIntersecting || e.boundingClientRect.bottom < 0; })) return;
            io.disconnect();
            el.classList.remove('reveal-waiting');
          },
          { rootMargin: '0px 0px -15% 0px' }
        );
        io.observe(el);
      })();
    </script>
  )
}

<style>
  .rw {
    display: inline-block;
    /* Hold the initial (invisible) frame until the animation starts */
    opacity: 0;
    animation: rw-in calc(var(--reveal-frame) * 4) step-end forwards;
    animation-delay: calc(var(--reveal-start) + var(--i) * var(--reveal-stagger));
  }

  /* The last word: same one-frame appearance as the other words (invisible,
     then fully visible), but its rise is smooth over the 9-frame span. */
  .rw--last {
    /* Text painted by a gradient: heading colour (left) to --reveal-tint
       (right), spanning the word. --rw-sweep moves the gradient right; at
       rest (100%) the yellow sits past the word's right edge. */
    --rw-sweep: 100%;
    background: linear-gradient(
      90deg,
      var(--fg) var(--rw-sweep),
      var(--reveal-tint) calc(var(--rw-sweep) + 100%)
    );
    /* Grow the painted box past ascenders and descenders (the gradient only
       paints inside it) without moving the line: padding out, margin back. */
    padding-block: 0.25em;
    margin-block: -0.25em;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation:
      rw-show calc(var(--reveal-frame) * 9) step-end forwards,
      rw-rise calc(var(--reveal-frame) * 9) cubic-bezier(0.2, 0.7, 0.2, 1) forwards,
      rw-tint var(--reveal-tint-duration) var(--reveal-gentle-ease) both;
    /* The tint waits out the invisible first frame, so the word is fully
       --reveal-tint the moment it appears. */
    animation-delay:
      calc(var(--reveal-start) + var(--i) * var(--reveal-stagger)),
      calc(var(--reveal-start) + var(--i) * var(--reveal-stagger)),
      calc(var(--reveal-start) + var(--i) * var(--reveal-stagger) + var(--reveal-frame));
  }

  /* 4 frames: 0 invisible, then -2, -1, 0 */
  @keyframes rw-in {
    0%   { opacity: 0; transform: translateY(calc(2 * var(--reveal-step))); }
    25%  { opacity: 1; transform: translateY(calc(2 * var(--reveal-step))); }
    50%  { opacity: 1; transform: translateY(calc(1 * var(--reveal-step))); }
    75%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* Frame 0 invisible, visible from frame 1 (no fade) */
  @keyframes rw-show {
    0%      { opacity: 0; }
    11.111% { opacity: 1; }
    100%    { opacity: 1; }
  }

  /* Smooth rise from 7 steps down to rest */
  @keyframes rw-rise {
    0%   { transform: translateY(calc(7 * var(--reveal-step))); }
    100% { transform: translateY(0); }
  }

  /* The yellow leaves on the right: the gradient slides from spanning the
     word (0%) to past its right edge (100%, the resting value). */
  @property --rw-sweep {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 100%;
  }
  @keyframes rw-tint {
    from { --rw-sweep: 0%; }
  }

  /* Held until the heading scrolls into view (onScroll). */
  :global(.reveal-waiting) .rw {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .rw {
      opacity: 1;
      animation: none;
    }
  }
</style>
