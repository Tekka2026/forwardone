---
/**
 * Top strip: the logo only. Navigation lives in Nav.astro, floating at the
 * bottom of the viewport.
 */
import Logo from '@components/ui/Logo.astro';
---

<header class="site-top">
  <div class="wrap">
    <Logo />
  </div>
</header>

<style>
  .site-top {
    padding-block: var(--gap);
  }
</style>
