---
/**
 * Top strip: the logo on the left and the Pitch us button on the right.
 * Navigation lives in Nav.astro, floating at the bottom of the viewport.
 */
import Logo from '@components/ui/Logo.astro';
import Button from '@components/ui/Button.astro';
import { utilityNav } from '@content/nav';
---

<header class="site-top">
  <div class="wrap site-top__row">
    <Logo />
    <Button href={utilityNav.pitch.href} variant="ghost" size="small">{utilityNav.pitch.label}</Button>
  </div>
</header>

<style>
  .site-top {
    padding-block: var(--gap);
  }

  .site-top__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap);
  }
</style>
