---
/**
 * Top strip: the logo on the left; on the right Pitch us (solid: white with
 * black text on the dark intro, inverted on light pages) and LP login
 * (outlined).
 * Navigation lives in Nav.astro, floating at the bottom of the viewport.
 * With `dark`, it sits transparently on top of the page's black intro block
 * (see .intro in src/pages/index.astro) and uses the dark theme.
 */
import Logo from '@components/ui/Logo.astro';
import Button from '@components/ui/Button.astro';
import { utilityNav } from '@content/nav';

/** A partner logo shown next to the wordmark: raw SVG markup, drawn in
 *  currentColor at the wordmark's height. */
export interface Partner {
  name: string;
  href?: string;
  svg: string;
}

interface Props {
  dark?: boolean;
  /** Landing pages: no LP login. */
  minimal?: boolean;
  /** The founders page (owner, 2026-10-26): "For investors" (to the
   *  homepage) in the place of Pitch us, which would link to the page
   *  itself. */
  forFounders?: boolean;
  /** Landing pages run with partners (owner, 2026-10-26, /the-pitch):
   *  their logos sit next to the wordmark, each as high as it. */
  partners?: Partner[];
}
const { dark = false, minimal = false, forFounders = false, partners = [] } = Astro.props;
const marks = partners.map((p) => ({
  ...p,
  svg: p.svg.replace('<svg ', '<svg class="site-top__partner-mark" role="img" aria-label="' + p.name + '" focusable="false" '),
}));
---

<header class:list={['site-top', dark && 'site-top--dark theme-dark', minimal && 'site-top--minimal', forFounders && 'site-top--founders']}>
  <div class="wrap site-top__row">
    {
      marks.length ? (
        <div class="site-top__brands">
          <Logo />
          {marks.map((m) =>
            m.href ? (
              <a class="site-top__partner" href={m.href} rel="noopener" set:html={m.svg} />
            ) : (
              <span class="site-top__partner" set:html={m.svg} />
            ),
          )}
        </div>
      ) : (
        <Logo />
      )
    }
    <div class="site-top__actions">
      {
        forFounders ? (
          <Button href={utilityNav.investors.href} size="small" class="site-top__investors">{utilityNav.investors.label}</Button>
        ) : (
          <Button href={utilityNav.pitch.href} size="small" class="site-top__pitch">{utilityNav.pitch.label}</Button>
        )
      }
      {
        !minimal && (
          <Button href={utilityNav.lpLogin.href} variant="ghost" size="small" external={utilityNav.lpLogin.external}>
            {utilityNav.lpLogin.label}
          </Button>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-top {
    padding-block: var(--gap);
  }
  /* Over the intro block: no background of its own, above it in the stack. */
  .site-top--dark {
    position: relative;
    z-index: 1;
  }

  .site-top__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap);
    min-height: var(--form-height-small); /* total height = --header-h */
  }
  .site-top__actions {
    display: flex;
    gap: var(--gap-half);
  }
  /* Landing pages (owner, 2026-10-22): no LP login next to it, so the
     wordmark can be a little larger, also on narrow phones. 20% smaller
     since 2026-10-26 (owner; before: 24 / 19px). */
  .site-top.site-top--minimal :global(.logo__mark) {
    height: 19.2px;
  }
  @media (max-width: 420px) {
    .site-top.site-top--minimal :global(.logo__mark) {
      height: 15.2px;
    }
  }
  /* Partner logos (owner, 2026-10-26): in a row with the wordmark, each
     as high as it (the artwork boxes are all cap/ascender to baseline). */
  .site-top__brands {
    display: flex;
    align-items: center;
    gap: var(--gap);
    min-width: 0;
  }
  .site-top__partner,
  .site-top__brands :global(.logo) {
    display: inline-flex;
    flex-shrink: 0;
    color: inherit;
  }
  .site-top__brands :global(.site-top__partner-mark) {
    display: block;
    height: 20px;
    width: auto;
  }
  .site-top--minimal .site-top__brands :global(.site-top__partner-mark) {
    height: 19.2px;
  }
  @media (max-width: 420px) {
    .site-top__brands {
      gap: var(--gap-half);
    }
    .site-top .site-top__brands :global(.logo__mark),
    .site-top .site-top__brands :global(.site-top__partner-mark) {
      height: 13px;
    }
  }
  @media (max-width: 360px) {
    .site-top__brands {
      gap: var(--space-2x);
    }
    .site-top .site-top__brands :global(.logo__mark),
    .site-top .site-top__brands :global(.site-top__partner-mark) {
      height: 12px;
    }
  }
  /* Founders page on phones: "For investors" stays (unlike Pitch us), so
     the logo and the two buttons sit closer to fit down to 320px. */
  @media (max-width: 640px) {
    .site-top--founders .site-top__row {
      gap: var(--gap-half);
    }
  }
  /* Phones: no Pitch us in the top strip (owner, 2026-10-14); founders
     still reach it from the closing section ("Founders: pitch us"). */
  @media (max-width: 640px) {
    .site-top__actions :global(.site-top__pitch) {
      display: none;
    }
  }
</style>
