---
import { footer } from '@content/nav';
import { href } from '@lib/href';

// Partner logos: single-colour SVGs, inlined so they take the text colour.
const logos = import.meta.glob<string>('../assets/partners/*.svg', { query: '?raw', import: 'default', eager: true });
const logo = (name: string) => logos[`../assets/partners/${name}.svg`] ?? '';
const labelled = (svg: string, label: string) =>
  svg.replace('<svg ', `<svg role="img" aria-label="${label}" class="footer-partner__logo" `);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      {
        footer.columns.map((section) => (
          <nav class="footer-col" aria-labelledby={`footer-${section.label.toLowerCase()}`}>
            <h2 class="footer-col__title label" id={`footer-${section.label.toLowerCase()}`}>
              <a href={href(section.href)}>{section.label}</a>
            </h2>
            <ul class="footer-col__list">
              {section.children.map((child) => (
                <li>
                  <a
                    class="footer-link"
                    href={href(child.href)}
                    target={child.external ? '_blank' : undefined}
                    rel={child.external ? 'noopener noreferrer' : undefined}
                  >
                    {child.label}
                    {child.external && <span aria-hidden="true"> &#8599;</span>}
                    {child.external && <span class="visually-hidden">(opens in a new tab)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer-col footer-col--contact">
        <h2 class="footer-col__title label">{footer.contact.heading}</h2>
        <ul class="footer-col__list">
          {
            footer.contact.lines.map((line) => (
              <li>
                <span class="footer-contact__label">{line.label}</span>
                <a class="footer-link" href={line.href}>{line.value}</a>
              </li>
            ))
          }
        </ul>
        <address class="footer-address small">
          {footer.contact.address.map((line, i) => (
            <>{line}{i < footer.contact.address.length - 1 && <br />}</>
          ))}
        </address>
      </div>
    </div>

    <!-- Centred: the label, then the three logos in one row under it. -->
    <div class="footer-partners">
      <p class="footer-partners__label small" id="footer-partners-label">{footer.partnersLabel}</p>
      <ul class="footer-partners__list" aria-labelledby="footer-partners-label">
        {footer.partners.map((p) => <li class="footer-partner" set:html={labelled(logo(p.logo), p.name)} />)}
      </ul>
    </div>

    <div class="footer-bottom">
      <p class="footer-tagline small">
        <span class="footer-copy">&copy; {footer.company} {year}.</span> {footer.tagline}
      </p>
      <ul class="footer-legal">
        {
          footer.legal.map((item) => (
            <li>
              <a class="footer-link small" href={href(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline-w) solid var(--hairline);
    padding-block: var(--space-16x);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap-double) var(--gutter);
  }

  .footer-col__title {
    margin: 0 0 var(--space-4x);
  }

  .footer-col__title a {
    text-decoration-line: none;
  }

  .footer-col__title a:hover {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }

  .footer-col__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2x);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    text-decoration-line: none;
  }

  .footer-link:hover {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }

  .footer-contact__label {
    display: block;
    font-size: var(--fs-small-tight);
    color: var(--muted);
  }

  .footer-address {
    margin-top: var(--gap);
    font-style: normal;
  }

  /* No hairline above: the label and logos are centred, 64px under the
     columns. */
  .footer-partners {
    margin-top: var(--space-16x);
    text-align: center;
  }

  .footer-partners__label {
    margin: 0;
  }

  .footer-partners__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4x) var(--space-16x);
    margin: var(--space-4x) 0 0;
    padding: 0;
    list-style: none;
  }

  /* One height for all logos; widths follow each logo's proportions. */
  .footer-partner {
    display: flex;
  }
  .footer-partner :global(.footer-partner__logo) {
    display: block;
    height: 44px;
    width: auto;
  }

  /* Phones: smaller logos and gaps, so all three stay on one row. */
  @media (max-width: 640px) {
    .footer-partners__list {
      gap: var(--space-4x) var(--gap);
    }
    .footer-partner :global(.footer-partner__logo) {
      height: 32px;
    }
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4x) var(--space-8x);
    margin-top: var(--gap-double);
    padding-top: var(--gap);
    border-top: var(--hairline-w) solid var(--hairline);
  }

  .footer-tagline {
    margin: 0;
  }

  .footer-copy {
    color: var(--muted);
  }

  .footer-legal {
    display: flex;
    gap: var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-col--contact {
      grid-column: 1 / -1;
    }
  }
</style>
