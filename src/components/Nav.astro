---
/**
 * Floating navigation bar at the bottom of the viewport.
 *
 * - Hidden on load; slides in from the bottom on the visitor's first scroll
 *   (or at once when the page cannot scroll, or on the first Tab press).
 * - Closed: "Welcome to FORWARD.one" typed on the left, hamburger on the
 *   right. It stays until the bar is pressed.
 * - Pressing the bar opens the panel; the AI mark appears and the line
 *   becomes "How can we help you?", then the grey placeholder. Clicking the
 *   greeting also turns it into a text field.
 * - Open: a panel grows upward out of the bar with the section columns
 *   (accordions on mobile); the page behind is pushed
 *   back, covered by a white layer and made inert.
 */
import { primaryNav, navGreeting } from '@content/nav';
import { href, isActive } from '@lib/href';

const current = Astro.url.pathname;
---

<div class="nav" data-nav>
  <div class="nav__shade" aria-hidden="true"></div>
  <div class="nav__scrim" data-nav-scrim hidden></div>

  <nav class="nav__root" aria-label="Primary">
    <div class="nav__panel" id="nav-panel" data-nav-panel hidden>
      <div class="nav__columns">
        {
          primaryNav.map((section, i) => {
            const listId = `nav-list-${i}`;
            return (
              <div class="nav__col" data-nav-col={i}>
                <div class="nav__col-head">
                  <a
                    class="nav__col-title"
                    href={href(section.href)}
                    aria-current={isActive(current, section.href) ? 'true' : undefined}
                  >
                    {section.label}
                  </a>
                  <button
                    class="nav__acc"
                    type="button"
                    aria-expanded="false"
                    aria-controls={listId}
                    aria-label={`Show ${section.label} pages`}
                    data-nav-acc
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                      <path d="M2.5 5l4.5 4.5L11.5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                </div>
                <ul class="nav__list" id={listId}>
                  {section.children.map((child) => (
                    <li>
                      <a
                        class="nav__link"
                        href={href(child.href)}
                        target={child.external ? '_blank' : undefined}
                        rel={child.external ? 'noopener noreferrer' : undefined}
                        aria-current={!child.external && current === href(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                        {child.external && <span class="visually-hidden">(opens in a new tab)</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>

    </div>

    <div class="nav__bar" data-nav-bar>
      <form
        class="nav__ask"
        data-nav-ask
        data-first={navGreeting.first}
        data-second={navGreeting.second}
        data-not-connected={navGreeting.ask.notConnected}
        data-placeholder={navGreeting.ask.placeholder}
        data-placeholder-after={navGreeting.ask.placeholderAfterMs}
        data-placeholder-enabled={navGreeting.ask.placeholderEnabled ? 'true' : 'false'}
        action={navGreeting.ask.handler}
        method="post"
      >
        <span class="nav__ai" data-nav-ai aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M7.5 1C7.5 2.49363 7.43712 3.64056 7.25977 4.52734C7.08347 5.40861 6.8021 5.99087 6.39648 6.39648C5.99087 6.8021 5.40861 7.08347 4.52734 7.25977C3.64056 7.43712 2.49363 7.5 1 7.5V8.5C2.49363 8.5 3.64056 8.56288 4.52734 8.74023C5.40861 8.91653 5.99087 9.1979 6.39648 9.60352C6.8021 10.0091 7.08347 10.5914 7.25977 11.4727C7.43712 12.3594 7.5 13.5064 7.5 15H8.5C8.5 13.5064 8.56288 12.3594 8.74023 11.4727C8.91653 10.5914 9.1979 10.0091 9.60352 9.60352C10.0091 9.1979 10.5914 8.91653 11.4727 8.74023C12.3594 8.56288 13.5064 8.5 15 8.5V7.5C13.5064 7.5 12.3594 7.43712 11.4727 7.25977C10.5914 7.08347 10.0091 6.8021 9.60352 6.39648C9.1979 5.99087 8.91653 5.40861 8.74023 4.52734C8.56288 3.64056 8.5 2.49363 8.5 1H7.5Z" fill="currentColor" stroke="currentColor" />
          </svg>
        </span>
        <button class="nav__prompt" type="button" aria-label={navGreeting.ask.label} data-nav-prompt>
          <span class="nav__typed" data-nav-typed><span class="nav__typed-head" data-nav-typed-head></span><span data-nav-typed-rest></span></span><span class="nav__cursor" aria-hidden="true">_</span>
        </button>
        <input
          class="nav__input"
          type="text"
          name="q"
          autocomplete="off"
          aria-label={navGreeting.ask.label}
          data-nav-input
          hidden
        />
      </form>

      <button
        class="nav__menu"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Menu"
        data-nav-menu
      >
        <svg class="nav__icon" data-icon-closed width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="1.75" />
        </svg>
        <svg class="nav__icon" data-icon-open width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.75" />
        </svg>
      </button>
    </div>
  </nav>
</div>

<style>
  /* Open / close motion: fluid and snappy, the same in both directions. */
  .nav {
    --nav-open-ms: 420ms;
    --nav-open-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --nav-close-ms: var(--nav-open-ms);     /* close mirrors open */
    --nav-close-ease: var(--nav-open-ease);
  }

  /* No transform on .nav itself: the scrim is a fixed child and must span
     the viewport. The entrance slide lives on .nav__root. */
  .nav {
    position: fixed;
    bottom: var(--gap);
    left: 0;
    right: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
    color: var(--nav-fg);
  }

  /* Gradient behind the bar: black 30% at the viewport bottom to black 0%
     at 20px above the bar. Fades in once the bar has slid into place. */
  .nav__shade {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -2;
    height: calc(var(--nav-height) + var(--gap) + 20px);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0));
    opacity: 0;
    transition: opacity 320ms ease 480ms;
    pointer-events: none;
  }

  .nav[data-visible] .nav__shade {
    opacity: 1;
  }

  /* 80% white layer over the pushed-back page while the panel is open */
  .nav__scrim {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(255, 255, 255, 0.8);
    opacity: 0;
    transition: opacity var(--nav-close-ms) var(--nav-close-ease);
    pointer-events: auto;
  }

  .nav[data-open] .nav__scrim {
    opacity: 1;
    transition: opacity var(--nav-open-ms) var(--nav-open-ease);
  }

  .nav__root {
    position: relative;
    width: min(var(--col-12), calc(100vw - 2 * var(--page-margin)));
    pointer-events: auto;
    /* Hidden below the viewport until the first scroll */
    transform: translateY(calc(100% + var(--gap) + var(--space-4x)));
    transition: transform 480ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav[data-visible] .nav__root {
    transform: none;
  }

  /* ---- Bar (closed state) ---- */
  .nav__bar {
    position: relative;
    z-index: 1; /* above the panel: the closing panel never overlaps the bar */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap);
    min-height: var(--nav-height);
    padding: 0 var(--gap-half) 0 var(--gap);
    background: var(--nav-bg);
    border-radius: var(--radius);
    /* closing: colour changes together with the panel above it */
    transition:
      background-color var(--nav-close-ms) var(--nav-close-ease),
      color var(--nav-close-ms) var(--nav-close-ease);
    cursor: pointer; /* the whole bar toggles the menu */
    user-select: none;
  }

  .nav[data-open] .nav__bar {
    background: var(--nav-bg-open);
    transition:
      background-color var(--nav-open-ms) var(--nav-open-ease),
      color var(--nav-open-ms) var(--nav-open-ease);
  }

  /* Closed bar over a dark area ([data-nav-dark]): inverted. The panel takes
     the same colour while closed, so opening and folding away animate bar
     and panel together (white <-> #000), never apart. */
  .nav[data-inverse]:not([data-open]) .nav__bar,
  .nav[data-inverse]:not([data-open]) .nav__panel {
    background: var(--nav-bg-inverse);
  }
  .nav[data-inverse]:not([data-open]) .nav__bar {
    color: var(--nav-fg-inverse);
  }
  .nav[data-inverse]:not([data-open]) .nav__typed-head {
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    color: inherit; /* the cyan gradient is for the dark bar only */
  }
  .nav[data-inverse]:not([data-open]) .nav__menu:focus-visible {
    background: rgba(0, 0, 0, 0.08);
  }

  /* While the panel is out (opening, open or folding away), the bar's top
     corners are square so bar and panel read as one shape. */
  .nav[data-shape] .nav__bar {
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .nav__ask {
    display: flex;
    align-items: center;
    gap: var(--space-2x);
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1;
    letter-spacing: 0;
    cursor: pointer;
  }

  /* The mark grows from zero width so the text slides right with it, while
     the glyph itself enters like the last word of the H1: invisible for one
     frame, then fully visible, rising smoothly from 7 steps down. */
  .nav__ai {
    --icon-step: 2px; /* the H1 step at display size */
    display: inline-flex;
    flex: 0 0 auto;
    width: 0;
    color: #78f6fb;
    margin-right: calc(-1 * var(--space-2x)); /* cancel the flex gap while out */
    transition:
      width 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
      margin-right 360ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav__ai svg {
    flex: 0 0 auto;
    opacity: 0;
  }

  /* The slot opens as soon as the panel opens (text slides right)… */
  .nav__ai.is-room {
    width: 16px;
    margin-right: 0;
  }

  /* …and the glyph rises into it 750ms later, moving only vertically. */
  .nav__ai.is-in svg {
    animation:
      nav-ai-show calc(var(--reveal-frame) * 9) step-end forwards,
      nav-ai-rise calc(var(--reveal-frame) * 9) cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  /* Frame 0 invisible, visible from frame 1 (no fade) */
  @keyframes nav-ai-show {
    0%      { opacity: 0; }
    11.111% { opacity: 1; }
    100%    { opacity: 1; }
  }

  /* Smooth rise from 7 steps down to rest */
  @keyframes nav-ai-rise {
    0%   { transform: translateY(calc(7 * var(--icon-step))); }
    100% { transform: translateY(0); }
  }

  .nav__prompt {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
    margin: 0;
    padding: var(--space-2x) 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
  }

  .nav__prompt:focus,
  .nav__prompt:focus-visible {
    outline: none;
  }

  /* Placeholder state: grey text. The cursor follows the text like everywhere
     else and is hidden when idle. */
  .nav__prompt.is-placeholder .nav__typed {
    color: rgba(255, 255, 255, 0.5);
  }
  .nav__prompt.is-placeholder .nav__typed-head {
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    color: inherit;
  }

  /* First six characters: #78F6FB to white, circular gradient */
  .nav__typed-head {
    background: radial-gradient(circle at 0% 50%, #78f6fb 0%, #ffffff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nav__prompt[hidden] {
    display: none;
  }

  .nav__input {
    cursor: pointer; /* hand pointer across the whole bar */
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: var(--space-2x) 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    outline: none;
  }

  .nav__input::placeholder {
    color: inherit;
    opacity: 0.5;
  }

  .nav__input[hidden] {
    display: none;
  }

  .nav__cursor {
    display: inline-block;
    animation: nav-blink 600ms steps(1, end) infinite;
  }

  @keyframes nav-blink {
    50% { opacity: 0; }
  }

  /* The cursor exists only while text is being typed or erased */
  .nav__cursor.is-still {
    display: none;
  }

  .nav__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--form-height-small);
    height: var(--form-height-small);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  /* No outline on the hamburger. Keyboard focus shows as a faint tint. */
  .nav__menu:focus,
  .nav__menu:focus-visible {
    outline: none;
  }
  .nav__menu:focus-visible {
    background: rgba(255, 255, 255, 0.15);
  }

  .nav__icon {
    display: block;
  }

  /* Hamburger when closed, cross when open */
  .nav__icon[data-icon-open],
  .nav[data-open] .nav__icon[data-icon-closed] {
    display: none;
  }
  .nav[data-open] .nav__icon[data-icon-open] {
    display: block;
  }

  .nav :global(:focus-visible) {
    outline-color: var(--nav-fg);
  }

  /* ---- Panel (open state) ---- */
  .nav__panel {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - var(--nav-height) - 3 * var(--gap));
    max-height: calc(100dvh - var(--nav-height) - 3 * var(--gap));
    overflow-y: auto;
    padding: var(--gap);
    /* The panel and the bar are one surface: same colour rule, same timing.
       It folds down into the bar (clip from the top) instead of fading, so
       there is never a dark panel over a light bar or the other way round. */
    background: var(--nav-bg);
    border-radius: var(--radius) var(--radius) 0 0;
    clip-path: inset(100% 0 0 0 round var(--radius) var(--radius) 0 0);
    transition:
      clip-path var(--nav-close-ms) var(--nav-close-ease),
      background-color var(--nav-close-ms) var(--nav-close-ease);
  }

  .nav[data-open] .nav__panel {
    background: var(--nav-bg-open);
    clip-path: inset(0 0 0 0 round var(--radius) var(--radius) 0 0);
    transition:
      clip-path var(--nav-open-ms) var(--nav-open-ease),
      background-color var(--nav-open-ms) var(--nav-open-ease);
  }

  .nav__columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gap);
  }

  .nav__col-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-half);
  }

  .nav__col-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-label);
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.7;
  }

  .nav__col-title:hover,
  .nav__col-title[aria-current='true'] {
    opacity: 1;
  }

  .nav__acc {
    display: none;
    margin: 0;
    padding: var(--space-2x);
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .nav__acc[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2x);
    margin: var(--gap-half) 0 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-block;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    text-decoration: none;
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ---- 880px: accordion columns ---- */
  @media (max-width: 880px) {
    .nav__columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .nav__col {
      border-top: var(--hairline-w) solid var(--nav-hairline);
    }

    .nav__col:first-child {
      border-top: 0;
    }

    .nav__col-head {
      padding: var(--gap-half) 0;
    }

    .nav__col-title {
      font-family: var(--font-sans);
      font-size: var(--fs-card-title);
      letter-spacing: var(--ls-card-title);
      line-height: var(--lh-card-title);
      text-transform: none;
      opacity: 1;
    }

    .nav__acc {
      display: inline-flex;
    }

    .nav__list {
      display: none;
      margin: 0;
      padding: 0 0 var(--gap-half);
    }

    .nav__col.is-open .nav__list {
      display: flex;
    }

    .nav__link {
      font-size: var(--fs-body);
      padding: var(--space) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__cursor {
      animation: none;
    }
    /* …and the glyph rises into it 750ms later, moving only vertically. */
  .nav__ai.is-in svg {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const rootEl = document.querySelector<HTMLElement>('[data-nav]');
  const pageEl = document.querySelector<HTMLElement>('[data-page]');

  if (rootEl && pageEl) {
    // Narrowed consts so nested functions see non-null elements.
    const root: HTMLElement = rootEl;
    const page: HTMLElement = pageEl;
    const panel = root.querySelector<HTMLElement>('[data-nav-panel]')!;
    const bar = root.querySelector<HTMLElement>('[data-nav-bar]')!;
    const scrim = root.querySelector<HTMLElement>('[data-nav-scrim]')!;
    const menu = root.querySelector<HTMLButtonElement>('[data-nav-menu]')!;
    const cols = Array.from(root.querySelectorAll<HTMLElement>('[data-nav-col]'));
    const accs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-nav-acc]'));
    const greeting = root.querySelector<HTMLFormElement>('[data-nav-ask]')!;
    const typedHead = root.querySelector<HTMLElement>('[data-nav-typed-head]')!;
    const typedRest = root.querySelector<HTMLElement>('[data-nav-typed-rest]')!;
    const HEAD_CHARS = 6;
    let current = '';
    function setTyped(text: string) {
      current = text;
      typedHead.textContent = text.slice(0, HEAD_CHARS);
      typedRest.textContent = text.slice(HEAD_CHARS);
    }
    const prompt = root.querySelector<HTMLButtonElement>('[data-nav-prompt]')!;
    const input = root.querySelector<HTMLInputElement>('[data-nav-input]')!;
    const ai = root.querySelector<HTMLElement>('[data-nav-ai]')!;
    const cursor = root.querySelector<HTMLElement>('.nav__cursor')!;
    const mobile = window.matchMedia('(max-width: 880px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isOpen = false;
    // Track input modality so focus is only moved for keyboard users.
    let keyboard = false;
    document.addEventListener('keydown', () => (keyboard = true), true);
    document.addEventListener('pointerdown', () => (keyboard = false), true);

    /* ---- Entrance on first scroll ---- */
    let shown = false;
    function show() {
      if (shown) return;
      shown = true;
      root.setAttribute('data-visible', '');
      window.removeEventListener('scroll', show);
      window.removeEventListener('wheel', show);
      window.removeEventListener('touchmove', show);
      document.removeEventListener('keydown', onFirstTab);
      startGreeting();
    }
    function onFirstTab(e: KeyboardEvent) {
      if (e.key === 'Tab') show();
    }
    const canScroll = document.documentElement.scrollHeight > window.innerHeight + 1;
    if (!canScroll || window.scrollY > 0) {
      requestAnimationFrame(() => requestAnimationFrame(show));
    } else {
      window.addEventListener('scroll', show, { passive: true });
      window.addEventListener('wheel', show, { passive: true });
      window.addEventListener('touchmove', show, { passive: true });
      document.addEventListener('keydown', onFirstTab);
    }

    /* ---- Typewriter greeting ----
       Closed: "Welcome to FORWARD.one" stays until the bar is pressed.
       Open:   the AI mark appears, the line becomes "How can we help you?",
               and after a short hold it turns into the grey placeholder.
       Closing again types the welcome line back. Every sequence gets a run
       id; starting a new one cancels whatever was still typing. */
    const first = greeting.dataset.first || '';
    const second = greeting.dataset.second || '';
    const TYPE_MS = 55;
    const ERASE_MS = 30;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    let runId = 0;
    const alive = (id: number) => id === runId;
    const idle = () => cursor.classList.add('is-still'); // no cursor when idle

    // The AI mark is shown only while the panel is open, 750ms after opening.
    const AI_DELAY_MS = 750;
    let aiTimer: number | undefined;
    function showAi() {
      window.clearTimeout(aiTimer);
      ai.classList.add('is-room'); // text slides right now
      aiTimer = window.setTimeout(() => ai.classList.add('is-in'), AI_DELAY_MS);
    }
    function hideAi() {
      window.clearTimeout(aiTimer);
      ai.classList.remove('is-in', 'is-room');
    }
    async function typeText(text: string, id: number) {
      cursor.classList.remove('is-still');
      for (let i = 1; i <= text.length; i++) {
        if (!alive(id)) return;
        setTyped(text.slice(0, i));
        await wait(TYPE_MS);
      }
    }
    async function eraseText(id: number) {
      cursor.classList.remove('is-still');
      let text = current;
      while (text.length) {
        if (!alive(id)) return;
        text = text.slice(0, -1);
        setTyped(text);
        await wait(ERASE_MS);
      }
    }

    /* ---- States ---- */
    const notConnected = greeting.dataset.notConnected || '';
    const placeholder = greeting.dataset.placeholder || '';
    const placeholderAfter = Number(greeting.dataset.placeholderAfter) || 2000;
    let placeholderMode = false;

    function showPrompt() {
      prompt.hidden = false;
      input.hidden = true;
    }
    // Closed state: the welcome line.
    async function toWelcome(animate: boolean, delay = 0) {
      const id = ++runId;
      placeholderMode = false;
      showPrompt();
      if (!animate || reduceMotion.matches) {
        prompt.classList.remove('is-placeholder');
        setTyped(first);
        idle();
        return;
      }
      if (delay) await wait(delay);
      if (!alive(id)) return;
      if (current) {
        await eraseText(id);
        if (!alive(id)) return;
        await wait(120);
        if (!alive(id)) return;
      }
      prompt.classList.remove('is-placeholder');
      await typeText(first, id);
      if (alive(id)) idle();
    }
    // Open state, idle: the grey placeholder.
    const placeholderEnabled = greeting.dataset.placeholderEnabled === 'true';
    // Open state, idle: the grey placeholder, or the question while the
    // placeholder step is switched off.
    function setPlaceholderState() {
      ++runId;
      placeholderMode = true;
      prompt.classList.toggle('is-placeholder', placeholderEnabled);
      setTyped(placeholderEnabled ? placeholder : second);
      idle();
      showPrompt();
    }
    // Open state: the question, then the grey placeholder.
    async function toQuestion() {
      const id = ++runId;
      placeholderMode = false;
      showPrompt();
      if (reduceMotion.matches) {
        prompt.classList.remove('is-placeholder');
        setTyped(second);
        idle();
        return;
      }
      await eraseText(id);
      if (!alive(id)) return;
      prompt.classList.remove('is-placeholder');
      await wait(240);
      if (!alive(id)) return;
      await typeText(second, id);
      if (!alive(id)) return;
      idle();
      if (!placeholderEnabled) {
        placeholderMode = true; // typing anywhere still starts a question
        return;
      }
      await wait(placeholderAfter);
      if (!alive(id)) return;
      await eraseText(id);
      if (!alive(id)) return;
      prompt.classList.add('is-placeholder');
      await typeText(placeholder, id);
      if (!alive(id)) return;
      idle();
      placeholderMode = true;
    }

    /* ---- Click to type ---- */
    function startTyping() {
      ++runId; // stop any sequence still typing
      placeholderMode = false;
      prompt.hidden = true;
      input.hidden = false;
      input.focus();
    }
    function stopTyping() {
      if (input.value.trim()) return; // keep the field while there is text
      if (isOpen) setPlaceholderState();
      else toWelcome(false);
    }
    // Typing anywhere while the placeholder is showing starts the question.
    document.addEventListener('keydown', (e) => {
      if (!placeholderMode || !input.hidden) return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.key.length !== 1 || e.key === ' ') return;
      const el = document.activeElement as HTMLElement | null;
      if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) return;
      e.preventDefault();
      startTyping();
      input.value = e.key;
    });
    // The whole bar opens the menu; the prompt also drops you into the field.
    // The bar handler runs after this one (bubbling), so open there, type here.
    prompt.addEventListener('click', () => {
      if (!isOpen) {
        // Let the bar's click handler open the panel first, then type.
        setTimeout(startTyping, 0);
      } else {
        startTyping();
      }
    });
    // Clicks inside the text field itself must not close the open panel.
    input.addEventListener('click', (e) => e.stopPropagation());
    input.addEventListener('blur', stopTyping);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.stopPropagation();
        input.value = '';
        input.blur();
      }
    });
    greeting.addEventListener('submit', (e) => {
      // [PLACEHOLDER] handler: no backend yet.
      e.preventDefault();
      if (!input.value.trim()) return;
      input.value = '';
      input.blur(); // settle the blur first so it cannot cancel the restore below
      const id = ++runId;
      showPrompt();
      prompt.classList.remove('is-placeholder');
      setTyped(notConnected);
      idle();
      window.setTimeout(() => {
        if (!alive(id) || !input.hidden) return;
        if (isOpen) setPlaceholderState();
        else toWelcome(true);
      }, 3000);
    });

    function startGreeting() {
      // First appearance: type the welcome line once the bar has slid in.
      toWelcome(true, 480);
    }

    /* ---- Panel open / close ---- */
    function setAccordion(col: HTMLElement, open: boolean) {
      col.classList.toggle('is-open', open);
      const btn = col.querySelector<HTMLButtonElement>('[data-nav-acc]');
      if (btn) btn.setAttribute('aria-expanded', String(open));
    }

    function open() {
      show();
      isOpen = true;
      window.clearTimeout(closeTimer);
      panel.hidden = false;
      scrim.hidden = false;
      root.setAttribute('data-shape', '');
      void panel.offsetWidth; // start the fold from the collapsed state
      requestAnimationFrame(() => root.setAttribute('data-open', ''));
      // Push the page back from the centre of the visible viewport.
      page.style.transformOrigin = `50% ${window.scrollY + window.innerHeight / 2}px`;
      page.classList.add('is-pushed');
      page.setAttribute('inert', '');
      document.documentElement.style.overflow = 'hidden';
      showAi();
      if (input.hidden) toQuestion();
      menu.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-label', 'Close menu');
      for (const c of cols) setAccordion(c, false);
      if (keyboard && input.hidden) {
        const firstTarget = panel.querySelector<HTMLElement>(mobile.matches ? '[data-nav-acc]' : 'a');
        firstTarget?.focus();
      }
    }

    let closeTimer: number | undefined;
    function close() {
      if (!isOpen) return;
      isOpen = false;
      root.removeAttribute('data-open');
      // Let the fold play out, then take the panel out of the tree and give
      // the bar its rounded top corners back.
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (isOpen) return;
        panel.hidden = true;
        scrim.hidden = true;
        root.removeAttribute('data-shape');
      }, 460);
      page.classList.remove('is-pushed');
      page.removeAttribute('inert');
      document.documentElement.style.overflow = '';
      hideAi();
      if (input.hidden || !input.value.trim()) toWelcome(true);
      menu.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-label', 'Menu');
      if (keyboard) menu.focus();
      else (document.activeElement as HTMLElement | null)?.blur();
    }

    // The whole bar toggles the menu. Keyboard activation of the hamburger
    // fires a click that bubbles here, so one handler covers both.
    bar.addEventListener('click', (e) => {
      const onPrompt = (e.target as HTMLElement).closest('[data-nav-prompt]');
      if (isOpen && onPrompt) return; // typing, not closing
      isOpen ? close() : open();
    });

    for (const acc of accs) {
      acc.addEventListener('click', () => {
        const col = acc.closest<HTMLElement>('[data-nav-col]')!;
        const willOpen = !col.classList.contains('is-open');
        for (const c of cols) setAccordion(c, c === col && willOpen);
      });
    }

    scrim.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) close();
    });

    mobile.addEventListener('change', close);

    /* ---- Inverse over dark areas ---- */
    // The bar's resting centre line, measured from the viewport bottom, so the
    // check is right even before the bar has slid in.
    const darkZones = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dark]'));
    let inverseFrame = 0;
    function updateInverse() {
      inverseFrame = 0;
      const bottom = parseFloat(getComputedStyle(root).bottom) || 0;
      const y = window.innerHeight - bottom - bar.offsetHeight / 2;
      const over = darkZones.some((z) => {
        const r = z.getBoundingClientRect();
        return r.top <= y && r.bottom >= y;
      });
      root.toggleAttribute('data-inverse', over);
    }
    function queueInverse() {
      if (!inverseFrame) inverseFrame = requestAnimationFrame(updateInverse);
    }
    if (darkZones.length) {
      updateInverse();
      window.addEventListener('scroll', queueInverse, { passive: true });
      window.addEventListener('resize', queueInverse);
    }
  }
</script>
