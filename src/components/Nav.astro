---
/**
 * Floating navigation bar at the bottom of the viewport.
 *
 * - Hidden on load; slides in from the bottom on the visitor's first scroll
 *   (or at once when the page cannot scroll, or on the first Tab press).
 * - Closed: "Welcome to FORWARD.one" typed on the left, hamburger on the
 *   right. It stays until the bar is pressed.
 * - The AI mark sits left of the line from the start. Pressing the bar
 *   opens the panel; the mark swaps (a second mark pushes it out) and the
 *   line becomes "How can we help you?". Clicking the
 *   greeting also turns it into a text field.
 * - Open: a panel grows upward out of the bar with the section columns
 *   (accordions on mobile); the page behind is pushed
 *   back, covered by a white layer and made inert.
 * - Compact (owner, 2026-11-04), on pages that mark an element with
 *   `data-nav-audience-after` (the homepage: the intro and founders strip):
 *   once that element has scrolled past the bar, the bar shrinks, the AI
 *   mark swaps and the welcome line erases into "Are you a founder or
 *   investor?" with the two words underlined (owner, 2026-11-06; was a
 *   switch). The hamburger stays and opens the panel at full width. It
 *   lasts while the bar is over the next section; past it, or scrolling
 *   back up, the bar is full again. Choosing greets by time of day; a
 *   founder's bar turns light blue with black text and icons (Ice,
 *   --nav-bg-founder), an investor's stays black.
 */
import { primaryNav, navGreeting } from '@content/nav';
import { href, isActive } from '@lib/href';

const current = Astro.url.pathname;
const aud = navGreeting.audience;
---

<div class="nav" data-nav>
  <div class="nav__shade" aria-hidden="true"></div>
  <div class="nav__scrim" data-nav-scrim hidden></div>

  <nav class="nav__root" aria-label="Primary">
    <div class="nav__panel" id="nav-panel" data-nav-panel hidden>
      <div class="nav__columns">
        {
          primaryNav.map((section, i) => {
            const listId = `nav-list-${i}`;
            return (
              <div class="nav__col" data-nav-col={i}>
                <div class="nav__col-head">
                  <a
                    class="nav__col-title"
                    href={href(section.href)}
                    aria-current={isActive(current, section.href) ? 'true' : undefined}
                  >
                    {section.label}
                  </a>
                  <button
                    class="nav__acc"
                    type="button"
                    aria-expanded="false"
                    aria-controls={listId}
                    aria-label={`Show ${section.label} pages`}
                    data-nav-acc
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                      <path d="M2.5 5l4.5 4.5L11.5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </button>
                </div>
                <ul class="nav__list" id={listId}>
                  {section.children.map((child) => (
                    <li>
                      <a
                        class="nav__link"
                        href={href(child.href)}
                        target={child.external ? '_blank' : undefined}
                        rel={child.external ? 'noopener noreferrer' : undefined}
                        aria-current={!child.external && current === href(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                        {child.external && <span class="visually-hidden">(opens in a new tab)</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>

      <!-- Opened from the greeting's underlined word (owner, 2026-11-06):
           the panel shows only the choice, filled in by the script. -->
      <div class="nav__choice" data-nav-choice>
        <p class="nav__choice-title" data-nav-choice-title></p>
        <ul class="nav__choice-list">
          <li><button class="nav__choice-opt" type="button" data-nav-choice-switch></button></li>
          <li><button class="nav__choice-opt" type="button" data-nav-choice-reset>{aud.choice.reset}</button></li>
        </ul>
      </div>
    </div>

    <div class="nav__bar" data-nav-bar>
      <form
        class="nav__ask"
        data-nav-ask
        data-first={navGreeting.first}
        data-second={navGreeting.second}
        data-not-connected={navGreeting.ask.notConnected}
        data-placeholder={navGreeting.ask.placeholder}
        data-placeholder-after={navGreeting.ask.placeholderAfterMs}
        data-placeholder-enabled={navGreeting.ask.placeholderEnabled ? 'true' : 'false'}
        action={navGreeting.ask.handler}
        method="post"
      >
        <span class="nav__ai" data-nav-ai aria-hidden="true">
          <!-- Two copies of the mark: on each press the next one pushes the current one out. -->
          <svg class="nav__ai-current" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M7.5 1C7.5 2.49363 7.43712 3.64056 7.25977 4.52734C7.08347 5.40861 6.8021 5.99087 6.39648 6.39648C5.99087 6.8021 5.40861 7.08347 4.52734 7.25977C3.64056 7.43712 2.49363 7.5 1 7.5V8.5C2.49363 8.5 3.64056 8.56288 4.52734 8.74023C5.40861 8.91653 5.99087 9.1979 6.39648 9.60352C6.8021 10.0091 7.08347 10.5914 7.25977 11.4727C7.43712 12.3594 7.5 13.5064 7.5 15H8.5C8.5 13.5064 8.56288 12.3594 8.74023 11.4727C8.91653 10.5914 9.1979 10.0091 9.60352 9.60352C10.0091 9.1979 10.5914 8.91653 11.4727 8.74023C12.3594 8.56288 13.5064 8.5 15 8.5V7.5C13.5064 7.5 12.3594 7.43712 11.4727 7.25977C10.5914 7.08347 10.0091 6.8021 9.60352 6.39648C9.1979 5.99087 8.91653 5.40861 8.74023 4.52734C8.56288 3.64056 8.5 2.49363 8.5 1H7.5Z" fill="currentColor" stroke="currentColor" />
          </svg>
          <svg class="nav__ai-next" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M7.5 1C7.5 2.49363 7.43712 3.64056 7.25977 4.52734C7.08347 5.40861 6.8021 5.99087 6.39648 6.39648C5.99087 6.8021 5.40861 7.08347 4.52734 7.25977C3.64056 7.43712 2.49363 7.5 1 7.5V8.5C2.49363 8.5 3.64056 8.56288 4.52734 8.74023C5.40861 8.91653 5.99087 9.1979 6.39648 9.60352C6.8021 10.0091 7.08347 10.5914 7.25977 11.4727C7.43712 12.3594 7.5 13.5064 7.5 15H8.5C8.5 13.5064 8.56288 12.3594 8.74023 11.4727C8.91653 10.5914 9.1979 10.0091 9.60352 9.60352C10.0091 9.1979 10.5914 8.91653 11.4727 8.74023C12.3594 8.56288 13.5064 8.5 15 8.5V7.5C13.5064 7.5 12.3594 7.43712 11.4727 7.25977C10.5914 7.08347 10.0091 6.8021 9.60352 6.39648C9.1979 5.99087 8.91653 5.40861 8.74023 4.52734C8.56288 3.64056 8.5 2.49363 8.5 1H7.5Z" fill="currentColor" stroke="currentColor" />
          </svg>
        </span>
        <button class="nav__prompt" type="button" aria-label={navGreeting.ask.label} data-nav-prompt>
          <span class="nav__typed" data-nav-typed><span class="nav__typed-head" data-nav-typed-head></span><span data-nav-typed-rest></span></span><span class="nav__cursor" aria-hidden="true">_</span>
        </button>
        <input
          class="nav__input"
          type="text"
          name="q"
          autocomplete="off"
          aria-label={navGreeting.ask.label}
          data-nav-input
          hidden
        />
        <!-- The bar's line with links in it (built by the script): the
             compact question and the greeting's audience word. Copy from
             navGreeting.audience. -->
        <span
          class="nav__who"
          role="group"
          data-nav-switch
          data-copy={JSON.stringify({ question: aud.question, choice: aud.choice, founder: aud.founder, investor: aud.investor })}
          data-greet-morning={aud.greeting.morning}
          data-greet-afternoon={aud.greeting.afternoon}
          data-greet-evening={aud.greeting.evening}
          data-greet-template={aud.greeting.template}
          hidden
        ></span>
      </form>


      <button
        class="nav__menu"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Menu"
        data-nav-menu
      >
        <svg class="nav__icon" data-icon-closed width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="1.75" />
        </svg>
        <svg class="nav__icon" data-icon-open width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.75" />
        </svg>
      </button>
    </div>
  </nav>
</div>

<style>
  /* Open / close motion: fluid and snappy, the same in both directions. */
  .nav {
    --nav-open-ms: 420ms;
    --nav-open-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --nav-close-ms: var(--nav-open-ms);     /* close mirrors open */
    --nav-close-ease: var(--nav-open-ease);
  }

  /* No transform on .nav itself: the scrim is a fixed child and must span
     the viewport. The entrance slide lives on .nav__root. */
  .nav {
    position: fixed;
    bottom: var(--gap);
    left: 0;
    right: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    pointer-events: none;
    color: var(--nav-fg);
  }

  /* Gradient behind the bar: black 30% at the viewport bottom to black 0%
     at 20px above the bar. Fades in once the bar has slid into place. */
  .nav__shade {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -2;
    height: calc(var(--nav-height) + var(--gap) + 20px);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0));
    opacity: 0;
    transition: opacity 320ms ease 480ms;
    pointer-events: none;
  }

  .nav[data-visible] .nav__shade {
    opacity: 1;
  }

  /* 80% white layer over the pushed-back page while the panel is open */
  .nav__scrim {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(255, 255, 255, 0.8);
    opacity: 0;
    transition: opacity var(--nav-close-ms) var(--nav-close-ease);
    pointer-events: auto;
  }

  .nav[data-open] .nav__scrim {
    opacity: 1;
    transition: opacity var(--nav-open-ms) var(--nav-open-ease);
  }

  .nav__root {
    position: relative;
    width: min(var(--col-12), calc(100vw - 2 * var(--page-margin)));
    pointer-events: auto;
    /* Hidden below the viewport until the first scroll */
    transform: translateY(calc(100% + var(--gap) + var(--space-4x)));
    transition:
      transform 480ms cubic-bezier(0.2, 0.7, 0.2, 1),
      width 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---- Compact (I am a: Founder / Investor) ---- */
  .nav[data-compact] .nav__root {
    width: min(var(--nav-compact-w, 400px), calc(100vw - 2 * var(--page-margin)));
  }
  /* Only the hamburger opens the panel in this state (it stays, owner
     2026-11-04, so the site can still be navigated). */
  .nav[data-compact] .nav__bar,
  .nav[data-compact] .nav__ask,
  .nav[data-compact] .nav__prompt {
    cursor: default;
  }
  /* The question with its two clickable words (owner, 2026-11-06): same
     type as the line, the words underlined, already while they are typed
     (.nav__typed-link). It replaces the typed line once that has been
     typed out, so it reads as one line. */
  .nav__who {
    min-width: 0;
    padding: var(--space-2x) 0;
    white-space: nowrap;
    overflow: hidden; /* never under the hamburger */
  }
  .nav__who[hidden] {
    display: none;
  }
  .nav__typed :global(.nav__typed-link),
  .nav__who :global(.nav__who-opt) {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .nav__who :global(.nav__who-opt) {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .nav__who :global(.nav__who-opt:hover) {
    text-decoration-thickness: 2px;
  }
  .nav__who :global(.nav__who-opt:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__root {
      transition: none;
    }
  }

  .nav[data-visible] .nav__root {
    transform: none;
  }

  /* ---- Bar (closed state) ---- */
  .nav__bar {
    position: relative;
    z-index: 1; /* above the panel: the closing panel never overlaps the bar */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap);
    min-height: var(--nav-height);
    /* Left 16px: the AI mark sits as far in as the hamburger glyph on the
       right (12px padding + the button's 4px inset). */
    padding: 0 var(--gap-half) 0 var(--space-4x);
    background-color: var(--nav-bg);
    /* Entrance glow: transparent to --nav-glow-color across the bar, sliding
       out to the right like the H1's last word (see .nav[data-visible]
       below). At rest (--nav-glow: 100%) the colour sits past the right edge.
       #DB8E00 on the black bar, #FFEA6D on the white one (owner, 2026-10-17). */
    --nav-glow-color: #db8e00;
    background-image: linear-gradient(
      90deg,
      transparent var(--nav-glow),
      var(--nav-glow-color) calc(var(--nav-glow) + 100%)
    );
    border-radius: var(--radius);
    /* closing: colour changes together with the panel above it */
    transition:
      background-color var(--nav-close-ms) var(--nav-close-ease),
      color var(--nav-close-ms) var(--nav-close-ease);
    cursor: pointer; /* the whole bar toggles the menu */
    user-select: none;
  }

  .nav[data-open] .nav__bar {
    background-color: var(--nav-bg-open);
    transition:
      background-color var(--nav-open-ms) var(--nav-open-ease),
      color var(--nav-open-ms) var(--nav-open-ease);
  }

  /* Closed bar over a dark area ([data-nav-dark]): inverted. The panel takes
     the same colour while closed, so opening and folding away animate bar
     and panel together (white <-> #000), never apart. */
  .nav[data-inverse]:not([data-open]) .nav__bar,
  .nav[data-inverse]:not([data-open]) .nav__panel {
    background-color: var(--nav-bg-inverse);
  }

  /* The glow plays once, as the bar slides in: same span and easing as the
     H1's last word (--reveal-tint-duration, --reveal-gentle-ease). */
  @property --nav-glow {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 100%;
  }
  .nav[data-visible] .nav__bar {
    animation: nav-glow var(--reveal-tint-duration) var(--reveal-gentle-ease) both;
  }
  @keyframes nav-glow {
    from { --nav-glow: 0%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav[data-visible] .nav__bar {
      animation: none;
    }
  }
  .nav[data-inverse]:not([data-open]) .nav__bar {
    --nav-glow-color: var(--brand-yellow);
    color: var(--nav-fg-inverse);
  }
  /* White bar: the AI mark in the bar's dark text colour instead of yellow. */
  .nav[data-inverse]:not([data-open]) .nav__ai {
    color: var(--nav-fg-inverse);
  }
  .nav[data-inverse]:not([data-open]) .nav__menu:focus-visible {
    background: rgba(0, 0, 0, 0.08);
  }

  /* A founder's bar (owner, 2026-11-06): light blue with black text and
     icons, over light and dark areas alike, while closed. The panel takes
     the colour too so opening animates bar and panel together. An
     investor's bar keeps the usual colours. */
  .nav[data-founder]:not([data-open]) .nav__bar,
  .nav[data-founder]:not([data-open]) .nav__panel {
    background-color: var(--nav-bg-founder);
  }
  .nav[data-founder]:not([data-open]) .nav__bar {
    --nav-glow-color: #ffffff;
    color: var(--nav-fg-founder);
  }
  .nav[data-founder]:not([data-open]) .nav__ai {
    color: var(--nav-fg-founder);
  }
  .nav[data-founder]:not([data-open]) .nav__menu:focus-visible {
    background: rgba(0, 0, 0, 0.08);
  }

  /* While the panel is out (opening, open or folding away), the bar's top
     corners are square so bar and panel read as one shape. */
  .nav[data-shape] .nav__bar {
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .nav__ask {
    display: flex;
    align-items: center;
    gap: var(--space-2x);
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: 1;
    letter-spacing: 0;
    cursor: pointer;
  }

  /* AI mark: always in the bar, left of the greeting. Two stacked copies;
     on each press of the bar (.is-swap) the current one shrinks and is
     pushed up and to the right while the next one grows in from the bottom
     left into the same spot. When that ends both reset, which looks the
     same, ready for the next press. */
  .nav__ai {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-self: center;
    width: 16px;
    height: 16px;
    color: var(--brand-yellow);
  }
  .nav__ai svg {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
  }
  .nav__ai-next {
    opacity: 0;
  }
  .nav__ai.is-swap .nav__ai-current {
    animation: nav-ai-out 840ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  .nav__ai.is-swap .nav__ai-next {
    animation: nav-ai-in 840ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  @keyframes nav-ai-out {
    from { transform: none; }
    to   { transform: translate(6px, -6px) scale(0); }
  }
  @keyframes nav-ai-in {
    from { opacity: 1; transform: translate(-10px, 10px) scale(0); }
    to   { opacity: 1; transform: none; }
  }

  .nav__prompt {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
    margin: 0;
    padding: var(--space-2x) 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
  }

  .nav__prompt:focus,
  .nav__prompt:focus-visible {
    outline: none;
  }

  /* Placeholder state: grey text. The cursor follows the text like everywhere
     else and is hidden when idle. */
  .nav__prompt.is-placeholder .nav__typed {
    color: rgba(255, 255, 255, 0.5);
  }


  .nav__prompt[hidden] {
    display: none;
  }

  .nav__input {
    cursor: pointer; /* hand pointer across the whole bar */
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: var(--space-2x) 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    outline: none;
  }

  .nav__input::placeholder {
    color: inherit;
    opacity: 0.5;
  }

  .nav__input[hidden] {
    display: none;
  }

  .nav__cursor {
    display: inline-block;
    animation: nav-blink 600ms steps(1, end) infinite;
  }

  @keyframes nav-blink {
    50% { opacity: 0; }
  }

  /* The cursor exists only while text is being typed or erased */
  .nav__cursor.is-still {
    display: none;
  }

  .nav__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--form-height-small);
    height: var(--form-height-small);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  /* No outline on the hamburger. Keyboard focus shows as a faint tint. */
  .nav__menu:focus,
  .nav__menu:focus-visible {
    outline: none;
  }
  .nav__menu:focus-visible {
    background: rgba(255, 255, 255, 0.15);
  }

  .nav__icon {
    display: block;
  }

  /* Hamburger when closed, cross when open */
  .nav__icon[data-icon-open],
  .nav[data-open] .nav__icon[data-icon-closed] {
    display: none;
  }
  .nav[data-open] .nav__icon[data-icon-open] {
    display: block;
  }

  .nav :global(:focus-visible) {
    outline-color: var(--nav-fg);
  }

  /* ---- Panel (open state) ---- */
  .nav__panel {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - var(--nav-height) - 3 * var(--gap));
    max-height: calc(100dvh - var(--nav-height) - 3 * var(--gap));
    overflow-y: auto;
    padding: var(--gap);
    /* The panel and the bar are one surface: same colour rule, same timing.
       It folds down into the bar (clip from the top) instead of fading, so
       there is never a dark panel over a light bar or the other way round. */
    background: var(--nav-bg);
    border-radius: var(--radius) var(--radius) 0 0;
    clip-path: inset(100% 0 0 0 round var(--radius) var(--radius) 0 0);
    transition:
      clip-path var(--nav-close-ms) var(--nav-close-ease),
      background-color var(--nav-close-ms) var(--nav-close-ease);
  }

  .nav[data-open] .nav__panel {
    background: var(--nav-bg-open);
    clip-path: inset(0 0 0 0 round var(--radius) var(--radius) 0 0);
    transition:
      clip-path var(--nav-open-ms) var(--nav-open-ease),
      background-color var(--nav-open-ms) var(--nav-open-ease);
  }

  .nav__columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gap);
  }

  /* The choice panel (owner, 2026-11-06): instead of the site menu, a
     label with the current choice and two options, in the panel's own
     type (mono label as the column titles, then card-title size). */
  .nav__choice {
    display: none;
  }
  .nav[data-panel-choice] .nav__columns {
    display: none;
  }
  .nav[data-panel-choice] .nav__choice {
    display: block;
  }
  .nav__choice-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-label);
    font-weight: 500;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .nav__choice-list {
    display: flex;
    flex-direction: column;
    margin: var(--space-2x) 0 0;
    padding: 0;
    list-style: none;
  }
  .nav__choice-list li + li {
    border-top: var(--hairline-w) solid var(--nav-hairline);
  }
  .nav__choice-opt {
    display: block;
    width: 100%;
    margin: 0;
    padding: var(--space-4x) 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-sans);
    font-size: var(--fs-card-title);
    line-height: var(--lh-card-title);
    letter-spacing: var(--ls-card-title);
    text-align: left;
    cursor: pointer;
  }
  .nav__choice-opt:hover {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }
  .nav__choice-opt:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .nav__col-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-half);
  }

  .nav__col-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-label);
    font-weight: 500;
    text-transform: uppercase;
    text-decoration-line: none;
    opacity: 0.7;
  }

  .nav__col-title:hover,
  .nav__col-title[aria-current='true'] {
    opacity: 1;
  }

  .nav__acc {
    display: none;
    margin: 0;
    padding: var(--space-2x);
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .nav__acc[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2x);
    margin: var(--gap-half) 0 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-block;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    text-decoration-line: none;
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }

  /* ---- 880px: accordion columns ---- */
  @media (max-width: 880px) {
    .nav__columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .nav__col {
      border-top: var(--hairline-w) solid var(--nav-hairline);
    }

    .nav__col:first-child {
      border-top: 0;
    }

    /* First item: no extra room on top of the panel's own padding. */
    .nav__col:first-child .nav__col-head {
      padding-top: 0;
    }

    .nav__col-head {
      padding: var(--gap-half) 0;
    }

    .nav__col-title {
      font-family: var(--font-sans);
      font-size: var(--fs-card-title);
      letter-spacing: var(--ls-card-title);
      line-height: var(--lh-card-title);
      text-transform: none;
      opacity: 1;
    }

    .nav__acc {
      display: inline-flex;
    }

    .nav__list {
      display: none;
      margin: 0;
      padding: 0 0 var(--gap-half);
    }

    .nav__col.is-open .nav__list {
      display: flex;
    }

    .nav__link {
      font-size: var(--fs-body);
      padding: var(--space) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__cursor {
      animation: none;
    }
    .nav__ai.is-swap svg {
      animation: none;
    }
  }
</style>

<script>
  const rootEl = document.querySelector<HTMLElement>('[data-nav]');
  const pageEl = document.querySelector<HTMLElement>('[data-page]');

  if (rootEl && pageEl) {
    // Narrowed consts so nested functions see non-null elements.
    const root: HTMLElement = rootEl;
    const page: HTMLElement = pageEl;
    const panel = root.querySelector<HTMLElement>('[data-nav-panel]')!;
    const bar = root.querySelector<HTMLElement>('[data-nav-bar]')!;
    const scrim = root.querySelector<HTMLElement>('[data-nav-scrim]')!;
    const menu = root.querySelector<HTMLButtonElement>('[data-nav-menu]')!;
    const cols = Array.from(root.querySelectorAll<HTMLElement>('[data-nav-col]'));
    const accs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-nav-acc]'));
    const greeting = root.querySelector<HTMLFormElement>('[data-nav-ask]')!;
    const typedHead = root.querySelector<HTMLElement>('[data-nav-typed-head]')!;
    const typedRest = root.querySelector<HTMLElement>('[data-nav-typed-rest]')!;
    const HEAD_CHARS = 6;
    let current = '';
    /* ---- Lines with links ----
       Three lines carry underlined words (owner, 2026-11-06): the compact
       bar's "Are you a founder or investor?", the greeting after a choice
       ("Good afternoon, founder!", the audience word, which opens the
       panel with only the choice: switch or reset).
       The words are underlined while they are typed and erased; once a
       line is typed out (and is the one the bar should offer) the same
       words become buttons in [data-nav-switch], which takes the typed
       line's place, so nothing moves. */
    type LineLink = { start: number; end: number; act: () => void };
    type LineSpec = { text: string; links: LineLink[] };
    const who = root.querySelector<HTMLElement>('[data-nav-switch]')!;
    type Copy = {
      question: { before: string; between: string; after: string };
      choice: { title: string; switchTo: string; reset: string };
      founder: { label: string; word: string };
      investor: { label: string; word: string };
    };
    const COPY: Copy = JSON.parse(who.dataset.copy || '{}');
    let audience = '';
    let compact = false;
    let choicePanel = false; // the panel is open with only the choice
    function lineOf(parts: (string | [string, () => void])[]): LineSpec {
      let text = '';
      const links: LineLink[] = [];
      for (const part of parts) {
        if (typeof part === 'string') { text += part; continue; }
        links.push({ start: text.length, end: text.length + part[0].length, act: part[1] });
        text += part[0];
      }
      return { text, links };
    }
    const labelOf = (word: string) => (word === COPY.founder.word ? COPY.founder.label : COPY.investor.label);
    function questionLine(): LineSpec {
      const q = COPY.question;
      return lineOf([q.before, [COPY.founder.label, () => choose(COPY.founder.word)], q.between, [COPY.investor.label, () => choose(COPY.investor.word)], q.after]);
    }
    function greetingLine(): LineSpec | null {
      if (!audience) return null;
      const h = new Date().getHours();
      const d = who.dataset;
      const daytime = (h >= 5 && h < 12 ? d.greetMorning : h >= 12 && h < 18 ? d.greetAfternoon : d.greetEvening) || '';
      const t = d.greetTemplate || '';
      const at = t.indexOf('{audience}');
      if (at < 0) return lineOf([t.replace('{daytime}', daytime)]);
      return lineOf([t.slice(0, at).replace('{daytime}', daytime), [labelOf(audience), () => open(true)], t.slice(at + 10).replace('{daytime}', daytime)]);
    }
    // Every line that underlines (for typing), and the one the bar offers
    // as buttons right now.
    function allLines(): LineSpec[] {
      return [questionLine(), greetingLine()].filter((l): l is LineSpec => !!l);
    }
    function offeredLine(): LineSpec | null {
      if (isOpen) return null;
      if (compact && !audience) return questionLine();
      if (!compact) return greetingLine();
      return null;
    }
    function hideWho() {
      if (who.hidden) return;
      who.hidden = true;
      if (input.hidden) prompt.hidden = false;
    }
    // Swap the typed line for its buttons once it is out.
    function linkIfDone() {
      if (!input.hidden || prompt.hidden || prompt.classList.contains('is-placeholder')) return;
      const line = offeredLine();
      if (!line || line.text !== current) return;
      const nodes: (string | HTMLElement)[] = [];
      let at = 0;
      for (const l of line.links) {
        if (l.start > at) nodes.push(line.text.slice(at, l.start));
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'nav__who-opt';
        btn.textContent = line.text.slice(l.start, l.end);
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          l.act();
        });
        nodes.push(btn);
        at = l.end;
      }
      if (at < line.text.length) nodes.push(line.text.slice(at));
      who.replaceChildren(...nodes);
      who.setAttribute('aria-label', line.text);
      prompt.hidden = true;
      who.hidden = false;
    }
    function setTyped(text: string) {
      current = text;
      hideWho();
      const line = text ? allLines().find((l) => l.text.startsWith(text)) : undefined;
      if (line && line.links.length) {
        const parts: (string | HTMLElement)[] = [];
        let at = 0;
        for (const { start: a, end: b } of line.links) {
          if (a >= text.length) break;
          if (a > at) parts.push(text.slice(at, a));
          const u = document.createElement('span');
          u.className = 'nav__typed-link';
          u.textContent = text.slice(a, Math.min(b, text.length));
          parts.push(u);
          at = Math.min(b, text.length);
        }
        if (at < text.length) parts.push(text.slice(at));
        typedHead.textContent = '';
        typedRest.replaceChildren(...parts);
        return;
      }
      typedHead.textContent = text.slice(0, HEAD_CHARS);
      typedRest.textContent = text.slice(HEAD_CHARS);
    }
    const prompt = root.querySelector<HTMLButtonElement>('[data-nav-prompt]')!;
    const input = root.querySelector<HTMLInputElement>('[data-nav-input]')!;
    const ai = root.querySelector<HTMLElement>('[data-nav-ai]')!;
    const cursor = root.querySelector<HTMLElement>('.nav__cursor')!;
    const mobile = window.matchMedia('(max-width: 880px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isOpen = false;
    // Track input modality so focus is only moved for keyboard users.
    let keyboard = false;
    document.addEventListener('keydown', () => (keyboard = true), true);
    document.addEventListener('pointerdown', () => (keyboard = false), true);

    /* ---- Entrance on first scroll ---- */
    let shown = false;
    function show() {
      if (shown) return;
      shown = true;
      root.setAttribute('data-visible', '');
      window.removeEventListener('scroll', show);
      window.removeEventListener('wheel', show);
      window.removeEventListener('touchmove', show);
      document.removeEventListener('keydown', onFirstTab);
      startGreeting();
    }
    function onFirstTab(e: KeyboardEvent) {
      if (e.key === 'Tab') show();
    }
    const canScroll = document.documentElement.scrollHeight > window.innerHeight + 1;
    if (!canScroll || window.scrollY > 0) {
      requestAnimationFrame(() => requestAnimationFrame(show));
    } else {
      window.addEventListener('scroll', show, { passive: true });
      window.addEventListener('wheel', show, { passive: true });
      window.addEventListener('touchmove', show, { passive: true });
      document.addEventListener('keydown', onFirstTab);
    }

    /* ---- Typewriter greeting ----
       Closed: "Welcome to FORWARD.one" stays until the bar is pressed.
       Open:   the AI mark swaps, the line becomes "How can we help you?",
               and after a short hold it turns into the grey placeholder.
       Closing again types the welcome line back. Every sequence gets a run
       id; starting a new one cancels whatever was still typing. */
    const first = greeting.dataset.first || '';
    // After the visitor has said who they are (the compact bar's question),
    // the closed line greets them by time of day instead of "Welcome to
    // FORWARD.one", and a founder's bar turns light blue. Remembered for
    // the visit (sessionStorage).
    const AUDIENCE_KEY = 'forwardone-audience';
    try { audience = sessionStorage.getItem(AUDIENCE_KEY) || ''; } catch { /* storage blocked */ }
    const applyAudience = () => root.toggleAttribute('data-founder', audience === 'founder');
    applyAudience();
    // Below the "I am a" zone (homepage section 4 on) the closed line asks
    // "How can we help you?" instead of welcoming (owner, 2026-11-05).
    let pastAudienceZone = false;
    function welcomeLine() {
      const g = greetingLine();
      return g ? g.text : pastAudienceZone ? second : first;
    }
    const second = greeting.dataset.second || '';
    const TYPE_MS = 55;
    const ERASE_MS = 30;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    let runId = 0;
    const alive = (id: number) => id === runId;
    // Idle: no cursor; a line with links gets its buttons.
    function idle() {
      cursor.classList.add('is-still');
      linkIfDone();
    }

    // The AI mark is always shown. Every interaction of the bar plays the
    // same swap, once (owner, 2026-11-05): opening, closing, shrinking,
    // growing, choosing, and every change of the line (erasing or typing,
    // the first welcome included). A swap already under way is not
    // restarted, so an interaction that erases and then types still shows
    // one whole, even movement.
    const aiNext = ai.querySelector<SVGElement>('.nav__ai-next')!;
    let swapping = false;
    aiNext.addEventListener('animationend', () => {
      ai.classList.remove('is-swap');
      swapping = false;
    });
    function swapAi() {
      if (reduceMotion.matches || swapping) return;
      swapping = true;
      ai.classList.remove('is-swap');
      void ai.offsetWidth;
      ai.classList.add('is-swap');
    }
    async function typeText(text: string, id: number) {
      swapAi();
      cursor.classList.remove('is-still');
      for (let i = 1; i <= text.length; i++) {
        if (!alive(id)) return;
        setTyped(text.slice(0, i));
        await wait(TYPE_MS);
      }
    }
    async function eraseText(id: number) {
      if (current) swapAi();
      cursor.classList.remove('is-still');
      let text = current;
      while (text.length) {
        if (!alive(id)) return;
        text = text.slice(0, -1);
        setTyped(text);
        await wait(ERASE_MS);
      }
    }

    /* ---- States ---- */
    const notConnected = greeting.dataset.notConnected || '';
    const placeholder = greeting.dataset.placeholder || '';
    const placeholderAfter = Number(greeting.dataset.placeholderAfter) || 2000;
    let placeholderMode = false;

    function showPrompt() {
      prompt.hidden = false;
      input.hidden = true;
    }
    // Closed state: the welcome line.
    async function toWelcome(animate: boolean, delay = 0) {
      const id = ++runId;
      placeholderMode = false;
      showPrompt();
      if (!animate || reduceMotion.matches) {
        prompt.classList.remove('is-placeholder');
        setTyped(welcomeLine());
        idle();
        return;
      }
      if (delay) await wait(delay);
      if (!alive(id)) return;
      // Already (being) typed, as after a choice in the compact bar: carry
      // on from there rather than erase and type it again.
      const target = welcomeLine();
      if (current && target.startsWith(current) && !prompt.classList.contains('is-placeholder')) {
        await retypeTo(target, id);
        return;
      }
      if (current) {
        await eraseText(id);
        if (!alive(id)) return;
        await wait(120);
        if (!alive(id)) return;
      }
      prompt.classList.remove('is-placeholder');
      await typeText(welcomeLine(), id);
      if (alive(id)) idle();
    }
    // Open state, idle: the grey placeholder.
    const placeholderEnabled = greeting.dataset.placeholderEnabled === 'true';
    // Open state, idle: the grey placeholder, or the question while the
    // placeholder step is switched off.
    function setPlaceholderState() {
      ++runId;
      placeholderMode = true;
      prompt.classList.toggle('is-placeholder', placeholderEnabled);
      setTyped(placeholderEnabled ? placeholder : second);
      idle();
      showPrompt();
    }
    // Open state: the question, then the grey placeholder.
    async function toQuestion() {
      const id = ++runId;
      placeholderMode = false;
      showPrompt();
      if (reduceMotion.matches) {
        prompt.classList.remove('is-placeholder');
        setTyped(second);
        idle();
        return;
      }
      await eraseText(id);
      if (!alive(id)) return;
      prompt.classList.remove('is-placeholder');
      await wait(240);
      if (!alive(id)) return;
      await typeText(second, id);
      if (!alive(id)) return;
      idle();
      if (!placeholderEnabled) {
        placeholderMode = true; // typing anywhere still starts a question
        return;
      }
      await wait(placeholderAfter);
      if (!alive(id)) return;
      await eraseText(id);
      if (!alive(id)) return;
      prompt.classList.add('is-placeholder');
      await typeText(placeholder, id);
      if (!alive(id)) return;
      idle();
      placeholderMode = true;
    }

    /* ---- Click to type ---- */
    function startTyping() {
      swapAi();
      hideWho();
      ++runId; // stop any sequence still typing
      placeholderMode = false;
      prompt.hidden = true;
      input.hidden = false;
      input.focus();
    }
    function stopTyping() {
      if (input.value.trim()) return; // keep the field while there is text
      if (isOpen) setPlaceholderState();
      else toWelcome(false);
    }
    // Typing anywhere while the placeholder is showing starts the question.
    document.addEventListener('keydown', (e) => {
      if (!placeholderMode || !input.hidden) return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.key.length !== 1 || e.key === ' ') return;
      const el = document.activeElement as HTMLElement | null;
      if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) return;
      e.preventDefault();
      startTyping();
      input.value = e.key;
    });
    // The whole bar opens the menu; the prompt also drops you into the field.
    // The bar handler runs after this one (bubbling), so open there, type here.
    prompt.addEventListener('click', () => {
      if (compact || choicePanel) return;
      if (!isOpen) {
        // Let the bar's click handler open the panel first, then type.
        setTimeout(startTyping, 0);
      } else {
        startTyping();
      }
    });
    // Clicks inside the text field itself must not close the open panel.
    input.addEventListener('click', (e) => e.stopPropagation());
    input.addEventListener('blur', stopTyping);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.stopPropagation();
        input.value = '';
        input.blur();
      }
    });
    greeting.addEventListener('submit', (e) => {
      // [PLACEHOLDER] handler: no backend yet.
      e.preventDefault();
      if (!input.value.trim()) return;
      input.value = '';
      input.blur(); // settle the blur first so it cannot cancel the restore below
      const id = ++runId;
      showPrompt();
      prompt.classList.remove('is-placeholder');
      setTyped(notConnected);
      swapAi();
      idle();
      window.setTimeout(() => {
        if (!alive(id) || !input.hidden) return;
        if (isOpen) setPlaceholderState();
        else toWelcome(true);
      }, 3000);
    });

    function startGreeting() {
      // First appearance: type the welcome line once the bar has slid in.
      toWelcome(true, 480);
    }

    /* ---- Panel open / close ---- */
    function setAccordion(col: HTMLElement, open: boolean) {
      col.classList.toggle('is-open', open);
      const btn = col.querySelector<HTMLButtonElement>('[data-nav-acc]');
      if (btn) btn.setAttribute('aria-expanded', String(open));
    }

    // `choice`: opened from the greeting's audience word, the panel holds
    // only the choice (switch or reset) and the line keeps the greeting.
    function open(choice = false) {
      show();
      isOpen = true;
      choicePanel = choice;
      root.toggleAttribute('data-panel-choice', choice);
      if (choice) fillChoice();
      // From the compact bar: full width for the panel, the question put
      // away (it comes back when the panel closes, see close()).
      if (compact) root.removeAttribute('data-compact');
      hideWho();
      window.clearTimeout(closeTimer);
      panel.hidden = false;
      scrim.hidden = false;
      root.setAttribute('data-shape', '');
      void panel.offsetWidth; // start the fold from the collapsed state
      requestAnimationFrame(() => root.setAttribute('data-open', ''));
      // Push the page back from the centre of the visible viewport.
      page.style.transformOrigin = `50% ${window.scrollY + window.innerHeight / 2}px`;
      page.classList.add('is-pushed');
      page.setAttribute('inert', '');
      document.documentElement.style.overflow = 'hidden';
      swapAi();
      if (input.hidden && !choice) toQuestion();
      menu.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-label', 'Close menu');
      for (const c of cols) setAccordion(c, false);
      if (keyboard && input.hidden) {
        const firstTarget = choice
          ? panel.querySelector<HTMLElement>('[data-nav-choice-switch]')
          : panel.querySelector<HTMLElement>(mobile.matches ? '[data-nav-acc]' : 'a');
        firstTarget?.focus();
      }
    }

    let closeTimer: number | undefined;
    function close() {
      if (!isOpen) return;
      isOpen = false;
      root.removeAttribute('data-open');
      // Let the fold play out, then take the panel out of the tree and give
      // the bar its rounded top corners back.
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (isOpen) return;
        panel.hidden = true;
        scrim.hidden = true;
        root.removeAttribute('data-shape');
        root.removeAttribute('data-panel-choice');
      }, 460);
      choicePanel = false;
      page.classList.remove('is-pushed');
      page.removeAttribute('inert');
      document.documentElement.style.overflow = '';
      swapAi();
      if (compact) {
        root.setAttribute('data-compact', '');
        compactLine(++runId);
      } else if (input.hidden || !input.value.trim()) toWelcome(true);
      menu.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-label', 'Menu');
      if (keyboard) menu.focus();
      else (document.activeElement as HTMLElement | null)?.blur();
    }

    // The whole bar toggles the menu. Keyboard activation of the hamburger
    // fires a click that bubbles here, so one handler covers both.
    bar.addEventListener('click', (e) => {
      // While the bar asks "I am a", only the hamburger opens the panel.
      if (compact && !(e.target as HTMLElement).closest('[data-nav-menu]')) return;
      const onPrompt = (e.target as HTMLElement).closest('[data-nav-prompt]');
      if (isOpen && onPrompt && !choicePanel) return; // typing, not closing
      isOpen ? close() : open();
    });

    for (const acc of accs) {
      acc.addEventListener('click', () => {
        const col = acc.closest<HTMLElement>('[data-nav-col]')!;
        const willOpen = !col.classList.contains('is-open');
        for (const c of cols) setAccordion(c, c === col && willOpen);
      });
    }

    scrim.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) close();
    });

    mobile.addEventListener('change', close);

    /* ---- Compact: "Are you a founder or investor?" ----
       Pages opt in by marking an element with data-nav-audience-after; once
       its bottom has scrolled above the bar's centre line the bar shrinks
       and asks, and scrolling back above it restores the welcome line. */
    const audienceAfter = document.querySelector<HTMLElement>('[data-nav-audience-after]');
    // The bar asks only while it is over the section right after that
    // element (on the homepage the track record, section 3); from the next
    // one on (section 4) it is back to the full bar (owner, 2026-11-05).
    let audienceZone: Element | null = audienceAfter ? audienceAfter.nextElementSibling : null;
    while (audienceZone && audienceZone.tagName === 'SCRIPT') audienceZone = audienceZone.nextElementSibling;
    // Erase back to what both lines share, type the rest.
    async function retypeTo(text: string, id: number) {
      if (reduceMotion.matches) { setTyped(text); idle(); return; }
      if (text !== current) swapAi();
      cursor.classList.remove('is-still');
      let t = current;
      while (t && !text.startsWith(t)) {
        if (!alive(id)) return;
        t = t.slice(0, -1);
        setTyped(t);
        await wait(ERASE_MS);
      }
      for (let i = t.length + 1; i <= text.length; i++) {
        if (!alive(id)) return;
        setTyped(text.slice(0, i));
        await wait(TYPE_MS);
      }
      if (alive(id)) idle();
    }
    // Exactly as the section boundary passes the bar (owner, 2026-11-05):
    // the bar shrinks at once; the line erases and the question types.
    async function toCompact() {
      if (isOpen) close();
      compact = true;
      root.setAttribute('data-compact', '');
      swapAi();
      compactLine(++runId); // the new run also cancels a welcome line close() started
    }
    async function compactLine(myId: number) {
      showPrompt();
      prompt.classList.remove('is-placeholder');
      const q = questionLine().text;
      if (reduceMotion.matches) {
        setTyped(q);
        idle();
        return;
      }
      await eraseText(myId);
      if (!alive(myId)) return;
      await typeText(q, myId);
      if (alive(myId)) idle();
    }
    function toFull() {
      compact = false;
      root.removeAttribute('data-compact');
      hideWho();
      swapAi();
      toWelcome(true);
    }
    let compactFrame = 0;
    function updateCompact() {
      compactFrame = 0;
      if (!audienceAfter) return;
      const bottom = parseFloat(getComputedStyle(root).bottom) || 0;
      const y = window.innerHeight - bottom - bar.offsetHeight / 2;
      // Once the visitor has chosen, the bar does not ask again.
      const afterPassed = audienceAfter.getBoundingClientRect().bottom < y;
      const zonePassed = !!audienceZone && audienceZone.getBoundingClientRect().bottom < y;
      const wasPast = pastAudienceZone;
      pastAudienceZone = afterPassed && zonePassed;
      const want = !audience && afterPassed && !zonePassed;
      if (want === compact) {
        // Moving between the welcome and the question without the compact
        // bar in between (a jump, or after a choice): retype the closed line.
        if (!compact && !isOpen && !audience && wasPast !== pastAudienceZone && input.hidden) toWelcome(true);
        return;
      }
      if (want) toCompact();
      else toFull();
    }
    // Choosing (owner, 2026-11-06): remember it, colour the bar (light blue
    // for a founder, black stays for an investor) and greet by time of day.
    // From the compact bar it then goes back to full width.
    function remember(word: string) {
      audience = word;
      try {
        if (word) sessionStorage.setItem(AUDIENCE_KEY, word);
        else sessionStorage.removeItem(AUDIENCE_KEY);
      } catch { /* storage blocked */ }
      applyAudience();
    }
    function choose(word: string) {
      remember(word);
      const viaKeyboard = keyboard;
      retypeTo(welcomeLine(), ++runId);
      if (viaKeyboard) menu.focus(); // the pressed word is gone; keep focus in the bar
      if (!compact) return;
      // Not at once (owner, 2026-11-04): the bar opens up again once the
      // pointer has left it and the 25px around it. Without a mouse
      // (touch, keyboard) after the greeting has been typed.
      if (hoverPointer() && !viaKeyboard) waitForLeave(() => { if (compact) toFull(); });
      else window.setTimeout(() => { if (compact) toFull(); }, 2600);
    }
    // The choice panel (owner, 2026-11-06), opened from the greeting's
    // audience word: switch to the other audience, or reset. Either one
    // closes the panel; the closed bar then greets anew (or welcomes, and
    // over section 3 asks again).
    const choiceTitle = panel.querySelector<HTMLElement>('[data-nav-choice-title]')!;
    const choiceSwitch = panel.querySelector<HTMLButtonElement>('[data-nav-choice-switch]')!;
    const choiceReset = panel.querySelector<HTMLButtonElement>('[data-nav-choice-reset]')!;
    const otherOf = (word: string) => (word === COPY.founder.word ? COPY.investor.word : COPY.founder.word);
    function fillChoice() {
      choiceTitle.textContent = COPY.choice.title.replace('{audience}', labelOf(audience));
      choiceSwitch.textContent = COPY.choice.switchTo.replace('{other}', labelOf(otherOf(audience)));
    }
    choiceSwitch.addEventListener('click', () => {
      remember(otherOf(audience));
      close();
    });
    choiceReset.addEventListener('click', () => {
      remember('');
      close();
      // Back in the question's zone, the bar asks again.
      if (audienceAfter) requestAnimationFrame(updateCompact);
    });
    const hoverPointer = () => matchMedia('(hover: hover)').matches;
    const LEAVE_MARGIN = 25;
    function waitForLeave(done: () => void) {
      const onMove = (ev: PointerEvent) => {
        const r = bar.getBoundingClientRect();
        const out =
          ev.clientX < r.left - LEAVE_MARGIN || ev.clientX > r.right + LEAVE_MARGIN ||
          ev.clientY < r.top - LEAVE_MARGIN || ev.clientY > r.bottom + LEAVE_MARGIN;
        if (!out) return;
        document.removeEventListener('pointermove', onMove);
        document.documentElement.removeEventListener('pointerleave', onLeaveWindow);
        done();
      };
      const onLeaveWindow = () => {
        document.removeEventListener('pointermove', onMove);
        document.documentElement.removeEventListener('pointerleave', onLeaveWindow);
        done();
      };
      document.addEventListener('pointermove', onMove);
      document.documentElement.addEventListener('pointerleave', onLeaveWindow);
    }
    if (audienceAfter) {
      const queueCompact = () => {
        if (!compactFrame) compactFrame = requestAnimationFrame(updateCompact);
      };
      window.addEventListener('scroll', queueCompact, { passive: true });
      window.addEventListener('resize', queueCompact);
      // A page opened already scrolled past it: once the bar has appeared.
      window.setTimeout(queueCompact, 600);
    }

    /* ---- Inverse over dark areas ---- */
    // The bar's resting centre line, measured from the viewport bottom, so the
    // check is right even before the bar has slid in.
    const darkZones = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dark]'));
    let inverseFrame = 0;
    function updateInverse() {
      inverseFrame = 0;
      const bottom = parseFloat(getComputedStyle(root).bottom) || 0;
      const y = window.innerHeight - bottom - bar.offsetHeight / 2;
      const over = darkZones.some((z) => {
        const r = z.getBoundingClientRect();
        return r.top <= y && r.bottom >= y;
      });
      root.toggleAttribute('data-inverse', over);
    }
    function queueInverse() {
      if (!inverseFrame) inverseFrame = requestAnimationFrame(updateInverse);
    }
    if (darkZones.length) {
      updateInverse();
      window.addEventListener('scroll', queueInverse, { passive: true });
      window.addEventListener('resize', queueInverse);
    }
  }
</script>
