---
/**
 * A video that plays with the scroll (owner, 2026-11-16, the Munich
 * flyover on the Insights card): its time follows the box's way through the
 * viewport, the first frame as the box comes in at the bottom, the last as
 * it leaves at the top; scrolling back plays it backward. The time glides
 * after the scroll (a short ease), so it moves slowly and smoothly.
 *
 * The file is encoded for seeking: every frame a keyframe, no sound
 * (see visuals/README.md). It loads only when the box comes within
 * 800px of the screen; until then, and without JavaScript, the poster shows.
 * Decorative: the card's title says what the article is about.
 */
interface Props {
  src: string;
  poster: string;
}
const { src, poster } = Astro.props;
---

<div class="scroll-video" data-scroll-video>
  <video muted playsinline preload="none" poster={poster} data-src={src} aria-hidden="true" tabindex="-1"></video>
</div>

<script>
  const boxes = document.querySelectorAll<HTMLElement>('[data-scroll-video]');
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const EASE = 0.1; // share of the remaining distance covered per frame (~60 fps)

  for (const box of Array.from(boxes)) {
    const video = box.querySelector('video')!;
    let ready = false, visible = false, frame = 0, shown = 0;

    // Where the box is on its way through the viewport: 0 entering at the
    // bottom, 1 leaving at the top.
    const progress = () => {
      const r = box.getBoundingClientRect();
      return clamp((innerHeight - r.top) / (innerHeight + r.height));
    };

    function tick() {
      frame = 0;
      if (!ready || !video.duration) return;
      const target = progress() * (video.duration - 0.05);
      shown += (target - shown) * EASE;
      if (Math.abs(target - shown) < 0.004) shown = target;
      if (!video.seeking && Math.abs(video.currentTime - shown) > 1 / 60) video.currentTime = shown;
      if (visible && (shown !== target || video.seeking)) frame = requestAnimationFrame(tick);
    }
    const wake = () => { if (!frame) frame = requestAnimationFrame(tick); };

    function load() {
      video.src = video.dataset.src!;
      video.preload = 'auto';
      video.load();
      video.addEventListener('loadedmetadata', () => {
        ready = true;
        shown = progress() * (video.duration - 0.05);
        video.currentTime = shown;
        // Some mobile browsers only draw a seeked frame once the video has
        // played: a muted play and pause unlocks it.
        video.play().then(() => video.pause()).catch(() => {});
        wake();
      }, { once: true });
    }

    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !video.src) load();
    }, { rootMargin: '800px 0px' }).observe(box);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) wake();
    }).observe(box);
    addEventListener('scroll', wake, { passive: true });
    addEventListener('resize', wake);
  }
</script>

<style>
  .scroll-video {
    position: absolute;
    inset: 0;
  }
  .scroll-video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
