---
/**
 * Robot arm visual (supplied by the owner, 2026-10-15): an interactive 3D
 * model of a six-axis arm holding a Sensorfact sensor, on the Sensorfact
 * article card. The arm follows the mouse while the pointer is over the box
 * (leaving eases it back), idles by glancing at spots near the viewer, turns
 * slowly; the view can be dragged to turn (the arm holds still meanwhile)
 * and a click or tap opens the card's article (owner, 2026-10-19). Cap and
 * accent yellow #FFEA6D (owner, 2026-10-17); matte black powder-coat arm
 * (owner, 2026-10-19).
 *
 * Photorealistic since 2026-11-16 (owner: "should feel super
 * photorealistic"): rendered with three.js (src/lib/robot-arm.ts), with
 * physically based materials, rounded edges, studio reflections, soft
 * shadows and filmic tone mapping. The earlier hand-written WebGL renderer
 * with its drafting grid is in the git history. three.js loads only when the
 * card comes near the viewport. It fills its container.
 */
---

<div class="fo-robot" data-robot-arm>
  <canvas role="img" aria-label="3D model of a six-axis robot arm holding a Sensorfact sensor"></canvas>
</div>

<script>
  // Load three.js and the scene only when a robot box comes near the screen.
  const boxes = document.querySelectorAll<HTMLElement>('[data-robot-arm]');
  if (boxes.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          import('../../lib/robot-arm')
            .then(({ mountRobotArm }) => mountRobotArm(e.target as HTMLElement))
            .catch(() => { /* no WebGL or the module failed: the box stays as it is */ });
        }
      },
      { rootMargin: '600px 0px' },
    );
    boxes.forEach((b) => io.observe(b));
  }
</script>

<style>
  /* A soft studio backdrop: lighter behind the arm, falling off to the edges. */
  .fo-robot {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: radial-gradient(ellipse 85% 70% at 50% 45%, #f7f7f6 0%, #eeeeec 55%, #e4e4e1 100%);
  }
  .fo-robot canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: pan-y;
  }
  .fo-robot canvas.drag {
    cursor: grabbing;
  }
</style>
