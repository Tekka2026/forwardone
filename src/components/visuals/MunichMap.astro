---
/**
 * Munich map visual (owner, 2026-10-19): a static, top-down street map of
 * central Munich in the manner of a Mapbox "Light" style: pale land,
 * slightly darker built-up blocks, a dense web of white minor streets, white
 * main roads with grey casings (the Mittlerer Ring among them), muted green
 * parks, grey-blue water and rail corridors. No names, pins or other copy on
 * the map (owner, 2026-10-19); only the legend: a 1 km scale bar and N ↑.
 * It does not move. Rendered at build time to an SVG.
 *
 * Geography: the main roads, the Isar, the parks and the landmarks are drawn
 * from real coordinates, in km from Marienplatz (48.1374 N, 11.5755 E;
 * e = east, n = north), simplified. The minor streets are NOT real: per
 * district a seeded, slightly irregular grid at that district's typical
 * street angle and block size, clipped to the district, so the map has the
 * texture of a city without claiming exact streets. Map data services
 * (OpenStreetMap, Overpass, Geofabrik, Mapbox) are not reachable from the
 * build environment, so nothing here is traced from a map service.
 */

const VB = { w: 500, h: 700 };
const C = {
  land: '#f2f1ee',
  block: '#e8e7e3',      // built-up area
  blockOuter: '#e8e7e3', // outside the Mittlerer Ring: the same, so district edges do not show
  park: '#dbe5d1',
  sand: '#e9e4d6',       // Theresienwiese
  water: '#c3d3de',
  casing: '#d6d4cf',
  road: '#ffffff',
  rail: '#bdbbb5',
};

// Top-down projection: 6.4 km across the 500-wide box, centred a little
// north of Marienplatz so the Olympiapark fits in the portrait tile.
const S = VB.w / 6.4;
const CEN = { e: 0.15, n: 0.55 };
const X = (e: number) => VB.w / 2 + (e - CEN.e) * S;
const Y = (n: number) => VB.h / 2 - (n - CEN.n) * S;
const f = (v: number) => v.toFixed(1);
type K = [number, number];
const smooth = (pts: K[], it = 2, closed = false): K[] => {
  let p = pts;
  for (let k = 0; k < it; k++) {
    const q: K[] = closed ? [] : [p[0]];
    const n = closed ? p.length : p.length - 1;
    for (let i = 0; i < n; i++) {
      const a = p[i], b = p[(i + 1) % p.length];
      q.push([a[0] * 0.75 + b[0] * 0.25, a[1] * 0.75 + b[1] * 0.25], [a[0] * 0.25 + b[0] * 0.75, a[1] * 0.25 + b[1] * 0.75]);
    }
    if (!closed) q.push(p[p.length - 1]);
    p = q;
  }
  return p;
};
const d = (pts: K[], close = false) => pts.map(([e, n], i) => `${i ? 'L' : 'M'}${f(X(e))} ${f(Y(n))}`).join('') + (close ? 'Z' : '');
const offset = (pts: K[], km: number): K[] =>
  pts.map(([e, n], i) => {
    const a = pts[Math.max(0, i - 1)], b = pts[Math.min(pts.length - 1, i + 1)];
    const de = b[0] - a[0], dn = b[1] - a[1], l = Math.hypot(de, dn) || 1;
    return [e - (dn / l) * km, n + (de / l) * km];
  });
// Seeded random numbers, so every build draws the same map.
let seed = 20261019;
const rnd = () => {
  seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// ---- Districts: built-up area, each with its typical street angle (degrees from east) and block size (km)
type District = { poly: K[]; angle: number; step: number; outer?: boolean };
const districts: District[] = [
  // outside the Mittlerer Ring: a looser grid over the whole box (first, so the districts draw over it)
  { poly: [[-3.4, -4.4], [3.7, -4.4], [3.7, 5.3], [-3.4, 5.3]], angle: 10, step: 0.21, outer: true },
  { poly: [[-1.12, 0.62], [0.12, 0.66], [0.42, 1.4], [0.5, 2.1], [-1.05, 2.15]], angle: -2, step: 0.13 }, // Maxvorstadt
  { poly: [[-0.95, 2.15], [0.5, 2.1], [0.95, 2.75], [1.2, 3.75], [-0.75, 3.75]], angle: 4, step: 0.15 }, // Schwabing
  { poly: [[-0.66, -0.4], [-0.74, 0.12], [-0.45, 0.45], [0.08, 0.66], [0.45, 0.56], [0.56, 0.15], [0.5, -0.24], [0.05, -0.54]], angle: 18, step: 0.085 }, // Altstadt
  { poly: [[-1.45, 0.25], [-0.74, 0.12], [-0.66, -0.4], [0.05, -0.54], [0.5, -0.65], [0.15, -1.0], [-0.55, -1.45], [-1.5, -1.5]], angle: -38, step: 0.14 }, // Isarvorstadt
  { poly: [[0.45, 0.56], [0.56, 0.15], [0.62, -0.1], [1.0, 0.02], [1.32, 0.48], [1.05, 0.75], [0.62, 0.72]], angle: -28, step: 0.11 }, // Lehel
  { poly: [[1.0, -0.6], [1.2, -0.05], [1.5, 0.45], [2.35, 0.4], [2.45, -1.3], [1.4, -1.35]], angle: 24, step: 0.15 }, // Haidhausen
  { poly: [[0.25, -1.05], [0.75, -0.62], [1.4, -1.35], [1.5, -2.5], [0.4, -2.6]], angle: 12, step: 0.15 }, // Au
  { poly: [[1.5, 0.45], [2.4, 0.4], [2.45, 2.2], [2.0, 1.85], [1.7, 1.2]], angle: 40, step: 0.16 }, // Bogenhausen
  { poly: [[-2.9, 0.5], [-1.12, 0.55], [-1.05, 2.15], [-0.75, 3.75], [-2.5, 3.4], [-2.95, 2.2]], angle: -18, step: 0.16 }, // Neuhausen
  { poly: [[-2.95, 0.12], [-1.45, 0.25], [-1.5, -0.25], [-2.1, -0.45], [-2.35, -1.0], [-2.9, -0.9]], angle: 6, step: 0.13 }, // Westend
  { poly: [[-2.75, -1.1], [-2.35, -1.0], [-1.5, -1.5], [-0.55, -1.45], [-0.3, -2.9], [-2.1, -2.75]], angle: 30, step: 0.17 }, // Sendling
  { poly: [[-0.55, -1.45], [0.15, -1.0], [0.4, -2.6], [-0.3, -2.95]], angle: -10, step: 0.15 },
];
// A slightly irregular street grid for one district: two families of lines
// (the second turned ~90°), each line broken into blocks of varied length
// with some blocks left out, and each line nudged off the exact grid.
const streetGrid = (dist: District): string => {
  const xs = dist.poly.map((p) => p[0]), ys = dist.poly.map((p) => p[1]);
  const cx = (Math.min(...xs) + Math.max(...xs)) / 2, cy = (Math.min(...ys) + Math.max(...ys)) / 2;
  const R = Math.hypot(Math.max(...xs) - Math.min(...xs), Math.max(...ys) - Math.min(...ys)) / 2 + 0.1;
  let out = '';
  for (const turn of [0, 90 + (rnd() - 0.5) * 8]) {
    const a = ((dist.angle + turn) * Math.PI) / 180, ux = Math.cos(a), uy = Math.sin(a), vx = -uy, vy = ux;
    const step = dist.step * (turn ? 1.15 : 1);
    for (let o = -R; o <= R; o += step) {
      const oo = o + (rnd() - 0.5) * step * 0.25;
      let t = -R;
      while (t < R) {
        const len = step * (0.9 + rnd() * 1.6);
        if (rnd() > 0.14) {
          const w0 = (rnd() - 0.5) * step * 0.16, w1 = (rnd() - 0.5) * step * 0.16;
          const p0: K = [cx + vx * (oo + w0) + ux * t, cy + vy * (oo + w0) + uy * t];
          const p1: K = [cx + vx * (oo + w1) + ux * (t + len), cy + vy * (oo + w1) + uy * (t + len)];
          out += d([p0, p1]);
        }
        t += len;
      }
    }
  }
  return out;
};
const grids = districts.map((dist) => streetGrid(dist));

// ---- Water
const isar = smooth([[-2.6, -4.6], [-2.2, -4.1], [-1.5, -2.7], [-0.58, -1.42], [0.21, -0.91], [0.62, -0.62], [0.8, -0.42], [1.03, 0.02], [1.41, 0.49], [1.75, 1.27], [2.19, 1.85], [2.7, 2.6], [3.2, 3.6], [3.6, 5.2]], 3);
const river = d([...offset(isar, 0.075), ...offset(isar, -0.075).reverse()], true);
const streams = [
  smooth([[0.95, 0.68], [1.1, 1.3], [1.35, 1.95], [1.55, 2.55], [1.75, 3.2], [2.05, 4.0], [2.35, 5.2]], 2), // Eisbach / Schwabinger Bach
  smooth([[-0.3, -2.9], [0.3, -1.9], [0.75, -1.15], [1.05, -0.5]], 2),                                     // Auer Mühlbach
];
const lakes = [
  smooth([[1.38, 2.7], [1.62, 2.66], [1.72, 2.82], [1.5, 2.9]], 2, true),        // Kleinhesseloher See
  smooth([[-2.05, 3.75], [-1.55, 3.68], [-1.2, 3.85], [-1.5, 3.95], [-1.95, 3.9]], 2, true), // Olympiasee
];

// ---- Green and open land
const parks = [
  smooth([[0.62, 0.7], [0.95, 0.72], [1.35, 1.2], [1.55, 1.9], [1.85, 2.5], [2.25, 3.4], [2.6, 5.3], [1.95, 5.3], [1.55, 3.3], [1.15, 2.4], [0.85, 1.6], [0.6, 1.0]], 2, true), // Englischer Garten
  smooth([[-2.3, 3.5], [-1.0, 3.55], [-0.9, 4.6], [-2.25, 4.65]], 1, true),      // Olympiapark
  smooth([[-0.14, 0.64], [0.33, 0.67], [0.31, 0.85], [-0.12, 0.84]], 1, true),   // Hofgarten
  smooth([[-0.95, 0.38], [-0.68, 0.36], [-0.66, 0.55], [-0.93, 0.56]], 1, true), // Alter Botanischer Garten
  smooth([[-0.5, -0.35], [-0.05, -0.5], [0.0, -0.75], [-0.55, -0.62]], 1, true), // Alter Südfriedhof
  smooth([[-0.68, 1.65], [-0.42, 1.64], [-0.42, 1.86], [-0.67, 1.87]], 1, true), // Alter Nördlicher Friedhof
  smooth([[-0.5, 2.75], [-0.05, 2.72], [0.0, 3.08], [-0.45, 3.12]], 1, true),    // Luitpoldpark
  smooth([[1.12, -0.25], [1.32, 0.15], [1.62, 0.6], [1.95, 1.25], [1.82, 1.35], [1.45, 0.75], [1.15, 0.25], [1.0, -0.15]], 1, true), // Maximiliansanlagen
  smooth([[-1.95, -3.2], [-0.75, -1.6], [0.1, -1.05], [0.25, -1.2], [-0.6, -1.85], [-1.6, -3.4]], 1, true), // Isarauen, Flaucher
];
const theresienwiese = smooth([[-1.6, -0.22], [-2.12, -0.42], [-2.25, -0.95], [-1.72, -0.9]], 1, true);

// ---- Rail corridors: into the Hauptbahnhof from the west, and the Ostbahnhof line
const railLines = [
  [[-3.6, 0.42], [-2.2, 0.38], [-1.4, 0.33], [-1.12, 0.31]] as K[],
  smooth([[1.4, -3.5], [1.9, -2.2], [2.15, -1.2], [2.3, -0.2], [2.55, 0.9], [3.7, 1.6]], 2),
];
const tracks = [-0.04, 0, 0.04].map((o) => d(offset(railLines[0], o)));

// ---- Roads
// Mittlerer Ring: Landshuter Allee (west), Georg-Brauchle- / Petuelring (north),
// Isarring, Richard-Strauss-Straße (east), Innsbrucker Ring, Candidplatz,
// Brudermühlstraße (south), Garmischer Straße (south-west)
const ringRoad = smooth([[-2.55, 0.3], [-2.6, 1.2], [-2.45, 2.2], [-2.05, 3.0], [-1.2, 3.55], [0.0, 3.55], [0.9, 3.5], [1.7, 3.25], [2.45, 2.8], [2.85, 2.0], [2.95, 0.9], [2.9, -0.1], [2.75, -1.2], [2.45, -1.85], [1.6, -2.3], [0.6, -2.6], [-0.4, -2.75], [-1.3, -2.75], [-2.05, -2.55], [-2.6, -2.0], [-2.75, -1.2], [-2.65, -0.4]], 2, true);
const primary: K[][] = [
  smooth([[-0.62, -0.42], [-0.74, 0.12], [-0.45, 0.45], [0.08, 0.68], [0.45, 0.56], [0.56, 0.15], [0.5, -0.24], [0.05, -0.56], [-0.62, -0.42]], 2), // Altstadtring
  [[0.14, 0.62], [0.36, 1.4], [0.48, 1.67], [0.8, 2.7], [1.0, 3.6], [1.2, 5.3]],      // Ludwig- / Leopoldstraße
  [[0.55, 0.62], [0.75, 0.7], [1.67, 0.58], [2.6, 0.46], [3.7, 0.5]],                 // Prinzregentenstraße
  [[-1.12, 0.22], [-2.2, 0.16], [-3.6, 0.04]],                                        // Landsberger Straße
  [[-0.62, -0.42], [-1.34, -1.01], [-2.3, -2.0], [-2.9, -2.8], [-3.4, -3.6]],          // Lindwurmstraße
  [[0.5, -0.24], [0.8, -0.42], [1.34, -0.93], [2.0, -1.4], [3.0, -2.1], [3.7, -2.5]],   // Ludwigsbrücke, Rosenheimer Straße
  [[0.14, 0.57], [-0.74, 0.9], [-1.1, 1.0], [-2.2, 1.6], [-3.5, 2.25]],               // Brienner / Nymphenburger Straße
  [[1.45, 0.45], [1.62, -0.05], [2.4, -0.25], [3.7, -0.4]],                           // Max-Weber-Platz, Einsteinstraße
];
const secondary: K[][] = [
  [[0.05, 0.12], [0.56, 0.08], [1.03, 0.02], [1.43, -0.11]],             // Maximilianstraße
  [[-1.1, 0.5], [-2.0, 1.6], [-2.8, 2.6], [-3.5, 3.5]],                  // Dachauer Straße
  [[-0.6, 1.0], [-0.7, 2.0], [-0.8, 3.0], [-0.9, 4.0], [-1.0, 5.3]],     // Schleißheimer Straße
  [[-0.88, 0.55], [-0.92, 1.4], [-0.98, 2.15]],                          // Augustenstraße
  [[-1.05, 1.25], [0.42, 1.28], [0.95, 1.3]],                            // Schellingstraße
  [[-1.0, 0.98], [0.33, 1.02]],                                          // Gabelsbergerstraße
  [[-0.8, 2.48], [0.72, 2.5], [1.4, 2.55]],                              // Hohenzollernstraße
  [[0.21, -0.91], [-0.2, -1.6], [-0.6, -2.6], [-1.0, -3.6], [-1.3, -4.4]], // Fraunhofer- / Wittelsbacher Straße
  [[-0.62, -0.05], [-1.5, -0.1], [-2.3, -0.12], [-3.6, -0.2]],           // Bayer- / Schwanthalerstraße
  [[-0.95, 0.05], [-1.0, -0.55], [-1.15, -1.0]],                          // Goethestraße
  [[1.43, -0.11], [1.62, -0.05]],                                        // to Max-Weber-Platz
  [[1.62, -0.05], [2.0, 0.55], [2.4, 1.15], [2.9, 1.8], [3.7, 2.6]],      // Ismaninger Straße
  [[1.41, 0.49], [1.9, 0.1], [2.19, -1.12]],                             // to the Ostbahnhof
  [[0.8, 2.7], [1.8, 3.2], [2.8, 3.9]],                                  // Ungererstraße
  [[-2.95, 0.6], [-2.2, 0.55], [-1.12, 0.5]],                            // Arnulfstraße
  [[0.3, -0.75], [0.75, -1.1], [1.0, -1.8], [1.2, -2.7]],                // Lilienstraße, Au
];
const pedestrian = [[-0.62, 0.05], [-0.3, 0.03], [0.0, 0.0]] as K[];    // Neuhauser / Kaufinger Straße

// scale bar: 1 km, bottom left
const bar = { x: 24, y: VB.h - 26, w: S };
---

<svg class="munich" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label="Map of central Munich: the old town, the Isar, the main streets and the Mittlerer Ring, the Englischer Garten and the Olympiapark">
  <defs>
    {districts.map((dist, i) => <clipPath id={`mm-d${i}`}><path d={d(dist.poly, true)} /></clipPath>)}
  </defs>

  <!-- Land, built-up blocks and the minor street web -->
  <rect width={VB.w} height={VB.h} fill={C.land} />
  {
    districts.map((dist, i) => (
      <g clip-path={`url(#mm-d${i})`}>
        <path d={d(dist.poly, true)} fill={dist.outer ? C.blockOuter : C.block} />
        <path d={grids[i]} fill="none" stroke={C.road} stroke-width={dist.outer ? 0.7 : 0.9} stroke-linecap="round" />
      </g>
    ))
  }

  <!-- Open land, parks, water -->
  <path d={d(theresienwiese, true)} fill={C.sand} />
  {parks.map((p) => <path d={d(p, true)} fill={C.park} />)}
  <path d={river} fill={C.water} />
  {streams.map((s) => <path d={d(s)} fill="none" stroke={C.water} stroke-width="1.6" stroke-linecap="round" />)}
  {lakes.map((l) => <path d={d(l, true)} fill={C.water} />)}

  <!-- Rail -->
  <g fill="none" stroke-linecap="butt">
    <path d={d(railLines[0])} stroke="#e3e1dc" stroke-width="16" />
    {tracks.map((t) => <path d={t} stroke={C.rail} stroke-width="1.1" />)}
    <path d={d(railLines[1])} stroke={C.rail} stroke-width="1.6" />
    <path d={d(railLines[1])} stroke={C.land} stroke-width="0.8" stroke-dasharray="3 3" />
  </g>

  <!-- Roads: casings first, then fills; the Mittlerer Ring (a main road, white like the rest) on top -->
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d={d(pedestrian)} stroke={C.casing} stroke-width="2.6" />
    <path d={d(pedestrian)} stroke="#fbfaf7" stroke-width="1.6" stroke-dasharray="1 1.5" />
    {secondary.map((r) => <path d={d(smooth(r))} stroke={C.casing} stroke-width="3.4" />)}
    {primary.map((r) => <path d={d(smooth(r))} stroke={C.casing} stroke-width="5.2" />)}
    {secondary.map((r) => <path d={d(smooth(r))} stroke={C.road} stroke-width="2.2" />)}
    {primary.map((r) => <path d={d(smooth(r))} stroke={C.road} stroke-width="3.8" />)}
    <path d={d(ringRoad, true)} stroke={C.casing} stroke-width="5.8" />
    <path d={d(ringRoad, true)} stroke={C.road} stroke-width="4.3" />
  </g>


  <!-- Scale bar and north -->
  <g font-family="Inter, system-ui, sans-serif" font-size="6" fill="#5b5a55">
    <rect x={f(bar.x - 5)} y={f(bar.y - 12)} width={f(bar.w + 10)} height="17" rx="2" fill="rgba(255,255,255,0.85)" />
    <path d={`M${f(bar.x)} ${f(bar.y - 3)}v3h${f(bar.w)}v-3`} fill="none" stroke="#5b5a55" stroke-width="0.9" />
    <text x={f(bar.x + 2)} y={f(bar.y - 4.5)}>1 km</text>
    <text x={VB.w - 24} y={f(bar.y)} text-anchor="end" font-weight="600">N ↑</text>
  </g>
</svg>

<style>
  /* Fills its container (the 5:7 tile; 7:5 on phones, cropped from the
     middle). The map paints its own land colour. */
  .munich {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
