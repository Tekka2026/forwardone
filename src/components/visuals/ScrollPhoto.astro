---
/**
 * A photo that moves with the scroll (owner, 2026-11-19, the Munich skyline
 * on the Insights card, in place of the scroll video): it drifts upward
 * while the box travels through the viewport, as the flyover video moved,
 * but over half the distance ("less visible, 50%"). The drift is `PAN` of
 * the box's height (the photo is that much taller than the box); it glides
 * after the scroll with the same short ease as ScrollVideo. With reduced
 * motion, or without JavaScript, it rests in the middle.
 *
 * `credit` puts a small photo credit in the top-left corner, a link of its
 * own above the card's link.
 */
interface Props {
  src: string;
  alt?: string;
  credit?: { label: string; href: string };
}
const { src, alt = '', credit } = Astro.props;
---

<div class="scroll-photo" data-scroll-photo>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
</div>
{
  credit && (
    <a class="scroll-photo__credit" href={credit.href} target="_blank" rel="noopener">
      {credit.label}
    </a>
  )
}

<script>
  const PAN = 0.12; // drift: 12% of the box's height over its whole pass
  const EASE = 0.1; // share of the remaining distance covered per frame
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const box of Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-photo]'))) {
    const img = box.querySelector('img')!;
    let visible = false, frame = 0, shown = -1;
    // 0 entering at the bottom, 1 leaving at the top.
    const progress = () => {
      const r = box.getBoundingClientRect();
      return clamp((innerHeight - r.top) / (innerHeight + r.height));
    };
    const place = (p: number) => {
      img.style.transform = `translate3d(0, ${(-p * PAN * box.offsetHeight).toFixed(1)}px, 0)`;
    };
    if (reduce) { place(0.5); continue; }

    function tick() {
      frame = 0;
      const target = progress();
      shown = shown < 0 ? target : shown + (target - shown) * EASE;
      if (Math.abs(target - shown) < 0.001) shown = target;
      place(shown);
      if (visible && shown !== target) frame = requestAnimationFrame(tick);
    }
    const wake = () => { if (visible && !frame) frame = requestAnimationFrame(tick); };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) { shown = -1; wake(); }
    }, { rootMargin: '100px 0px' }).observe(box);
    addEventListener('scroll', wake, { passive: true });
    addEventListener('resize', wake);
  }
</script>

<style>
  /* 1px past the box on every side (the card clips it), as ScrollVideo. */
  .scroll-photo {
    position: absolute;
    inset: -1px;
  }
  /* PAN (12%) taller than the box, starting at its top: the script moves it
     up by up to that much. Without the script it rests at the middle. */
  .scroll-photo img {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 112%;
    object-fit: cover;
    transform: translateY(-6%);
    will-change: transform;
  }
  /* Photo credit: small, in the top-left corner, over the photo. */
  .scroll-photo__credit {
    position: absolute;
    top: var(--gap-half);
    left: var(--gap-half);
    z-index: 2; /* above the card's full-size link */
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.35);
    color: rgba(255, 255, 255, 0.9);
    font-size: 11px;
    line-height: 16px;
    text-decoration-line: none;
  }
  .scroll-photo__credit:hover {
    text-decoration-line: underline;
    text-underline-offset: 2px;
  }
</style>
