---
import { whatWeDo } from '@content/home';
import { href } from '@lib/href';
import Sentences from '@components/ui/Sentences.astro';
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">{whatWeDo.eyebrow}</p>
    <h2 class="h-section section-title"><Sentences text={whatWeDo.title} /></h2>
    <div class="grid blocks">
      {
        whatWeDo.blocks.map((b) => (
          <p class="col-4 body block">
            <strong class="block__title">{b.title}</strong> {b.body}
          </p>
        ))
      }
    </div>
    <p class="section-link">
      <a class="arrow-link" href={href(whatWeDo.link.href)}>{whatWeDo.link.label}</a>
    </p>
  </div>
</section>

<style>
  .section-title {
    margin-top: var(--gap-half);
  }
  .blocks {
    margin-top: var(--space-4x);   /* heading → body: 16px */
  }
  .block__title {
    font-weight: 600;
  }
  .section-link {
    margin-top: var(--gap-double);
  }
</style>
