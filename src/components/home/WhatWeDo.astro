---
/**
 * What we do (owner, 2026-11-16): the visual fills the left half of the
 * section edge to edge, from the browser's left edge to the middle and from
 * the separator line above to the one below; the copy sits in the right
 * half (columns 8–12, column 7 left open): eyebrow, title, the three blocks
 * as a quiet list (title, small muted line, hairlines between), the link. At ≤880px the visual sits on top, full
 * width and square, touching the separator line, with the copy under it.
 */
import ArrowLink from '@components/ui/ArrowLink.astro';
import { whatWeDo } from '@content/home';
import { href, isPlaceholder } from '@lib/href';
import Sentences from '@components/ui/Sentences.astro';
import Placeholder from '@components/ui/Placeholder.astro';
import fwdSvg from '../../assets/brand/fwd-letters.svg?raw';

// The FWD letters (owner's file, 407 × 159; paths D, W, F in that order),
// laid over the ONE artwork where they sat in the owner's composite: centred
// on (1001, 1001) of its 2000 × 2000 frame, 1.85 × their size.
const [D, W, F] = [...fwdSvg.matchAll(/<path d="([^"]+)"/g)].map((m) => m[1]);
const LETTERS = [
  { key: 'f', d: F },
  { key: 'w', d: W },
  { key: 'd', d: D },
];
const SCALE = 1.85;
const AT = { x: 1001 - 203.5 * SCALE, y: 1001 - 79.5 * SCALE };
---

<section class="section split">
  <div class="split__visual" data-fwd>
    {
      isPlaceholder(whatWeDo.visual) ? (
        <Placeholder value={whatWeDo.visual} />
      ) : (
        <svg class="fwd" viewBox="0 0 2000 2000" preserveAspectRatio="xMidYMid slice" role="img" aria-label="FWD">
          <defs>
            <linearGradient id="fwd-tint" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="407" y2="0">
              <stop offset="0" stop-color="#FF0000" />
              <stop offset="1" stop-color="#820400" />
            </linearGradient>
            <!-- The letters rise out of this: their own height, at their place. -->
            <clipPath id="fwd-clip" clipPathUnits="userSpaceOnUse">
              <rect x="-20" y="-2" width="447" height="162" />
            </clipPath>
          </defs>
          <image href={href(whatWeDo.visual)} width="2000" height="2000" preserveAspectRatio="xMidYMid slice" />
          <g transform={`translate(${AT.x} ${AT.y}) scale(${SCALE})`}>
            <rect class="fwd__anchor" x="0" y="0" width="407" height="159" fill="none" data-fwd-anchor />
            <g clip-path="url(#fwd-clip)">
              {LETTERS.map((l, i) => (
                <g class={`fwd__l fwd__l--${l.key}`} style={`--i: ${i}`}>
                  <path d={l.d} fill="#820400" />
                  <path class="fwd__tint" d={l.d} fill="url(#fwd-tint)" />
                </g>
              ))}
            </g>
          </g>
        </svg>
      )
    }
  </div>
  <div class="wrap grid">
    <div class="split__copy">
      <h2 class="h-section section-title"><Sentences text={whatWeDo.title} /></h2>
      <ul class="blocks">
        {
          whatWeDo.blocks.map((b) => (
            <li class="block">
              <span class="block__title">{b.title}</span>
              <span class="small block__body">{b.body}</span>
            </li>
          ))
        }
      </ul>
      <p class="section-link">
        <ArrowLink href={href(whatWeDo.link.href)} label={whatWeDo.link.label} />
      </p>
    </div>
  </div>
</section>

<script>
  // Play the FWD once the letters are well in view (three quarters of the
  // way up the window); letters already that far up on load just show.
  // A plain scroll check on the letters' own box (owner, 2026-11-16: on a
  // phone nothing played; an IntersectionObserver on an element inside an
  // SVG is not reliable in every browser).
  const box = document.querySelector<HTMLElement>('[data-fwd]');
  const anchor = box?.querySelector<SVGRectElement>('[data-fwd-anchor]');
  if (box && anchor && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const due = () => anchor.getBoundingClientRect().top < innerHeight * 0.75;
    if (!due()) {
      box.classList.add('is-waiting');
      let frame = 0;
      const check = () => {
        frame = 0;
        if (!due()) return;
        box.classList.add('is-in');
        removeEventListener('scroll', onScroll);
        removeEventListener('resize', onScroll);
      };
      const onScroll = () => {
        if (!frame) frame = requestAnimationFrame(check);
      };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
    }
  }
</script>

<style>
  .split {
    position: relative;
  }
  /* Inside the section's border: from the hairline above to the next
     section's hairline below, and from the window's left edge to the
     middle. */
  .split__visual {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #b3daff; /* the artwork's own light blue, while it loads */
  }
  .fwd {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* FWD (owner, 2026-11-16): once the visual is in view, the letters come
     up from below, clipped at their own baseline, onto their place. F and
     W like the H2's first words (the snap: hidden, two steps low, one
     step, rest, in 80ms frames), 90ms apart; the D like the last word
     (hidden one frame, then rising smoothly over nine frames). Across the
     three a gradient #FF0000 → #820400 that slowly fades to the solid
     #820400. Without JavaScript or with reduced motion: simply there. */
  .fwd__l {
    --fwd-step: 22px; /* one step, in the letters' own units (159 high) */
  }
  .fwd__tint {
    opacity: 0;
  }
  [data-fwd].is-waiting .fwd__l {
    transform: translateY(170px);
  }
  [data-fwd].is-waiting .fwd__tint {
    opacity: 1;
  }
  [data-fwd].is-waiting.is-in .fwd__l {
    animation: fwd-snap calc(var(--reveal-frame) * 4) step-end both;
    animation-delay: calc(var(--i) * var(--reveal-stagger));
  }
  [data-fwd].is-waiting.is-in .fwd__l--d {
    animation: fwd-rise calc(var(--reveal-frame) * 9) cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * var(--reveal-stagger));
  }
  [data-fwd].is-waiting.is-in .fwd__tint {
    animation: fwd-tint calc(var(--reveal-frame) * 48) ease-in-out both;
    animation-delay: calc(var(--reveal-frame) * 12);
  }
  @keyframes fwd-snap {
    0%        { transform: translateY(170px); }
    25%       { transform: translateY(calc(2 * var(--fwd-step))); }
    50%       { transform: translateY(var(--fwd-step)); }
    75%, 100% { transform: translateY(0); }
  }
  @keyframes fwd-rise {
    0%      { transform: translateY(170px); }
    11.111% { transform: translateY(160px); }
    100%    { transform: translateY(0); }
  }
  @keyframes fwd-tint {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  /* Columns 8–12 (owner, 2026-11-16: it felt dense): column 7 stays empty
     as room next to the visual, and the lines stay short. */
  .split__copy {
    grid-column: 8 / span 5;
    align-self: center;
  }
  .section-title {
    margin-top: var(--gap-half);
  }
  /* The three blocks as a quiet list, like the Playbook's (without the
     numbers): the title on its own line in card-title type, the line under
     it small and muted, hairlines between them. */
  .blocks {
    margin: var(--gap-double) 0 0;
    padding: 0;
    list-style: none;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space);
    padding: var(--space-4x) 0;
  }
  /* Lines between the items only (owner, 2026-11-16: no top and bottom
     line); the first and last item sit flush with the list's edges. */
  .block + .block {
    border-top: var(--hairline-w) solid var(--hairline);
  }
  .block:first-child {
    padding-top: 0;
  }
  .block:last-child {
    padding-bottom: 0;
  }
  .block__title {
    font-size: var(--fs-card-title);
    font-weight: 500;
    letter-spacing: var(--ls-card-title);
    line-height: var(--lh-card-title);
  }
  .block__body {
    color: var(--muted);
    text-wrap: pretty;
  }
  .section-link {
    margin-top: var(--gap-double);
  }
  @media (max-width: 880px) {
    .split__visual {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      margin: calc(-1 * var(--section-pad)) 0 var(--section-pad);
    }
    .split__copy {
      grid-column: 1 / -1;
    }
  }
</style>
