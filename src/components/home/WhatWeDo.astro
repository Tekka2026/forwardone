---
/**
 * What we do (owner, 2026-11-16): the visual fills the left half of the
 * section edge to edge, from the browser's left edge to the middle and from
 * the separator line above to the one below; the copy sits in the right
 * half of the grid (columns 7–12): eyebrow, title, the three blocks one
 * under the other, and the link. At ≤880px the visual sits on top, full
 * width and square, touching the separator line, with the copy under it.
 */
import ArrowLink from '@components/ui/ArrowLink.astro';
import { whatWeDo } from '@content/home';
import { href, isPlaceholder } from '@lib/href';
import Sentences from '@components/ui/Sentences.astro';
import Placeholder from '@components/ui/Placeholder.astro';
---

<section class="section split">
  <div class="split__visual">
    {
      isPlaceholder(whatWeDo.visual) ? (
        <Placeholder value={whatWeDo.visual} />
      ) : (
        <img src={href(whatWeDo.visual)} alt={whatWeDo.visualAlt} loading="lazy" decoding="async" />
      )
    }
  </div>
  <div class="wrap grid">
    <div class="split__copy">
      <p class="eyebrow">{whatWeDo.eyebrow}</p>
      <h2 class="h-section section-title"><Sentences text={whatWeDo.title} /></h2>
      <div class="blocks">
        {
          whatWeDo.blocks.map((b) => (
            <p class="lede block">
              <strong class="block__title">{b.title}</strong> {b.body}
            </p>
          ))
        }
      </div>
      <p class="section-link">
        <ArrowLink href={href(whatWeDo.link.href)} label={whatWeDo.link.label} />
      </p>
    </div>
  </div>
</section>

<style>
  .split {
    position: relative;
  }
  /* Inside the section's border: from the hairline above to the next
     section's hairline below, and from the window's left edge to the
     middle. */
  .split__visual {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #b3daff; /* the artwork's own light blue, while it loads */
  }
  .split__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .split__copy {
    grid-column: 7 / span 6;
  }
  .section-title {
    margin-top: var(--gap-half);
  }
  .blocks {
    display: grid;
    gap: var(--space-4x);
    margin-top: var(--space-4x); /* heading → body: 16px */
  }
  .block {
    margin: 0;
  }
  .block__title {
    font-weight: 600;
  }
  .section-link {
    margin-top: var(--gap-double);
  }
  @media (max-width: 880px) {
    .split__visual {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      margin: calc(-1 * var(--section-pad)) 0 var(--section-pad);
    }
    .split__copy {
      grid-column: 1 / -1;
    }
  }
</style>
