---
/**
 * Proof: "From lab to exit." Built like the "Follow the battery." section on
 * vikka.io: a heading row (title left, intro right), then one large dark card
 * per company (10 columns wide) in a horizontal, snapping slider that runs to
 * both window edges, with a progress line and back/next buttons.
 *
 * Cards: date label (the exit date for exits), visual on the right (or a
 * background video filling the card), company
 * name, outcome line, optional facts along the bottom. The metric shows as a
 * large figure once it is filled in.
 */
import { caseStudies } from '@content/home';
import { href, isPlaceholder } from '@lib/href';
import Button from '@components/ui/Button.astro';
import Placeholder from '@components/ui/Placeholder.astro';
import Sentences from '@components/ui/Sentences.astro';

// Each card carries its group label ("Exit", "Traction") for the date line.
const slides = caseStudies.groups.flatMap((g) => g.items.map((c) => ({ ...c, stage: g.label })));
const total = slides.length;
// "April 11th, 2022" -> parts with the ordinal suffix marked, so it can stay
// lowercase inside the uppercase label.
const dateParts = (d: string) => d.split(/(?<=\d)(st|nd|rd|th)\b/);
---

<section class="section cases" aria-labelledby="cases-title">
  <div class="wrap">
    <div class="grid cases__head">
      <div class="col-6">
        <p class="eyebrow">{caseStudies.eyebrow}</p>
        <h2 class="h-section cases__title" id="cases-title"><Sentences text={caseStudies.title} /></h2>
      </div>
      <p class="col-5 start-8 body cases__intro">
        <Placeholder value={caseStudies.intro} />
      </p>
    </div>

    <div class="cases__slider" data-cases>
      <ul class="cases__track" data-cases-track tabindex="0" aria-label={`${caseStudies.title} ${total} companies`}>
        {
          slides.map((c, i) => (
            <li
              class:list={['case theme-dark', c.video && 'case--video']}
              data-cases-slide
              aria-label={`${i + 1} of ${total}: ${c.name}`}
            >
              {c.video && (
                <video
                  class="case__video"
                  data-cases-video
                  poster={href(c.video.poster)}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                  tabindex="-1"
                >
                  {c.video.webm && <source src={href(c.video.webm)} type="video/webm" />}
                  <source src={href(c.video.mp4)} type="video/mp4" />
                </video>
              )}
              <p class="label case__date">
                {isPlaceholder(c.date) ? (
                  <Placeholder value={c.date} />
                ) : (
                  <>
                    {c.stage}:{' '}
                    {dateParts(c.date).map((part, j) => (j % 2 ? <span class="case__ord">{part}</span> : part))}
                  </>
                )}
              </p>

              {!isPlaceholder(c.metric) && <p class="case__metric">{c.metric}</p>}

              {!c.video && (
                <div class="case__visual">
                  {isPlaceholder(c.visual) ? (
                    <Placeholder value={c.visual} />
                  ) : (
                    <img src={href(c.visual)} alt="" loading="lazy" />
                  )}
                </div>
              )}

              <div class="case__text">
                <h3 class="case__name">
                  <a class="case__link" href={href(`/portfolio/${c.slug}`)}>{c.name}</a>
                </h3>
                <p class="case__outcome">{c.outcome}</p>
                {c.facts.length > 0 && (
                  <ul class="case__facts">
                    {c.facts.map((f) => (
                      <li class="case__fact">
                        <Placeholder value={f} />
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <div class="cases__controls">
        <div class="cases__progress" aria-hidden="true">
          <span class="cases__progress-fill" data-cases-fill style={`transform: scaleX(${1 / total})`}></span>
        </div>
        <div class="cases__buttons">
          <button class="cases__btn" type="button" data-cases-prev aria-label="Previous company" disabled>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
          <button class="cases__btn" type="button" data-cases-next aria-label="Next company">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="section-cta">
      <Button href={caseStudies.cta.href} variant="ghost">{caseStudies.cta.label}</Button>
    </div>
  </div>
</section>

<style>
  .cases {
    --card-bg: #111111;
    --card-fg-soft: rgba(255, 255, 255, 0.78);
  }

  .cases__head {
    align-items: end;
  }
  .cases__title {
    margin: var(--gap-half) 0 0;
  }
  /* Same treatment as the What we do copy: body size, text colour. */
  .cases__intro {
    margin: 0;
  }

  /* ---- Slider ---- */
  /* The slider is the content width (a size container, so 100cqw is exactly
     the .wrap content). The track inside runs from window edge to window
     edge; the root clips horizontal overflow, so cards are cut by the
     browser on both sides, never at the canvas edge. */
  .cases__slider {
    container-type: inline-size;
    margin-top: var(--gap-double);
  }
  .cases__track {
    /* window edge to content edge */
    --edge: calc(50vw - 50cqw);
    /* card width in columns of the 12-column grid */
    --card-cols: 10;
    --card-w: calc((100cqw - 11 * var(--gutter)) / 12 * var(--card-cols) + (var(--card-cols) - 1) * var(--gutter));
    display: flex;
    gap: var(--gutter);
    width: 100vw;
    margin: 0 0 0 calc(-1 * var(--edge));
    /* first card starts at the content's left edge; the last card ends at
       its right edge (column 12) */
    padding: 0 var(--edge);
    scroll-padding-inline: var(--edge);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .cases__track::-webkit-scrollbar {
    display: none;
  }
  .cases__track:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  /* ---- Card ---- */
  .case {
    position: relative;
    flex: 0 0 var(--card-w);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    min-height: min(860px, 75svh);
    padding: var(--gap-double);
    background: var(--card-bg);
    scroll-snap-align: start;
  }
  .case:last-child {
    scroll-snap-align: end;
  }
  /* Background video: fills the card behind its content, under one flat
     overlay so white type stays legible. */
  .case--video {
    isolation: isolate;
    overflow: hidden;
  }
  .case__video {
    position: absolute;
    inset: 0;
    z-index: -2; /* under the darkening layer (::before, -1) */
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* One flat overlay over the video (no gradients); --video-overlay. */
  .case--video::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--video-overlay);
  }

  .case__ord {
    text-transform: none;
  }
  .case__date {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--brand-cyan);
    font-variant-numeric: tabular-nums;
  }
  .case__metric {
    position: absolute;
    top: var(--gap-double);
    right: var(--gap-double);
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-metric);
    line-height: var(--lh-metric);
    font-weight: var(--fw-heading);
    font-variant-numeric: tabular-nums;
  }
  .case__visual {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }
  .case__visual img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  /* Name, outcome and facts run across the whole card. */
  .case__text {
    grid-column: 1 / -1;
    grid-row: 3;
    align-self: end;
  }
  .case__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-feature);
    line-height: var(--lh-feature);
    letter-spacing: var(--ls-feature);
    font-weight: var(--fw-heading);
  }
  .case__link {
    text-decoration-line: none;
  }
  /* No underline on hover; keyboard focus shows an outline instead. */
  .case__link:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }
  .case__outcome {
    margin: var(--space-4x) 0 0;
    font-size: var(--fs-body-feature);
    line-height: var(--lh-body);
    color: var(--card-fg-soft);
  }
  .case__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2x) var(--gap);
    margin: var(--gap-double) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-mono);
    color: var(--card-fg-soft);
  }
  .case__fact::before {
    content: '\00b7\00a0';
    color: var(--brand-cyan);
  }

  /* ---- Controls ---- */
  /* Progress line across the content width, buttons at its right edge. */
  .cases__controls {
    display: flex;
    align-items: center;
    gap: var(--gap);
    margin-top: var(--gap);
  }
  .cases__progress {
    position: relative;
    flex: 1 1 auto;
    height: 1px;
    background: var(--hairline);
  }
  .cases__progress-fill {
    position: absolute;
    inset: -0.5px 0;
    background: var(--fg);
    transform-origin: left center;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cases__buttons {
    display: flex;
    gap: var(--space-2x);
  }
  .cases__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--form-height);
    height: var(--form-height);
    padding: 0;
    border: 1px solid var(--fg);
    border-radius: var(--btn-radius);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: background-color 120ms ease, opacity 120ms ease;
  }
  .cases__btn:hover {
    background: var(--btn-hover-shade);
  }
  .cases__btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .cases__btn:disabled {
    opacity: 0.3;
    cursor: default;
    background: transparent;
  }

  .section-cta {
    margin-top: var(--gap-double);
  }

  /* Single-column grid (≤880px): a card is the content width minus a peek. */
  @media (max-width: 880px) {
    .cases__track {
      --card-w: calc(100cqw - var(--gap-double));
    }
  }

  /* ---- Narrow screens: stacked card ---- */
  @media (max-width: 760px) {
    .case {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      min-height: 0;
      padding: var(--gap);
    }
    .case__metric {
      position: static;
      grid-row: 2;
      margin-top: var(--gap);
    }
    .case__visual {
      grid-column: 1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
      margin-block: var(--gap);
    }
    .case__text {
      grid-row: auto;
    }
    /* Video cards have no visual block: keep the text at the bottom. */
    .case--video {
      grid-template-rows: auto 1fr auto;
    }
    .case--video .case__text {
      grid-row: 3;
    }
    .cases__head .cases__intro {
      margin-top: var(--gap-half);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cases__progress-fill {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-cases]')) {
    const track = root.querySelector<HTMLElement>('[data-cases-track]')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-cases-slide]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-cases-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-cases-next]')!;
    const fill = root.querySelector<HTMLElement>('[data-cases-fill]')!;
    const total = slides.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;

    // Scroll position for each card: aligned left, except where the track
    // runs out (the last card ends at the content's right edge).
    const offset = (i: number) =>
      Math.min(slides[i].offsetLeft - slides[0].offsetLeft, track.scrollWidth - track.clientWidth);

    function update() {
      // The slide whose left edge is nearest the track's scroll position.
      let nearest = 0;
      for (let i = 1; i < total; i++) {
        if (Math.abs(offset(i) - track.scrollLeft) < Math.abs(offset(nearest) - track.scrollLeft)) nearest = i;
      }
      index = nearest;
      fill.style.transform = `scaleX(${(index + 1) / total})`;
      prev.disabled = index === 0;
      next.disabled = index === total - 1;
    }

    function go(i: number) {
      const target = Math.max(0, Math.min(total - 1, i));
      track.scrollTo({ left: offset(target), behavior: reduce.matches ? 'auto' : 'smooth' });
    }

    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));

    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (!frame) frame = requestAnimationFrame(() => ((frame = 0), update()));
      },
      { passive: true },
    );
    window.addEventListener('resize', () => go(index));
    update();

    // Background videos play only while their card is on screen, and never
    // under reduced motion (the poster frame stays).
    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-cases-video]'));
    if (videos.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting && !reduce.matches) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.25 },
      );
      for (const v of videos) io.observe(v);
      reduce.addEventListener('change', () => {
        if (reduce.matches) for (const v of videos) v.pause();
      });
    }
  }
</script>
