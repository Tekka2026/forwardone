---
import { caseStudies } from '@content/home';
import { href, isPlaceholder } from '@lib/href';
import Button from '@components/ui/Button.astro';
import Placeholder from '@components/ui/Placeholder.astro';
import Sentences from '@components/ui/Sentences.astro';
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">{caseStudies.eyebrow}</p>
    <h2 class="h-section section-title"><Sentences text={caseStudies.title} /></h2>
    {
      caseStudies.groups.map((g, gi) => (
        <div class="case-group">
          <h3 class="label case-group__label" id={`proof-group-${gi}`}>{g.label}</h3>
          <ul class="cards case-grid">
            {g.items.map((c) => (
              <li class="case">
                <div class="case__logo" aria-hidden={isPlaceholder(c.logo) ? undefined : 'true'}>
                  {isPlaceholder(c.logo) ? (
                    <Placeholder value={c.logo} />
                  ) : (
                    <img src={href(c.logo)} alt="" height="32" loading="lazy" />
                  )}
                </div>
                {!isPlaceholder(c.metric) && <p class="case__metric">{c.metric}</p>}
                <h4 class="card-title case__name">
                  <a class="case__link" href={href(`/portfolio/${c.slug}`)}>{c.name}</a>
                </h4>
                <p class="small case__outcome">{c.outcome}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="section-cta">
      <Button href={caseStudies.cta.href} variant="ghost">{caseStudies.cta.label}</Button>
    </div>
  </div>
</section>

<style>
  .section-title {
    margin-top: var(--gap-half);
  }
  .case-group {
    margin-top: var(--space-4x);   /* heading → content: 16px */
  }
  .case-group + .case-group {
    margin-top: var(--gap-double); /* between rows: 48 */
  }
  .case-group__label {
    margin: 0;
    color: var(--muted);
  }
  .case-grid {
    margin: var(--gap-half) 0 0;   /* row label → cards: 12 */
    padding: 0;
    list-style: none;
  }
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-half);
    padding: var(--gap);
    border: var(--hairline-w) solid var(--hairline);
  }
  .case__logo {
    display: flex;
    align-items: center;
    min-height: 32px;
    margin-bottom: var(--gap-half);
  }
  .case__name {
    margin: 0;
  }
  .case__link {
    text-decoration: none;
  }
  /* Whole card is the click target; the heading link carries the name. */
  .case__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .case:hover .case__link,
  .case:focus-within .case__link {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .case__outcome {
    margin: 0;
  }
  /* Headline outcome: the most prominent line on the card when filled. */
  .case__metric {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-metric);
    line-height: var(--lh-metric);
    font-weight: var(--fw-heading);
    font-variant-numeric: tabular-nums;
  }
  .section-cta {
    margin-top: var(--gap-double);
  }
</style>
