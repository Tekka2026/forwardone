---
import { fundIII } from '@content/home';
import Button from '@components/ui/Button.astro';
import Sentences from '@components/ui/Sentences.astro';
import PortalPreview from '@components/home/PortalPreview.astro';
---

<section class="section fund">
  <div class="wrap">
    <!-- Centred head: eyebrow, title, body, CTA. -->
    <div class="fund__head">
      <p class="eyebrow">{fundIII.eyebrow}</p>
      <h2 class="h-section section-title"><Sentences text={fundIII.title} /></h2>
      <p class="lede fund__body">{fundIII.body}</p>
      <div class="section-cta">
        <Button href={fundIII.cta.href}>{fundIII.cta.label}</Button>
      </div>
    </div>
    <!-- Investor portal preview: the middle 10 of 12 columns; at 880px and
         below the phone version, full width up to 390px. Cut off by the
         section's bottom edge. -->
    <div class="grid fund__portal">
      <PortalPreview class="col-10 start-2" />
    </div>
  </div>
</section>

<style>
  /* The preview runs into the section's bottom edge, so no bottom padding.
     Background: diagonal gradient, #FFEA6D in the bottom-left corner to 4%
     black over the page white in the top-right corner, spread evenly
     (owner, 2026-10-14). */
  .fund {
    padding-bottom: 0;
    /* The portal preview reaches 50px below the section and rises into view
       on scroll (PortalPreview.astro): clip it at the section's edge. */
    overflow: hidden;
    background-image: linear-gradient(to top right, #ffea6d, rgba(0, 0, 0, 0.04));
    /* Keep the gradient out from under the (translucent) top hairline, so
       the line shows the same grey as every other hairline. */
    background-clip: padding-box;
  }
  .fund__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .fund__body {
    text-wrap: balance;
  }
  .section-title {
    margin-top: var(--gap-half);
  }
  .fund__body {
    margin-top: var(--space-4x);
  }
  .section-cta {
    margin-top: var(--gap-double);
  }
  .fund__portal {
    margin-top: var(--gap-double);
  }
  @media (max-width: 880px) {
    .fund__portal > :global(*) {
      grid-column: 1 / -1;
    }
  }
</style>
