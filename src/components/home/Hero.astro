---
import { hero } from '@content/home';
import Button from '@components/ui/Button.astro';
import Footnote from '@components/ui/Footnote.astro';
import Sentences from '@components/ui/Sentences.astro';
---

<section class="section section--flush hero">
  <div class="wrap">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 class="h-display hero__title"><Sentences text={hero.title} reveal /></h1>
    <p class="lede hero__sub">
      {hero.sub.text}<Footnote n={hero.sub.footnote} />{' '}{hero.sub.after}
    </p>
    <div class="hero__actions">
      <Button href={hero.primary.href}>{hero.primary.label}</Button>
      <Button href={hero.secondary.href} variant="ghost">{hero.secondary.label}</Button>
    </div>
  </div>
</section>

<style>
  .hero__title {
    margin-top: var(--gap-half);
    max-width: var(--col-10);
  }
  .hero__sub {
    margin-top: var(--space-4x);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-half);
    margin-top: var(--gap-double);
  }
</style>
