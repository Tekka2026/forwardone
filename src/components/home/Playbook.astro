---
import { playbook } from '@content/home';
import Button from '@components/ui/Button.astro';
import Sentences from '@components/ui/Sentences.astro';
---

<section class="section section--feature">
  <div class="wrap">
    <p class="eyebrow">{playbook.eyebrow}</p>
    <div class="grid playbook">
      <div class="col-7">
        <h2 class="h-feature"><Sentences text={playbook.title} /></h2>
        <p class="body body--wide playbook__body">{playbook.body}</p>
        <div class="section-cta">
          <Button href={playbook.cta.href}>{playbook.cta.label}</Button>
        </div>
      </div>
      <ol class="col-4 start-9 playbook__list">
        {
          playbook.list.map((step) => (
            <li class="playbook__item">
              <div class="playbook__text">
                <span class="playbook__title">{step.title}</span>
                <span class="small playbook__line">{step.line}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .playbook {
    margin-top: var(--gap-half);
    align-items: start;
  }
  .playbook__body {
    margin-top: var(--space-4x);
  }
  .section-cta {
    margin-top: var(--gap-double);
  }
  /* The list stretches to the text column's height and shares any spare
     room between its items, so both columns end on the same line. */
  .playbook__list {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .playbook__item {
    display: flex;
    align-items: baseline;
    flex: 1 1 auto;
    gap: var(--space-4x);
    padding: var(--space-2x) 0;
    border-top: var(--hairline-w) solid var(--hairline);
    font-family: var(--font-sans);
    font-size: var(--fs-card-title);
    font-weight: 500;
    letter-spacing: var(--ls-card-title);
    line-height: var(--lh-card-title);
  }
  .playbook__text {
    display: flex;
    flex-direction: column;
    gap: var(--space);
  }
  /* Second line: small, muted, aligned with the title. */
  .playbook__line {
    font-family: var(--font-sans);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    text-wrap: pretty; /* no single-word last lines */
  }
  .playbook__item::before {
    counter-increment: step;
    content: '0' counter(step);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    color: var(--muted);
  }
  .playbook__item:last-child {
    border-bottom: var(--hairline-w) solid var(--hairline);
  }

  @media (max-width: 880px) {
    .playbook__list {
      margin-top: var(--gap-double);
    }
  }
</style>
