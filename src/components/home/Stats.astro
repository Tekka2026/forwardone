---
import { stats } from '@content/home';
import Footnote from '@components/ui/Footnote.astro';
---

<section class="section section--flush stats" aria-label="Key figures">
  <div class="wrap">
    <ul class="stats__list" style={`--stats: ${stats.length}`}>
      {
        stats.map((s, i) => (
          <li class="stat" style={`--n: ${i}`}>
            <p class="stat__value reveal-snap">{s.value}</p>
            <p class="stat__label small reveal-gentle">
              {s.label}
              {s.footnote && <Footnote n={s.footnote} />}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<script is:inline>
  // Figures come in when they scroll into view. Their reveal animations are
  // held (paused) from the start; once the strip is 30% visible they play,
  // keeping their one-by-one stagger. If that happens before the intro
  // sequence has reached them, they keep their place in it. Without
  // IntersectionObserver (or with reduced motion) nothing is held.
  (function () {
    var strip = document.currentScript.previousElementSibling;
    if (!('IntersectionObserver' in window)) return;
    strip.classList.add('is-waiting');
    var io = new IntersectionObserver(function (entries) {
      if (!entries.some(function (e) { return e.isIntersecting; })) return;
      io.disconnect();
      var first = strip.querySelector('.stat__value');
      var base = first ? parseFloat(getComputedStyle(first).animationDelay) * 1000 : 0;
      var elapsed = document.timeline ? document.timeline.currentTime : base;
      strip.querySelectorAll('.stat__value, .stat__label').forEach(function (el) {
        el.getAnimations().forEach(function (a) {
          a.currentTime = Math.min(elapsed, base);
          a.play();
        });
      });
      strip.classList.remove('is-waiting');
    }, { threshold: 0.3 });
    io.observe(strip);
  })();
</script>

<style>
  .stats {
    padding-block: var(--space-16x);
  }
  .stats__list {
    display: grid;
    /* A column is never narrower than its number, so numbers never wrap or
       overflow; the labels wrap instead. */
    grid-template-columns: repeat(var(--stats), minmax(min-content, 1fr));
    gap: var(--space-8x) var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Number first in the DOM (read first), and on top visually. */
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2x);
  }
  .stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-section);
    line-height: var(--lh-section);
    letter-spacing: var(--ls-section);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stat__label {
    margin: 0;
    color: var(--muted);
  }
  /* Held until the strip scrolls into view (see the script below). */
  .stats:global(.is-waiting) .stat__value,
  .stats:global(.is-waiting) .stat__label {
    animation-play-state: paused;
  }

  @media (max-width: 980px) {
    .stats__list {
      grid-template-columns: repeat(2, minmax(min-content, 1fr));
    }
  }
  @media (max-width: 640px) {
    .stats__list {
      grid-template-columns: repeat(2, minmax(min-content, 1fr));
    }
    .stat__value {
      font-size: var(--fs-metric);
      line-height: var(--lh-metric);
    }
  }
</style>
