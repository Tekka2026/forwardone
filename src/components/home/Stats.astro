---
import { stats } from '@content/home';
import Footnote from '@components/ui/Footnote.astro';
---

<section class="section stats" aria-label="Key figures">
  <div class="wrap">
    <dl class="stats__list">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="stat__label small">
              {s.label}
              {s.footnote && <Footnote n={s.footnote} />}
            </dt>
            <dd class="stat__value">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    padding-block: var(--space-10);
  }
  .stats__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-6) var(--gutter);
    margin: 0;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse; /* value visually above its label */
    justify-content: flex-end;      /* = top, in a reversed column */
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--hairline-w) solid var(--hairline);
  }
  .stat__value {
    margin: 0;
    font-size: var(--fs-section);
    line-height: var(--lh-section);
    letter-spacing: var(--ls-section);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .stats__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .stats__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
