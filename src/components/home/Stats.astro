---
import { stats } from '@content/home';
import Footnote from '@components/ui/Footnote.astro';
---

<section class="section section--flush stats" aria-label="Key figures">
  <div class="wrap">
    <ul class="stats__list">
      {
        stats.map((s) => (
          <li class="stat">
            <p class="stat__value">{s.value}</p>
            <p class="stat__label small">
              {s.label}
              {s.footnote && <Footnote n={s.footnote} />}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    padding-block: var(--space-16x);
  }
  .stats__list {
    display: grid;
    /* A column is never narrower than its number, so numbers never wrap or
       overflow; the labels wrap instead. */
    grid-template-columns: repeat(5, minmax(min-content, 1fr));
    gap: var(--space-8x) var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Number first in the DOM (read first), and on top visually. */
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2x);
  }
  .stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-section);
    line-height: var(--lh-section);
    letter-spacing: var(--ls-section);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stat__label {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .stats__list {
      grid-template-columns: repeat(3, minmax(min-content, 1fr));
    }
  }
  @media (max-width: 640px) {
    .stats__list {
      grid-template-columns: repeat(2, minmax(min-content, 1fr));
    }
    .stat__value {
      font-size: var(--fs-metric);
      line-height: var(--lh-metric);
    }
  }
</style>
