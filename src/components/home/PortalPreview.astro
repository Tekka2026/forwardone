---
/**
 * Investor portal preview: the dashboard drawn in HTML, in two versions.
 * Desktop (above 880px): a 1328 × 630 stage. Mobile (880px and below): a
 * 390 × 633 phone screen. Both are 75% of a full screen (the section's
 * bottom edge cuts them off), built from Geist-style parts (top bar, cards
 * with a shadow border, small pill button, badges, tooltip) in the site's
 * own type and colours. Copy lives in `portal` (src/content/home.ts).
 *
 * Each stage is designed at a fixed size and scaled to its frame's width
 * by the script below, like an image, so the layout never reflows. Without
 * JS it renders at full size, cropped. Each is an illustration: role="img"
 * with a label; the hidden version is display: none, so only one is read.
 */
import { portal } from '@content/home';
import Placeholder from '@components/ui/Placeholder.astro';
import AssetsChart from '@components/home/portal/AssetsChart.astro';
import { svg } from '@components/home/portal/icons';
import { href } from '@lib/href';
import wordmark from '../../assets/brand/forwardone.svg?raw';

// The site wordmark, sized by .pp-bar__logo; the figure's label names it.
const logoSvg = wordmark.replace('<svg ', '<svg aria-hidden="true" ');

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div class:list={['pp-wrap', cls]}>
<figure class="pp pp--desktop" role="img" aria-label={portal.label} data-portal data-pp-w="1328">
  <div class="pp__stage">
    <div class="pp__screen">
      <!-- Top bar: logo, tabs, icons -->
      <div class="pp-bar">
        <span class="pp-bar__logo" set:html={logoSvg} />
        <ul class="pp-bar__tabs">
          {
            portal.nav.map((n) => (
              <li class:list={['pp-bar__tab', n.active && 'is-active']}>
                {n.label}
                {n.menu && <Fragment set:html={svg('chevronDown', 14)} />}
              </li>
            ))
          }
        </ul>
        <div class="pp-bar__icons">
          <span class="pp-bar__mail">
            <Fragment set:html={svg('mail', 18)} />
            <span class="pp-badge pp-badge--alert">{portal.unread}</span>
          </span>
          <Fragment set:html={svg('settings', 18)} />
          <Fragment set:html={svg('logOut', 18)} />
        </div>
      </div>

      <div class="pp-body">
        <!-- Greeting row (left column width) -->
        <div class="pp-head">
          <div>
            <p
              class="pp-head__title"
              data-pp-greeting
              data-morning={portal.greeting.morning}
              data-afternoon={portal.greeting.afternoon}
              data-evening={portal.greeting.evening}
            >
              {portal.greeting.afternoon}
            </p>
            <p class="pp-head__date">
              {portal.valueDate.label} <span data-pp-date>{portal.valueDate.fallback}</span>
            </p>
          </div>
          <span class="btn btn--ghost btn--small pp-filter">
            {portal.filter}
            <Fragment set:html={svg('filter', 14)} />
          </span>
        </div>

        <div class="pp-main">
          <div class="pp-col">
          <!-- Total assets + assets by class -->
          <section class="pp-card pp-assets">
            <p class="pp-card__title">{portal.total.label}</p>
            <p class="pp-assets__total">{portal.total.value}</p>
            <AssetsChart />
          </section>

          </div>

          <div class="pp-col">
          <!-- Your team (collapsed) -->
          <section class="pp-card pp-team">
            <Fragment set:html={svg('handshake', 18)} />
            <span class="pp-card__title">{portal.team}</span>
            <Fragment set:html={svg('chevronDown', 16)} />
          </section>

          <!-- Article carousel -->
          <section class="pp-card pp-article">
            <p class="pp-card__title">{portal.article.title}</p>
            <p class="pp-article__body">{portal.article.body}</p>
            <p class="pp-link">
              {portal.article.link}
              <Fragment set:html={svg('arrowRight', 14)} />
            </p>
            <div class="pp-article__image">
              {
                portal.article.image.startsWith('[PLACEHOLDER') ? (
                  <Placeholder value={portal.article.image} />
                ) : (
                  <img src={href(portal.article.image)} alt="" loading="lazy" decoding="async" />
                )
              }
            </div>
            <div class="pp-article__controls">
              <Fragment set:html={svg('chevronLeft', 18)} />
              <Fragment set:html={svg('pause', 16)} />
              <Fragment set:html={svg('chevronRight', 18)} />
            </div>
          </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>

<!-- Mobile: the same dashboard as a phone screen. The article card falls
     below the cut here, so it is left out. -->
<figure class="pp pp--mobile" role="img" aria-label={portal.label} data-portal data-pp-w="390">
  <div class="pp__stage">
    <div class="pp__screen">
      <div class="pp-bar pp-bar--mobile">
        <Fragment set:html={svg('menu', 20)} />
        <span class="pp-bar__logo" set:html={logoSvg} />
        <Fragment set:html={svg('logOut', 18)} />
      </div>

      <div class="pp-body pp-body--mobile">
        <div class="pp-head pp-head--mobile">
          <p
            class="pp-head__title"
            data-pp-greeting
            data-morning={portal.greeting.morning}
            data-afternoon={portal.greeting.afternoon}
            data-evening={portal.greeting.evening}
          >
            {portal.greeting.afternoon}
          </p>
          <p class="pp-head__date">
            {portal.valueDate.label} <span data-pp-date>{portal.valueDate.fallback}</span>
          </p>
        </div>

        <div class="pp-col">
          <section class="pp-card pp-assets">
            <p class="pp-card__title">{portal.total.label}</p>
            <p class="pp-assets__total">{portal.total.value}</p>
            <AssetsChart stacked />
          </section>

          <section class="pp-card pp-team">
            <Fragment set:html={svg('handshake', 18)} />
            <span class="pp-card__title">{portal.team}</span>
            <Fragment set:html={svg('chevronDown', 16)} />
          </section>
        </div>
      </div>
    </div>
  </div>
</figure>
</div>

<script is:inline>
  (function () {
    var figs = document.querySelectorAll('[data-portal]');
    if (!figs.length) return;

    // Scale each fixed-size stage (data-pp-w: its design width) to the
    // figure's width.
    if ('ResizeObserver' in window) {
      var ro = new ResizeObserver(function (entries) {
        entries.forEach(function (e) {
          var w = Number(e.target.getAttribute('data-pp-w')) || 1328;
          if (e.contentRect.width) e.target.style.setProperty('--pp-scale', String(e.contentRect.width / w));
        });
      });
      figs.forEach(function (f) { ro.observe(f); });
    }

    // Greeting and value date follow the viewer's local time.
    var now = new Date();
    var h = now.getHours();
    var part = h >= 5 && h < 12 ? 'morning' : h >= 12 && h < 18 ? 'afternoon' : 'evening';
    var pad = function (n) { return String(n).padStart(2, '0'); };
    var date =
      now.toLocaleDateString('en-GB', { weekday: 'long' }) + ', ' +
      pad(now.getDate()) + '.' + pad(now.getMonth() + 1) + '.' + now.getFullYear() + ' ' +
      pad(h) + ':' + pad(now.getMinutes());

    figs.forEach(function (fig) {
      var g = fig.querySelector('[data-pp-greeting]');
      if (g && g.dataset[part]) g.textContent = g.dataset[part];
      var d = fig.querySelector('[data-pp-date]');
      if (d) d.textContent = date;
      var y = fig.querySelector('[data-pp-year]');
      if (y) y.textContent = String(now.getFullYear());

      // Chart: hovering a segment or legend row (mouse) or tapping it
      // (touch) shows that class's tooltip and fades the other segments;
      // leaving the chart (mouse) or tapping elsewhere in it clears it.
      var chart = fig.querySelector('[data-pp-chart]');
      if (!chart) return;
      var show = function (name) {
        chart.toggleAttribute('data-hover', !!name);
        chart.querySelectorAll('[data-pp-class]').forEach(function (el) {
          el.classList.toggle('is-hover', el.getAttribute('data-pp-class') === name);
        });
        chart.querySelectorAll('[data-pp-tip]').forEach(function (t) {
          t.classList.toggle('is-active', t.getAttribute('data-pp-tip') === name);
        });
      };
      var current = null;
      var pick = function (name) { current = name; show(name); };
      chart.querySelectorAll('[data-pp-class]').forEach(function (el) {
        el.addEventListener('pointerenter', function (e) {
          if (e.pointerType === 'mouse') pick(el.getAttribute('data-pp-class'));
        });
      });
      chart.addEventListener('pointerleave', function (e) {
        if (e.pointerType === 'mouse') pick(null);
      });
      chart.addEventListener('click', function (e) {
        var el = e.target.closest('[data-pp-class]');
        var name = el ? el.getAttribute('data-pp-class') : null;
        pick(name === current ? null : name);
      });
    });
  })();
</script>

<style>
  /* ---- Frame and scaling --------------------------------------------- */
  .pp {
    /* 75% of a full screen: the section edge cuts it off.
       Desktop 1328 × 630 (of 840); mobile 390 × 633 (of 844). */
    position: relative;
    aspect-ratio: 1328 / 630;
    margin: 0;
    overflow: hidden;
    /* Edge and corners on the unscaled frame, so they stay 1px / 4px at any
       width. Top corners rounded like the nav bar (--radius); the bottom is
       cut off, so square and without an edge. */
    border: 1px solid var(--pp-line);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    /* Chart tones: the site's ink, greys and brand colours. */
    --tone-cyan: var(--brand-cyan);
    --tone-ink: #111111;
    --tone-lilac: color-mix(in srgb, var(--brand-purple), #ffffff 55%);
    --tone-grey: #bdbdbd;
    /* Geist-style surfaces */
    --pp-canvas: #fafafa;
    --pp-card: #ffffff;
    --pp-ring: 0 0 0 1px rgba(0, 0, 0, 0.08), 0 2px 2px rgba(0, 0, 0, 0.04);
    --pp-line: rgba(0, 0, 0, 0.08);
  }
  .pp__stage {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1328px;
    height: 630px;
    transform: scale(var(--pp-scale, 1));
    transform-origin: 0 0;
  }
  /* Mobile: a phone-width screen, at most its design width, centred. */
  .pp--mobile {
    display: none;
    aspect-ratio: 390 / 633;
    max-width: 390px;
    margin-inline: auto;
  }
  .pp--mobile .pp__stage {
    width: 390px;
    height: 633px;
  }
  @media (max-width: 880px) {
    .pp--desktop {
      display: none;
    }
    .pp--mobile {
      display: block;
    }
  }
  /* No device bezel: the screen itself, square, edged by a 1px ring. */
  .pp__screen {
    height: 100%;
    overflow: hidden;
    background: var(--pp-canvas);
    color: #111111;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.45;
  }
  /* Zero-specificity resets so component classes can set margins. */
  :global(:where(.pp) p) {
    margin: 0;
  }
  :global(:where(.pp) ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pp :global(.pp-icon) {
    flex: none;
    display: block;
  }

  /* ---- Top bar ------------------------------------------------------- */
  /* White top bar (owner, 2026-10-14), a 1px line under it. */
  .pp-bar {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 60px;
    padding: 0 80px;
    background: #ffffff;
    color: #111111;
    box-shadow: inset 0 -1px 0 var(--pp-line);
  }
  .pp-bar__logo {
    display: flex;
  }
  .pp-bar__logo :global(svg) {
    display: block;
    height: 16px;
    width: auto;
  }
  .pp-bar__tabs {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }
  .pp-bar__tab {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
  }
  .pp-bar__tab.is-active {
    color: #111111;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  .pp-bar__icons {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }
  .pp-bar__mail {
    position: relative;
  }
  .pp-bar__mail .pp-badge {
    position: absolute;
    top: -9px;
    right: -11px;
  }

  /* ---- Badges (Geist badge: small pill) ------------------------------ */
  .pp-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    box-sizing: border-box;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .pp-badge--alert {
    background: var(--brand-cyan);
    color: #111111;
  }

  /* ---- Layout -------------------------------------------------------- */
  .pp-body {
    padding: 32px 80px 0;
  }
  /* Two columns: main 1fr, side 360px. The greeting row spans the main one.
     Columns stretch to the taller one, so the Total Assets card runs into
     the cut at the bottom like the cards on the right (no empty strip). */
  .pp-main {
    display: grid;
    grid-template-columns: 1fr 360px;
    column-gap: 32px;
    align-items: stretch;
  }
  .pp-col {
    display: grid;
    gap: 24px;
  }
  .pp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 calc(360px + 32px) 24px 0;
  }
  .pp-head__title {
    font-size: 24px;
    line-height: 1.3;
    font-weight: 450;
  }
  .pp-head__date {
    font-size: 12px;
    color: var(--muted);
  }
  .pp-head__date {
    margin-top: 4px;
  }

  /* ---- Cards (Geist shadow border, square per the site) -------------- */
  .pp-card {
    background: var(--pp-card);
    box-shadow: var(--pp-ring);
    padding: 20px 24px;
  }
  .pp-card__title {
    font-size: 14px;
    font-weight: 600;
  }
  .pp-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-purple);
    font-size: 14px;
  }

  /* Total assets + chart */
  .pp-assets__total {
    margin-top: 6px;
    font-size: 22px;
    font-weight: 450;
    font-variant-numeric: tabular-nums;
  }
  /* Your team */
  .pp-team {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pp-team :global(.pp-icon:last-child) {
    margin-left: auto;
  }

  /* Article */
  .pp-article__body {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .pp-article .pp-link {
    margin-top: 14px;
  }
  .pp-article__image {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    aspect-ratio: 2.6 / 1;
    background: #f2f2f2;
    overflow: hidden;
  }
  .pp-article__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pp-article__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    color: #111111;
  }

  /* ---- Mobile screen -------------------------------------------------- */
  .pp-bar--mobile {
    justify-content: space-between;
    gap: 0;
    height: 56px;
    padding: 0 20px;
  }
  .pp-bar--mobile .pp-bar__logo :global(svg) {
    height: 14px;
  }
  .pp-body--mobile {
    padding: 20px 16px 0;
  }
  .pp-head--mobile {
    display: block;
    margin: 0 0 16px;
  }
  .pp-head--mobile .pp-head__title {
    font-size: 20px;
  }
  .pp-head--mobile .pp-head__date {
    font-size: 11px;
  }
  .pp-body--mobile .pp-col {
    gap: 16px;
  }
  .pp-body--mobile .pp-card {
    padding: 16px;
  }
  .pp-body--mobile .pp-assets__total {
    font-size: 20px;
  }
</style>
