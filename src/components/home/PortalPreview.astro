---
/**
 * Investor portal preview: the dashboard drawn in HTML, in two versions.
 * Desktop (above 880px): a 1328 × 630 stage. Mobile (880px and below): a
 * 390 × 633 phone screen. Both are 75% of a full screen (the section's
 * bottom edge cuts them off), built from Geist-style parts (top bar, cards
 * with a shadow border, small pill button, badges) in the site's own type
 * and colours. Copy and the (illustrative) figures live in `portal`
 * (src/content/home.ts).
 *
 * Body (owner, 2026-10-19): the LP's investor-report overview. Desktop: one
 * card with a table, a row of column heads, then per fund a group row (name,
 * currency badge, link to the latest report) and its holding rows, and a
 * total row. The three valuation columns sit on a tinted band. Mobile: one
 * card per fund with the figures in two columns.
 *
 * Each stage is designed at a fixed size and scaled to its frame's width
 * by the script below, like an image, so the layout never reflows. Without
 * JS it renders at full size, cropped. Each is an illustration: role="img"
 * with a label; the hidden version is display: none, so only one is read.
 */
import { portal, type PortalFigures } from '@content/home';
import { svg } from '@components/home/portal/icons';
import wordmark from '../../assets/brand/forwardone.svg?raw';

// The site wordmark, sized by .pp-bar__logo; the figure's label names it.
const logoSvg = wordmark.replace('<svg ', '<svg aria-hidden="true" ');

const flow: (keyof PortalFigures)[] = ['commitment', 'paidIn', 'distributed', 'unfunded'];
const value: (keyof PortalFigures)[] = ['capitalAccount', 'tvpi', 'irr'];
// Mobile cards: the figures that matter most to an LP, in reading order.
const mobileKeys: (keyof PortalFigures)[] = ['commitment', 'paidIn', 'unfunded', 'capitalAccount', 'tvpi', 'irr'];
const report = (r: string) => `${portal.reportLink.before} ${r} ${portal.reportLink.after}`;

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<div class:list={['pp-wrap', cls]}>
<figure class="pp pp--desktop" role="img" aria-label={portal.label} data-portal data-pp-w="1328">
  <div class="pp__stage">
    <div class="pp__screen">
      <!-- Top bar: logo, tabs, icons -->
      <div class="pp-bar">
        <span class="pp-bar__logo" set:html={logoSvg} />
        <ul class="pp-bar__tabs">
          {
            portal.nav.map((n) => (
              <li class:list={['pp-bar__tab', n.active && 'is-active']}>
                {n.label}
                {n.menu && <Fragment set:html={svg('chevronDown', 14)} />}
              </li>
            ))
          }
        </ul>
        <div class="pp-bar__icons">
          <Fragment set:html={svg('fundrbird', 18)} />
          <span class="pp-bar__mail">
            <Fragment set:html={svg('mail', 18)} />
            <span class="pp-badge pp-badge--alert">{portal.unread}</span>
          </span>
          <Fragment set:html={svg('settings', 18)} />
          <Fragment set:html={svg('logOut', 18)} />
        </div>
      </div>

      <div class="pp-body">
        <!-- Greeting row (left column width) -->
        <div class="pp-head">
          <div>
            <p
              class="pp-head__title"
              data-pp-greeting
              data-morning={portal.greeting.morning}
              data-afternoon={portal.greeting.afternoon}
              data-evening={portal.greeting.evening}
            >
              {portal.greeting.afternoon}
            </p>
            <p class="pp-head__date">
              {portal.valueDate.label} <span data-pp-date>{portal.valueDate.fallback}</span>
            </p>
          </div>
          <span class="btn btn--ghost btn--small pp-filter">
            {portal.filter}
            <Fragment set:html={svg('filter', 14)} />
          </span>
        </div>

        <section class="pp-card pp-table">
          <div class="pp-row pp-row--head">
            <span />
            {flow.map((k) => <span class="pp-th">{portal.columns[k]}</span>)}
            {value.map((k) => <span class="pp-th pp-val">{portal.columns[k]}</span>)}
          </div>
          {
            portal.funds.map((fund) => (
              <>
                <div class="pp-row pp-row--fund">
                  <span class="pp-fund">
                    {fund.name}
                    <span class="pp-badge pp-badge--grey">{fund.currency}</span>
                  </span>
                  <span class="pp-val pp-report">
                    {fund.report && (
                      <span class="pp-link">
                        {report(fund.report)}
                        <Fragment set:html={svg('arrowUpRight', 13)} />
                      </span>
                    )}
                  </span>
                </div>
                {fund.holdings.map((h) => (
                  <div class:list={['pp-row', h.via && 'pp-row--via']}>
                    <span class="pp-name">
                      <span class="pp-name__text">{h.name}</span>
                      {h.via && <span class="pp-name__via">{h.via}</span>}
                    </span>
                    {flow.map((k) => <span class="pp-num">{h.figures[k]}</span>)}
                    {value.map((k) => <span class="pp-num pp-val">{h.figures[k]}</span>)}
                  </div>
                ))}
              </>
            ))
          }
          <div class="pp-row pp-row--total">
            <span class="pp-name">{portal.total.label}</span>
            {flow.map((k) => <span class="pp-num">{portal.total.figures[k]}</span>)}
            {value.map((k) => <span class="pp-num pp-val">{portal.total.figures[k]}</span>)}
          </div>
        </section>
      </div>
    </div>
  </div>
</figure>

<!-- Mobile: the same dashboard as a phone screen. The article card falls
     below the cut here, so it is left out. -->
<figure class="pp pp--mobile" role="img" aria-label={portal.label} data-portal data-pp-w="390">
  <div class="pp__stage">
    <div class="pp__screen">
      <div class="pp-bar pp-bar--mobile">
        <Fragment set:html={svg('menu', 20)} />
        <span class="pp-bar__logo" set:html={logoSvg} />
        <Fragment set:html={svg('logOut', 18)} />
      </div>

      <div class="pp-body pp-body--mobile">
        <div class="pp-head pp-head--mobile">
          <p
            class="pp-head__title"
            data-pp-greeting
            data-morning={portal.greeting.morning}
            data-afternoon={portal.greeting.afternoon}
            data-evening={portal.greeting.evening}
          >
            {portal.greeting.afternoon}
          </p>
          <p class="pp-head__date">
            {portal.valueDate.label} <span data-pp-date>{portal.valueDate.fallback}</span>
          </p>
        </div>

        <div class="pp-col">
          {
            portal.funds.map((fund) => {
              const h = fund.holdings.find((x) => !x.via) ?? fund.holdings[0];
              return (
                <section class="pp-card pp-mfund">
                  <p class="pp-fund">
                    {fund.name}
                    <span class="pp-badge pp-badge--grey">{fund.currency}</span>
                  </p>
                  <dl class="pp-mfund__grid">
                    {mobileKeys.map((k) => (
                      <div>
                        <dt class="pp-th">{portal.columns[k]}</dt>
                        <dd class="pp-num">{h.figures[k]}</dd>
                      </div>
                    ))}
                  </dl>
                  {fund.report && (
                    <p class="pp-link">
                      {report(fund.report)}
                      <Fragment set:html={svg('arrowUpRight', 13)} />
                    </p>
                  )}
                </section>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</figure>
</div>

<script is:inline>
  (function () {
    var figs = document.querySelectorAll('[data-portal]');
    if (!figs.length) return;

    // Scale each fixed-size stage (data-pp-w: its design width) to the
    // figure's width.
    if ('ResizeObserver' in window) {
      var ro = new ResizeObserver(function (entries) {
        entries.forEach(function (e) {
          var w = Number(e.target.getAttribute('data-pp-w')) || 1328;
          if (e.contentRect.width) e.target.style.setProperty('--pp-scale', String(e.contentRect.width / w));
        });
      });
      figs.forEach(function (f) { ro.observe(f); });
    }

    // Greeting and value date follow the viewer's local time.
    var now = new Date();
    var h = now.getHours();
    var part = h >= 5 && h < 12 ? 'morning' : h >= 12 && h < 18 ? 'afternoon' : 'evening';
    var pad = function (n) { return String(n).padStart(2, '0'); };
    var date =
      now.toLocaleDateString('en-GB', { weekday: 'long' }) + ', ' +
      pad(now.getDate()) + '.' + pad(now.getMonth() + 1) + '.' + now.getFullYear() + ' ' +
      pad(h) + ':' + pad(now.getMinutes());

    // Rise on scroll: --pp-rise goes 0 → 1, eased, over 1.5 window heights of
    // scrolling from when the preview's (untransformed) container enters at
    // the bottom of the window (twice the earlier 0.75, owner 2026-10-19, so
    // it comes in slower). Reduced motion: left at the CSS default (risen).
    var wrap = figs[0].closest('.pp-wrap');
    var host = wrap && wrap.parentElement;
    if (host && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var raf = 0;
      var rise = function () {
        raf = 0;
        var vh = window.innerHeight;
        var p = Math.min(1, Math.max(0, (vh - host.getBoundingClientRect().top) / (vh * 1.5)));
        wrap.style.setProperty('--pp-rise', (p * p * (3 - 2 * p)).toFixed(3));
      };
      var queue = function () { if (!raf) raf = requestAnimationFrame(rise); };
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
      rise();
    }

    figs.forEach(function (fig) {
      var g = fig.querySelector('[data-pp-greeting]');
      if (g && g.dataset[part]) g.textContent = g.dataset[part];
      var d = fig.querySelector('[data-pp-date]');
      if (d) d.textContent = date;
    });
  })();
</script>

<style>
  /* ---- Rise on scroll (owner, 2026-10-19) ---------------------------- */
  /* The frame is 50px taller than the visible cut and reaches 50px below the
     section, which clips it (FundIII.astro). As the section scrolls into
     view the whole preview rises by those 50px (--pp-rise 0 → 1, set by the
     script), so more of the dashboard slides out from under the edge where
     the Insights block starts. It starts 50px lower, so at rest it sits the
     usual 48px under the CTA. Without JS or under reduced motion: risen. */
  .pp-wrap {
    --pp-rise-px: 50px;
    margin-top: var(--pp-rise-px);
    margin-bottom: calc(-1 * var(--pp-rise-px));
    transform: translateY(calc(var(--pp-rise, 1) * -1 * var(--pp-rise-px)));
    will-change: transform;
  }

  /* ---- Frame and scaling --------------------------------------------- */
  .pp {
    /* 75% of a full screen: the section edge cuts it off.
       Desktop 1328 × 630 (of 840); mobile 390 × 633 (of 844). */
    position: relative;
    aspect-ratio: 1328 / 630;
    /* the aspect ratio sizes the content box; the 50px rise reserve is padding under it */
    box-sizing: content-box;
    padding-bottom: var(--pp-rise-px);
    margin: 0;
    overflow: hidden;
    /* Edge and corners on the unscaled frame, so they stay 1px / 4px at any
       width. Top corners rounded like the nav bar (--radius); the bottom is
       cut off, so square and without an edge. */
    border: 1px solid var(--pp-line);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    /* Geist-style surfaces */
    --pp-canvas: #fafafa;
    --pp-card: #ffffff;
    --pp-ring: 0 0 0 1px rgba(0, 0, 0, 0.08), 0 2px 2px rgba(0, 0, 0, 0.04);
    --pp-line: rgba(0, 0, 0, 0.08);
  }
  .pp__stage {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1328px;
    height: 840px; /* the full screen; the frame shows the top 630 plus the rise reserve */
    transform: scale(var(--pp-scale, 1));
    transform-origin: 0 0;
  }
  /* Mobile: a phone-width screen, at most its design width, centred. */
  .pp--mobile {
    display: none;
    aspect-ratio: 390 / 633;
    max-width: 390px;
    margin-inline: auto;
  }
  .pp--mobile .pp__stage {
    width: 390px;
    height: 844px;
  }
  @media (max-width: 880px) {
    .pp--desktop {
      display: none;
    }
    .pp--mobile {
      display: block;
    }
  }
  /* No device bezel: the screen itself, square, edged by a 1px ring. */
  .pp__screen {
    height: 100%;
    overflow: hidden;
    background: var(--pp-canvas);
    color: #111111;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.45;
  }
  /* Zero-specificity resets so component classes can set margins. */
  :global(:where(.pp) p) {
    margin: 0;
  }
  :global(:where(.pp) ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pp :global(.pp-icon) {
    flex: none;
    display: block;
  }

  /* ---- Top bar ------------------------------------------------------- */
  /* White top bar (owner, 2026-10-14), a 1px line under it. */
  .pp-bar {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 60px;
    padding: 0 80px;
    background: #ffffff;
    color: #111111;
    box-shadow: inset 0 -1px 0 var(--pp-line);
  }
  .pp-bar__logo {
    display: flex;
  }
  .pp-bar__logo :global(svg) {
    display: block;
    height: 16px;
    width: auto;
  }
  .pp-bar__tabs {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }
  .pp-bar__tab {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
  }
  .pp-bar__tab.is-active {
    color: #111111;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  .pp-bar__icons {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }
  .pp-bar__mail {
    position: relative;
  }
  .pp-bar__mail .pp-badge {
    position: absolute;
    top: -9px;
    right: -11px;
  }

  /* ---- Badges (Geist badge: small pill) ------------------------------ */
  .pp-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    box-sizing: border-box;
    border-radius: 999px;
    background: #111111;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .pp-badge--grey {
    height: 18px;
    padding: 0 6px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.06);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    /* line-height 1: with the screen's 1.45 the mono caps sat 2.5px high. */
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .pp-badge--alert {
    background: var(--brand-yellow);
    color: #111111;
  }

  /* ---- Layout -------------------------------------------------------- */
  .pp-body {
    padding: 32px 80px 0;
  }
  .pp-col {
    display: grid;
    gap: 24px;
  }
  .pp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 24px;
  }
  .pp-head__title {
    font-size: 24px;
    line-height: 1.3;
    font-weight: 450;
  }
  .pp-head__date {
    font-size: 12px;
    color: var(--muted);
  }
  .pp-head__date {
    margin-top: 4px;
  }

  /* ---- Cards (Geist shadow border, square per the site) -------------- */
  .pp-card {
    background: var(--pp-card);
    box-shadow: var(--pp-ring);
    padding: 20px 24px;
  }
  .pp-card__title {
    font-size: 14px;
    font-weight: 600;
  }
  .pp-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand-purple);
    font-size: 14px;
  }

  /* ---- Report table (desktop) ---------------------------------------- */
  /* One card, no inner padding; every row is the same 8-column grid. The
     three valuation columns (.pp-val) sit on a tinted band, edged on the
     left by a line, as in the owner's portal. */
  .pp-table {
    padding: 0;
    --pp-cols: minmax(0, 1fr) 120px 112px 112px 128px 156px 120px 112px;
    --pp-band: rgba(0, 0, 0, 0.0125); /* half the earlier 2.5% (owner, 2026-10-19) */
  }
  .pp-row {
    display: grid;
    grid-template-columns: var(--pp-cols);
    align-items: center;
    min-height: 34px;
    box-shadow: inset 0 -1px 0 var(--pp-line);
  }
  .pp-row > * {
    align-self: stretch;
    display: flex;
    align-items: center;
    padding: 0 16px;
    min-width: 0;
  }
  .pp-row > :first-child {
    padding-left: 24px;
  }
  .pp-row > :last-child {
    padding-right: 24px;
  }
  .pp-val {
    background: var(--pp-band);
  }
  .pp-row > .pp-val:nth-child(6) {
    box-shadow: inset 1px 0 0 var(--pp-line);
  }
  /* Column heads: the site's mono label style, two lines, right-aligned. */
  .pp-th {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pp-row--head {
    min-height: 56px;
  }
  .pp-row--head .pp-th {
    justify-content: flex-end;
    text-align: right;
  }
  /* Fund group row: name + currency badge; report link over the band. */
  .pp-row--fund {
    grid-template-columns: minmax(0, 1fr) calc(156px + 120px + 112px);
    min-height: 48px;
    margin-top: 0;
  }
  .pp-row--fund > .pp-val {
    box-shadow: inset 1px 0 0 var(--pp-line);
    justify-content: flex-end;
  }
  .pp-fund {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 450;
  }
  .pp-num {
    justify-content: flex-end;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pp-name {
    gap: 8px;
    font-size: 13px;
  }
  .pp-name__text,
  .pp-name__via {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Look-through row (held via another vehicle): indented under a corner
     mark, muted. */
  .pp-row--via {
    color: var(--muted);
  }
  .pp-row--via .pp-name {
    padding-left: 44px;
    position: relative;
    color: #111111;
  }
  .pp-row--via .pp-name::before {
    content: '';
    position: absolute;
    left: 28px;
    top: 9px;
    width: 8px;
    height: 7px;
    border-left: 1px solid var(--muted);
    border-bottom: 1px solid var(--muted);
  }
  .pp-name__via {
    flex: 0 1 auto;
    font-size: 11px;
    color: var(--brand-purple);
  }
  .pp-row--total {
    min-height: 40px;
    font-weight: 600;
    background: var(--pp-canvas);
    box-shadow: inset 0 1px 0 var(--pp-line);
  }
  .pp-row--total .pp-name,
  .pp-row--total .pp-num {
    font-weight: 600;
  }
  .pp-report .pp-link,
  .pp-mfund .pp-link {
    gap: 4px;
    font-size: 12.5px;
  }

  /* ---- Mobile screen -------------------------------------------------- */
  .pp-bar--mobile {
    justify-content: space-between;
    gap: 0;
    height: 56px;
    padding: 0 20px;
  }
  .pp-bar--mobile .pp-bar__logo :global(svg) {
    height: 14px;
  }
  .pp-body--mobile {
    padding: 20px 16px 0;
  }
  .pp-head--mobile {
    display: block;
    margin: 0 0 16px;
  }
  .pp-head--mobile .pp-head__title {
    font-size: 20px;
  }
  .pp-head--mobile .pp-head__date {
    font-size: 11px;
  }
  .pp-body--mobile .pp-col {
    gap: 16px;
  }
  .pp-body--mobile .pp-card {
    padding: 16px;
  }
  .pp-mfund .pp-fund {
    font-size: 14px;
    justify-content: space-between;
  }
  .pp-mfund__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 16px;
    margin: 14px 0 0;
  }
  .pp-mfund__grid dd {
    margin: 4px 0 0;
    justify-content: flex-start;
    display: block;
  }
  .pp-mfund .pp-link {
    margin-top: 14px;
  }
  .pp-body--mobile .pp-assets__total {
    font-size: 20px;
  }
</style>
