---
import { trackRecord } from '@content/home';
import { href } from '@lib/href';
import Placeholder from '@components/ui/Placeholder.astro';

const { columns: col } = trackRecord;
const keys = ['size', 'companies', 'status'] as const;
---

<section class="section section--tint">
  <div class="wrap">
    <div class="track__head">
      <p class="eyebrow">{trackRecord.eyebrow}</p>
      <p class="track__figure" data-track-figure>
        <span class="track__unit">{trackRecord.figure.prefix}</span><span class="track__value">{trackRecord.figure.value}</span><span class="track__unit">{trackRecord.figure.suffix}</span>
      </p>
      <!-- One line here (exception to the break-after-each-sentence rule). -->
      <h2 class="h-section track__title">{trackRecord.title}</h2>
      <p class="lede track__body">{trackRecord.body}</p>
    </div>

    <!-- A real table; below 760px each row restacks into a card (no scroll). -->
    <table class="funds">
      <caption class="visually-hidden">{trackRecord.caption}</caption>
      <thead>
        <tr>
          <th scope="col">{col.fund}</th>
          {keys.map((k) => <th scope="col">{col[k]}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          trackRecord.funds.map((f) => (
            <tr>
              <th scope="row" class="funds__name">{f.fund}</th>
              {keys.map((k) => (
                <td data-label={col[k]}>
                  <Placeholder value={f[k]} />
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>

    <!-- One row under the table: exits left, link right (stacks when narrow). -->
    <div class="funds__foot">
      <p class="small funds__exits">
        <strong>{trackRecord.exits.label}</strong> {trackRecord.exits.items.join(', ')}.
      </p>
      <p class="funds__link">
        <a class="arrow-link" href={href(trackRecord.link.href)}>{trackRecord.link.label}</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Centred head: eyebrow, headline figure, title. */
  .track__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* Same rhythm as the hero: eyebrow → figure 12px, figure → title 16px,
     figure line height as the H1. */
  /* Glow: the figure is painted by a black → --figure-glow (#820400, owner
     2026-10-17) gradient. As it scrolls up into view, the script moves
     --figure-sweep from 0% to 100%, pushing the red out to the right until the number is solid black.
     Rests at 100% (solid) without JS or under reduced motion. The padding /
     negative margin pair lets the painted box cover the large glyphs. */
  .track__figure {
    --figure-sweep: 100%;
    --figure-glow: #820400;
    --figure-bleed: calc(var(--fs-display) * 0.3);
    background: linear-gradient(
      90deg,
      var(--fg) var(--figure-sweep),
      var(--figure-glow) calc(var(--figure-sweep) + 100%)
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    padding-block: var(--figure-bleed);
    margin: calc(var(--gap-half) - var(--figure-bleed)) 0 calc(-1 * var(--figure-bleed));
    font-family: var(--font-display);
    font-weight: var(--fw-figure);
    line-height: var(--lh-display);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* € and M at H1 size, the number at twice that, on one baseline. */
  .track__unit {
    font-size: var(--fs-display);
  }
  /* At twice the H1 size, an H1 line height would double the room above and
     below the digits. This line height leaves the same absolute room as the
     H1 does: (H1 line height + cap height ~0.7) / 2. */
  .track__value {
    font-size: calc(var(--fs-display) * 2);
    line-height: calc((var(--lh-display) + 0.7) / 2);
  }
  /* Tracking set per span so the em follows each span's own size. */
  .track__unit,
  .track__value {
    letter-spacing: var(--ls-figure);
  }
  .track__title {
    margin: var(--space-4x) auto 0;
  }
  /* Heading → body: 16px, centred, body measure. */
  .track__body {
    margin: var(--space-4x) auto 0;
    text-wrap: balance;
  }
  .funds {
    width: 100%;
    margin-top: var(--space-4x);   /* heading block → content: 16px */
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .funds th,
  .funds td {
    padding: var(--space-4x) var(--gutter) var(--space-4x) 0;
    border-top: var(--hairline-w) solid var(--hairline);
    text-align: left;
    vertical-align: baseline;
  }
  .funds tbody tr:last-child > * {
    border-bottom: var(--hairline-w) solid var(--hairline);
  }
  .funds thead th {
    border-top: 0; /* no rule above the column labels */
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-mono);
    letter-spacing: var(--ls-label);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--muted);
  }
  .funds tbody th,
  .funds td {
    font-size: var(--fs-card-title);
    line-height: var(--lh-card-title);
  }
  .funds__name {
    font-weight: var(--fw-card-title);
  }
  .funds td {
    font-weight: 400;
  }
  .funds__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-half) var(--gap);
    margin-top: var(--gap); /* annotation directly under the table: 24px */
  }
  .funds__link,
  .funds__exits {
    margin: 0;
  }
  .funds__link {
    text-align: right;
  }
  @media (max-width: 760px) {
    .funds__foot {
      flex-direction: column;
    }
    .funds__link {
      text-align: left;
    }
  }

  /* Mobile: each fund becomes a stacked block with its own labels, between hairlines. */
  @media (max-width: 760px) {
    .funds,
    .funds tbody,
    .funds tr,
    .funds th,
    .funds td {
      display: block;
    }
    .funds thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    /* No boxes: each fund sits between hairlines, like the desktop rows. */
    .funds tbody tr {
      padding: var(--space-4x) 0;
      border-top: var(--hairline-w) solid var(--hairline);
    }
    .funds tbody tr:last-child {
      border-bottom: var(--hairline-w) solid var(--hairline);
    }
    .funds tbody th,
    .funds td {
      padding: 0;
      border: 0;
    }
    .funds tbody tr:last-child > * {
      border: 0;
    }
    .funds tbody th {
      margin-bottom: var(--gap-half);
    }
    /* Label and value share a baseline, so the smaller mono label lines up
       with the value text (and with its first line when it wraps). */
    .funds tbody td[data-label] {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: baseline;
      gap: var(--gap-half);
      padding-block: var(--space-2x);
      font-size: var(--fs-small);
      line-height: var(--lh-small);
    }
    .funds td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      line-height: var(--lh-small);
      letter-spacing: var(--ls-label);
      font-weight: 500;
      text-transform: uppercase;
      color: var(--muted);
    }
  }
</style>

<script>
  // Glow on the headline figure (black → red, the red pushed out to the
  // right as --figure-sweep goes 0% → 100%).
  // - Mouse (hover-capable, fine pointer): the cursor drives it. Far from the
  //   number the full gradient shows; within REACH px it fades out as the
  //   cursor approaches; on the number it is solid black. Eased.
  // - Touch (no cursor): scroll-linked (owner, 2026-10-14): full gradient
  //   as the figure enters at the bottom, the red slides out to the right
  //   as it rises, solid black only once its top reaches the top of the
  //   window (over the whole height, not half, so it lasts longer).
  // - Reduced motion: solid (CSS default).
  const figure = document.querySelector<HTMLElement>('[data-track-figure]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mouse = window.matchMedia('(hover: hover) and (pointer: fine)');
  if (figure && !reduce.matches) {
    const REACH = 480;
    const set = (v: number) => figure.style.setProperty('--figure-sweep', `${(v * 100).toFixed(1)}%`);
    if (mouse.matches) {
      let current = 0;
      let target = 0;
      let frame = 0;
      const step = () => {
        current += (target - current) * 0.12;
        if (Math.abs(target - current) < 0.002) current = target;
        set(current);
        frame = current === target ? 0 : requestAnimationFrame(step);
      };
      const aim = (v: number) => {
        target = v;
        if (!frame) frame = requestAnimationFrame(step);
      };
      set(0);
      window.addEventListener(
        'pointermove',
        (e) => {
          const r = figure.getBoundingClientRect();
          const dx = Math.max(r.left - e.clientX, 0, e.clientX - r.right);
          const dy = Math.max(r.top - e.clientY, 0, e.clientY - r.bottom);
          aim(1 - Math.min(1, Math.hypot(dx, dy) / REACH));
        },
        { passive: true },
      );
      document.documentElement.addEventListener('pointerleave', () => aim(0));
    } else {
      let frame = 0;
      const update = () => {
        frame = 0;
        const top = figure.getBoundingClientRect().top;
        const vh = window.innerHeight;
        set(Math.min(1, Math.max(0, (vh - top) / vh)));
      };
      const queue = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      update();
      window.addEventListener('scroll', queue, { passive: true });
      window.addEventListener('resize', queue);
    }
  }
</script>
