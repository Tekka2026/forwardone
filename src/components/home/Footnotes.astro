---
import { footnotes, disclaimer } from '@content/home';
import Placeholder from '@components/ui/Placeholder.astro';
---

<section class="footnotes" aria-label="Footnotes">
  <div class="wrap">
    <ol class="footnotes__list small">
      {
        footnotes.map((note, i) => (
          <li id={`fn-${i + 1}`} class="footnotes__item">
            <Placeholder value={note} />
            <a class="footnotes__back" href={`#fnref-${i + 1}`} aria-label={`Back to reference ${i + 1}`}>&#8617;</a>
          </li>
        ))
      }
    </ol>
    <p class="footnotes__disclaimer small-tight">
      <Placeholder value={disclaimer} />
    </p>
  </div>
</section>

<style>
  .footnotes {
    padding-block: var(--space-8);
    border-top: var(--hairline-w) solid var(--hairline);
    color: var(--muted);
  }
  .footnotes__list {
    margin: 0;
    padding-left: 1.5em;
    max-width: var(--col-6);
  }
  .footnotes__item::marker {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
  }
  .footnotes__back {
    margin-left: var(--space-2);
    text-decoration: none;
  }
  .footnotes__disclaimer {
    margin-top: var(--space-5);
    max-width: var(--col-6);
    font-size: var(--fs-small-tight);
    line-height: var(--lh-small);
  }
</style>
