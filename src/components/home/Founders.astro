---
/**
 * Founders strip (owner, 2026-10-19), between the intro and the track
 * record: a big horizontal scroll of 5:7 cards, three grid columns wide.
 *
 * A plain horizontal scroller (owner, 2026-10-19: the page's own scrolling is
 * never taken over): swipe, trackpad or shift + wheel, with snap points; no
 * arrows or progress line (owner, 2026-10-19). Cards dock: card 1 is in
 * place, the rest slide in from the right and settle into their slots as
 * they come into view; sideways scrolling unlocks once the first ones have
 * docked.
 *
 * Card types: founder (photo, name, "CEO, company"), company (brand colour,
 * name, one line), and a TikTok-style clip of a FORWARD.one team member with
 * a progress bar, handle, caption, sound line and a Like / Share rail. Like
 * toggles (heart fills and pops); Share opens LinkedIn's share dialog in a
 * new tab, to post the site on the visitor's own feed. Clips play muted when in view. Copy in `founders` (home.ts).
 */
import { founders, caseStudies, trackRecord } from '@content/home';
import Placeholder from '@components/ui/Placeholder.astro';
import Sentences from '@components/ui/Sentences.astro';
import { href, isPlaceholder } from '@lib/href';

// Rule (owner, 2026-10-19): the founders strip never shows a Proof company
// or an exit. Fail the build if one slips in, rather than publish it.
// Exits are listed as "Name (Buyer)": compare the name only.
const norm = (s: string) => s.replace(/\(.*?\)/g, '').trim().toLowerCase();
const taken = new Set([
  ...caseStudies.groups.flatMap((g) => g.items.map((c) => norm(c.name))),
  ...trackRecord.exits.items.map(norm),
]);
const clash = founders.people.map((p) => p.company).filter((c) => !isPlaceholder(c) && taken.has(norm(c)));
if (clash.length) {
  throw new Error(`Founders strip: ${[...new Set(clash)].join(', ')} is a Proof company or an exit (caseStudies / trackRecord.exits). The founders strip may show neither.`);
}

type Card =
  | { type: 'founder' | 'company'; i: number }
  | { type: 'clip'; i: number };
// The sequence: founder entries in order, a clip after every `clipEvery`.
const cards: Card[] = [];
let clip = 0;
founders.people.forEach((p, i) => {
  cards.push({ type: p.card, i });
  if ((i + 1) % founders.clipEvery === 0 && clip < founders.clips.length) cards.push({ type: 'clip', i: clip++ });
});

// Company card colours: the brand colour, else a site tone; text dark or
// light by the background's luminance.
let toneAt = 0;
const companyStyle = (colour: string) => {
  const bg = colour || founders.tones[toneAt++ % founders.tones.length];
  const n = parseInt(bg.slice(1), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => {
    const c = v / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  const light = 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.35;
  return `--fc-bg: ${bg}; --fc-fg: ${light ? '#111111' : '#ffffff'};`;
};
const isPh = (v: string) => isPlaceholder(v);
// "Discover more about <company> →", word by word for the H1-style reveal;
// the arrow travels with the last word.
const moreWords = (company: string) => {
  const w = `${founders.discover} ${company}`.split(/\s+/);
  w[w.length - 1] += '\u00a0\u2192';
  return w;
};
// Share (owner, 2026-10-19): straight to LinkedIn's share dialog, to post the
// site on the visitor's own feed.
const pageUrl = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site).href;
const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
---

<section class="section founders" data-founders aria-labelledby="founders-title">
  <div class="wrap">
        <div class="grid founders__head">
          <div class="col-6">
            <p class="eyebrow">{founders.eyebrow}</p>
            <h2 class="h-section founders__title" id="founders-title"><Sentences text={founders.title} /></h2>
          </div>
          <p class="col-4 start-9 body founders__intro">{founders.intro}</p>
        </div>
        <div class="founders__rail">
          <ul class="founders__track" data-founders-track>
            {
              cards.map((c) => {
                if (c.type === 'clip') {
                  const v = founders.clips[c.i];
                  return (
                    <li class="fc fc--clip" data-fc>
                      {isPh(v.video) ? (
                        <div class="fc__clip-empty">
                          <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
                          <Placeholder value={v.video} />
                        </div>
                      ) : (
                        <video class="fc__video" poster={v.poster ? href(v.poster) : undefined} muted loop playsinline preload="metadata" data-fc-video>
                          {v.webm && <source src={href(v.webm)} type="video/webm" />}
                          <source src={href(v.video)} type="video/mp4" />
                        </video>
                      )}
                      <span class="fc__progress" aria-hidden="true"><span data-fc-progress /></span>
                      <div class="fc__rail">
                        {v.profile ? (
                          <a class="fc__avatar" href={href(`/about/team/${v.profile}`)} aria-label={founders.clip.profile}>
                            {v.avatar ? <img src={href(v.avatar)} alt="" width="28" height="28" loading="lazy" decoding="async" /> : 'F.'}
                            <span class="fc__follow" aria-hidden="true">+</span>
                          </a>
                        ) : (
                          <span class="fc__avatar" aria-hidden="true">
                            {v.avatar ? <img src={href(v.avatar)} alt="" width="28" height="28" loading="lazy" decoding="async" /> : 'F.'}
                            <span class="fc__follow">+</span>
                          </span>
                        )}
                        <button type="button" class="fc__action fc__like" aria-pressed="false" data-fc-like data-like={founders.clip.like} data-liked={founders.clip.liked}>
                          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.2-9.3C1.6 7.8 3.8 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.4 0 5.6 3.3 4.4 6.7-1.7 4.7-9.2 9.3-9.2 9.3Z" /></svg>
                          <span data-fc-like-label>{founders.clip.like}</span>
                        </button>
                        <a class="fc__action fc__share" href={shareUrl} target="_blank" rel="noopener" aria-label={founders.clip.shareLabel}>
                          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M13.5 4.5 21 11.5l-7.5 7v-4.2c-5 0-8.3 1.6-10.5 5.2.8-5.6 3.8-10 10.5-10.7V4.5Z" /></svg>
                          <span>{founders.clip.share}</span>
                        </a>
                      </div>
                      <div class="fc__caption">
                        <p class="fc__handle"><Placeholder value={founders.clip.handle} /></p>
                        <p class="fc__person"><Placeholder value={v.person} /></p>
                        <p class="fc__text"><Placeholder value={v.caption} /></p>
                        <p class="fc__sound">
                          <svg viewBox="0 0 24 24" width="9" height="9" aria-hidden="true"><path d="M9 18V5l11-2v13" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="6" cy="18" r="3" fill="currentColor" /><circle cx="17" cy="16" r="3" fill="currentColor" /></svg>
                          <span>{founders.clip.sound}</span>
                        </p>
                      </div>
                    </li>
                  );
                }
                const p = founders.people[c.i];
                if (c.type === 'company') {
                  return (
                    <li class="fc fc--company" style={companyStyle(p.colour)} data-fc>
                      <p class="fc__company"><Placeholder value={p.company} /></p>
                      <p class="fc__blurb"><Placeholder value={p.blurb} /></p>
                      {!isPh(p.company) && (
                        <a class="fc__more" href={p.href || founders.portfolioHref}>
                          {moreWords(p.company).map((w, i, all) => (
                            <>
                              <span class:list={['fc__w', i === all.length - 1 && 'fc__w--last']} style={`--i: ${i}`}>{w}</span>
                              {i < all.length - 1 && ' '}
                            </>
                          ))}
                        </a>
                      )}
                    </li>
                  );
                }
                return (
                  <li class:list={['fc fc--founder', !isPh(p.photo) && 'has-photo']} data-fc>
                    {isPh(p.photo) ? (
                      <div class="fc__photo-empty"><Placeholder value={p.photo} /></div>
                    ) : (
                      <img class="fc__photo" src={href(p.photo)} alt="" loading="lazy" decoding="async" />
                    )}
                    <div class="fc__who">
                      <p class="card-title fc__name"><Placeholder value={p.name} /></p>
                      <p class="fc__role">
                        {p.role ?? founders.role}, <Placeholder value={p.company} />
                      </p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
</section>

<script is:inline>
  (function () {
    var sec = document.querySelector('[data-founders]');
    if (!sec) return;
    var track = sec.querySelector('[data-founders-track]');
    var cards = [].slice.call(track.querySelectorAll('[data-fc]'));
    var reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // ---- Docking (owner, 2026-10-19) -------------------------------------
    // Card 1 is in place from the start. When the section comes into view,
    // the other cards in view slide in from the right one after another and
    // settle into their slots (a long ease-out); sideways scrolling unlocks
    // once they have docked. After that, each card docks the same way the
    // first time it scrolls into view. Visibility is worked out from the
    // cards' slots (offsetLeft), not their moving boxes.
    if ('IntersectionObserver' in window && !reduce.matches) {
      var DOCK_MS = 2800, STAGGER = 320; // twice the first timing (owner, 2026-10-19)
      // Scrolling unlocks once the last card has mostly arrived (owner,
      // 2026-10-19): this ease-out has covered 90% of the slide a third of
      // the way into it; the rest of the settle carries on while you scroll.
      var ARRIVED = 0.33;
      var waiting = cards.slice(1);
      waiting.forEach(function (c) { c.classList.add('is-waiting'); });
      track.classList.add('is-docking');
      var started = false;
      var inView = function (c) {
        var w = c.offsetWidth, l = c.offsetLeft;
        return l < track.scrollLeft + track.clientWidth - w * 0.2 && l + w > track.scrollLeft;
      };
      var dock = function () {
        var batch = waiting.filter(inView);
        waiting = waiting.filter(function (c) { return batch.indexOf(c) < 0; });
        batch.forEach(function (c, k) {
          c.style.transitionDelay = k * STAGGER + 'ms';
          c.classList.remove('is-waiting');
        });
        return batch.length ? (batch.length - 1) * STAGGER + DOCK_MS * ARRIVED : 0;
      };
      new IntersectionObserver(function (entries, obs) {
        if (started || !entries.some(function (e) { return e.isIntersecting; })) return;
        started = true;
        obs.disconnect();
        setTimeout(function () { track.classList.remove('is-docking'); }, dock());
      }, { threshold: 0.35 }).observe(track);
      var raf = 0;
      var later = function () { raf = 0; if (started && waiting.length) dock(); };
      track.addEventListener('scroll', function () { if (!raf) raf = requestAnimationFrame(later); }, { passive: true });
      window.addEventListener('resize', later);
    }

    // ---- Clips: play muted while in view; progress bar follows the video --
    var videos = [].slice.call(track.querySelectorAll('[data-fc-video]'));
    if (videos.length && 'IntersectionObserver' in window) {
      var vio = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          var v = e.target;
          if (e.isIntersecting && !reduce.matches) v.play().catch(function () {});
          else v.pause();
        });
      }, { threshold: 0.5 });
      videos.forEach(function (v, i) {
        vio.observe(v);
        // each clip starts at a different moment, so shared footage never plays in step
        v.addEventListener('loadedmetadata', function () {
          if (v.duration) v.currentTime = (i * 1.7) % v.duration;
        }, { once: true });
        var bar = v.parentNode.querySelector('[data-fc-progress]');
        v.addEventListener('timeupdate', function () {
          if (v.duration) bar.style.transform = 'scaleX(' + (v.currentTime / v.duration).toFixed(3) + ')';
        });
      });
    }

    // ---- Like and Share ---------------------------------------------------
    track.addEventListener('click', function (e) {
      var like = e.target.closest('[data-fc-like]');
      if (like) {
        var on = like.getAttribute('aria-pressed') !== 'true';
        like.setAttribute('aria-pressed', String(on));
        like.querySelector('[data-fc-like-label]').textContent = on ? like.dataset.liked : like.dataset.like;
        return;
      }
    });
  })();
</script>

<style>
  /* ---- Section, pin and track ----------------------------------------- */
  /* Head as in the Proof slider: eyebrow and title left, a line of body copy
     right, bottoms aligned; stacked at 880px and below. */
  .founders__head {
    align-items: end;
  }
  .founders__title {
    margin: var(--gap-half) 0 0;
  }
  .founders__intro {
    margin: 0;
  }
  @media (max-width: 880px) {
    .founders__head {
      row-gap: 0;
    }
    .founders__intro {
      margin-top: var(--space-4x);
    }
  }
  /* The rail is the content width (a size container, so 100cqw is exactly
     the .wrap content); the track runs from window edge to window edge, the
     first card starting at the content's left edge, as in the Proof slider. */
  .founders__rail {
    container-type: inline-size;
    margin-top: var(--space-4x); /* heading → content: 16px */
  }
  .founders__track {
    /* window edge to content edge */
    --edge: calc(50vw - 50cqw);
    /* 5:7 cards, three of the twelve columns wide */
    --card-w: calc((100cqw - 11 * var(--gutter)) / 12 * 3 + 2 * var(--gutter));
    display: flex;
    gap: var(--gutter);
    margin: 0 calc(-1 * var(--edge));
    padding: 0 var(--edge);
    scroll-padding-inline: var(--edge);
    list-style: none;
    overflow-x: auto;
    /* never a vertical scroller (the cards' rise would make it one and catch
       the wheel): vertical scrolling always goes to the page */
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .founders__track::-webkit-scrollbar {
    display: none;
  }

  /* ---- Card (shared) ---------------------------------------------------- */
  .fc {
    position: relative;
    flex: 0 0 var(--card-w);
    aspect-ratio: 5 / 7;
    overflow: hidden;
    scroll-snap-align: start;
    /* docking: a long, soft ease-out, the fade done early */
    transition: transform 2800ms cubic-bezier(0.16, 1, 0.3, 1), opacity 1200ms ease-out;
  }
  .fc.is-waiting {
    opacity: 0;
    transform: translate3d(calc(var(--card-w) * 0.9), 0, 0);
  }
  /* no sideways scrolling until the first cards have docked */
  .founders__track.is-docking {
    overflow-x: hidden;
  }
  /* slots are measured from the track */
  .founders__track {
    position: relative;
  }
  .fc :global(p) {
    margin: 0;
  }

  /* ---- Founder card: photo, then name and "CEO, company" ---------------- */
  .fc--founder {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: #ececea;
  }
  .fc__photo,
  .fc__photo-empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fc__photo {
    object-fit: cover;
  }
  .fc__photo-empty {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding: var(--gap);
  }
  .fc__who {
    position: relative;
    padding: var(--gap);
  }
  .fc__role {
    margin-top: var(--space-2x);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .fc--founder.has-photo .fc__who {
    color: #ffffff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
    padding-top: var(--gap-double);
  }
  .fc--founder.has-photo :global(.placeholder) {
    color: rgba(255, 255, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.6);
  }
  .fc--founder.has-photo .fc__role {
    color: rgba(255, 255, 255, 0.78);
  }

  /* ---- Company card: brand colour, name, one line ----------------------- */
  .fc--company {
    display: flex;
    flex-direction: column;
    gap: var(--space-4x);
    padding: var(--gap);
    background: var(--fc-bg);
    color: var(--fc-fg);
  }
  .fc__company {
    font-family: var(--font-display);
    font-size: clamp(28px, 2.6vw, 44px);
    line-height: 1.05;
    font-weight: var(--fw-heading);
  }
  /* "Discover more about <company> →" (owner, 2026-10-19): at the bottom of
     the card; the whole card is its click area. On hover (or keyboard focus)
     it animates in like the H1: word by word, each appearing two steps low
     and stepping up in 80ms frames (--reveal-frame, --reveal-stagger), the
     last word rising smoothly while a light tint of the text colour sweeps
     off to the right. The step is sized so it moves the same ~2px as the
     H1's. Touch screens (no hover) show it plainly. */
  .fc__more {
    --reveal-step: 0.14em;
    margin-top: auto;
    color: inherit;
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
  }
  .fc__more::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .fc__more:focus-visible {
    outline: none;
  }
  .fc__more:focus-visible::after {
    outline: 2px solid var(--fc-fg);
    outline-offset: -8px;
  }
  .fc__w {
    display: inline-block;
  }
  @media (hover: hover) {
    .fc__more .fc__w {
      opacity: 0;
    }
    .fc--company:is(:hover, :focus-within) .fc__w {
      animation: fc-w-in calc(var(--reveal-frame) * 4) step-end forwards;
      animation-delay: calc(var(--i) * var(--reveal-stagger));
    }
    .fc--company:is(:hover, :focus-within) .fc__w--last {
      --fcw-sweep: 100%;
      background: linear-gradient(90deg, var(--fc-fg) var(--fcw-sweep), color-mix(in srgb, var(--fc-fg) 25%, transparent) calc(var(--fcw-sweep) + 100%));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation:
        fc-w-show calc(var(--reveal-frame) * 9) step-end forwards,
        fc-w-rise calc(var(--reveal-frame) * 9) cubic-bezier(0.2, 0.7, 0.2, 1) forwards,
        fc-w-tint var(--reveal-tint-duration) var(--reveal-gentle-ease) both;
      animation-delay:
        calc(var(--i) * var(--reveal-stagger)),
        calc(var(--i) * var(--reveal-stagger)),
        calc(var(--i) * var(--reveal-stagger) + var(--reveal-frame));
    }
  }
  /* 4 frames: invisible, then two steps down, one step, rest */
  @keyframes fc-w-in {
    0%   { opacity: 0; transform: translateY(calc(2 * var(--reveal-step))); }
    25%  { opacity: 1; transform: translateY(calc(2 * var(--reveal-step))); }
    50%  { opacity: 1; transform: translateY(var(--reveal-step)); }
    75%, 100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes fc-w-show {
    0%      { opacity: 0; }
    11.111%, 100% { opacity: 1; }
  }
  @keyframes fc-w-rise {
    0%   { transform: translateY(calc(7 * var(--reveal-step))); }
    100% { transform: translateY(0); }
  }
  @property --fcw-sweep {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 100%;
  }
  @keyframes fc-w-tint {
    from { --fcw-sweep: 0%; }
  }
  .fc__blurb {
    max-width: 30ch;
    font-size: var(--fs-small);
    line-height: 1.45;
    opacity: 0.8;
  }

  /* ---- Clip card: TikTok-style video ------------------------------------ */
  .fc--clip {
    background: #0b0b0b;
    color: #ffffff;
  }
  .fc__video,
  .fc__clip-empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fc__video {
    object-fit: cover;
  }
  .fc__clip-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4x);
    background: radial-gradient(ellipse 80% 60% at 50% 40%, #2a2a2a, #0b0b0b);
    color: rgba(255, 255, 255, 0.85);
  }
  /* legibility: soft dark at the top and bottom, as in the app */
  .fc--clip::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0) 18%, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.6));
  }
  .fc__progress {
    position: absolute;
    inset: 12px 12px auto;
    z-index: 1;
    height: 2px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 1px;
    overflow: hidden;
  }
  .fc__progress span {
    display: block;
    height: 100%;
    background: #ffffff;
    transform: scaleX(0.35);
    transform-origin: 0 50%;
  }
  .fc__rail {
    position: absolute;
    right: 10px;
    bottom: 24px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  /* Rail icons at half their first size (owner, 2026-10-19): Like and Share
     15px; the avatar a little bigger again, 28px. */
  .fc__avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-bottom: 4px;
    border: 1px solid #ffffff;
    border-radius: 50%;
    background: #111111;
    font-family: var(--font-display);
    font-size: 11px;
  }
  a.fc__avatar {
    color: #ffffff;
    text-decoration: none;
    transition: transform 150ms ease;
  }
  a.fc__avatar:hover {
    transform: scale(1.08);
  }
  a.fc__avatar:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }
  .fc__avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .fc__follow {
    position: absolute;
    bottom: -5px;
    left: 50%;
    display: grid;
    place-items: center;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    border-radius: 50%;
    background: #ff3b5c;
    font-family: var(--font-sans);
    font-size: 9px;
    line-height: 1;
  }
  .fc__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 0;
    border: 0;
    background: none;
    color: #ffffff;
    text-decoration: none;
    font: 600 9px/1.2 var(--font-sans);
    cursor: pointer;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
  }
  .fc__action svg {
    fill: #ffffff;
