---
import { insights } from '@content/home';
import { href, isPlaceholder } from '@lib/href';
import Placeholder from '@components/ui/Placeholder.astro';
import Sentences from '@components/ui/Sentences.astro';
import RobotArm from '@components/visuals/RobotArm.astro';
---

<section class="section section--dark theme-dark" data-nav-dark>
  <div class="wrap">
    <p class="eyebrow">{insights.eyebrow}</p>
    <h2 class="h-section section-title"><Sentences text={insights.title} /></h2>

    <ul class="cards articles">
      {
        insights.articles.map((a) => (
          <li class="article">
            <div class:list={['article__visual', a.visual && 'article__visual--live']}>
              {a.visual === 'robot-arm' ? (
                <RobotArm />
              ) : isPlaceholder(a.image) ? (
                <Placeholder value={a.image} />
              ) : (
                <img src={href(a.image)} alt="" loading="lazy" decoding="async" />
              )}
            </div>
            <p class="label article__meta">
              <Placeholder value={a.category} />
              <span aria-hidden="true"> &middot; </span>
              {isPlaceholder(a.date) ? (
                <Placeholder value={a.date} />
              ) : (
                <time datetime={a.date}>{a.date}</time>
              )}
            </p>
            <h3 class="card-title article__title">
              <a class="article__link" href={href(`/insights/news/${a.slug}`)}>{a.title}</a>
            </h3>
          </li>
        ))
      }
    </ul>
    <p class="section-link">
      <a class="arrow-link" href={href(insights.allLink.href)}>{insights.allLink.label}</a>
    </p>

  </div>
</section>

<style>
  .section-title {
    margin-top: var(--gap-half);
  }
  /* Desktop: the title runs at most 6 of the 12 grid columns. */
  @media (min-width: 880.02px) {
    .section-title {
      max-width: calc((100% - 11 * var(--gutter)) / 12 * 6 + 5 * var(--gutter));
    }
  }
  .articles {
    margin: var(--space-4x) 0 0;   /* heading → content: 16px */
    padding: 0;
    list-style: none;
  }
  .article {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-half);
  }
  /* Visual: 5:7 portrait (7:5 landscape on phones), a flat grey until the
     image is supplied. */
  .article__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 5 / 7;
    margin-bottom: var(--gap-half);
    background: #262626;
    overflow: hidden;
  }
  .article__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Coded visuals (e.g. the robot arm) stay interactive: they sit above
     the card's full-size link, so dragging turns the model instead of
     opening the article (the title still links). */
  .article__visual--live {
    position: relative;
    z-index: 1;
    display: block;
  }
  /* Phones (one column): landscape 7:5, so three stacked visuals don't
     run to ~1,400px. */
  @media (max-width: 640px) {
    .article__visual {
      aspect-ratio: 7 / 5;
    }
  }
  .article__meta {
    margin: 0;
    color: var(--muted);
  }
  .article__title {
    margin: 0;
  }
  .article__link {
    text-decoration-line: none;
  }
  .article__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .article:hover .article__link,
  .article:focus-within .article__link {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }
  .section-link {
    margin-top: var(--gap-double);
  }
</style>
