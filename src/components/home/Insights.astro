---
import ArrowLink from '@components/ui/ArrowLink.astro';
import { insights } from '@content/home';
import { href, isPlaceholder } from '@lib/href';
import Placeholder from '@components/ui/Placeholder.astro';
import Sentences from '@components/ui/Sentences.astro';
import RobotArm from '@components/visuals/RobotArm.astro';
import ScrollVideo from '@components/visuals/ScrollVideo.astro';
import ScrollPhoto from '@components/visuals/ScrollPhoto.astro';
---

<section class="section section--dark theme-dark" data-nav-dark>
  <div class="wrap">
    <h2 class="h-section section-title"><Sentences text={insights.title} /></h2>

    <ul class="cards articles">
      {
        insights.articles.map((a) => (
          <li class="article">
            <div class:list={['article__visual', a.visual === 'robot-arm' && 'article__visual--live', (a.video || a.scrollPhoto) && 'article__visual--video']}>
              {a.visual === 'robot-arm' ? (
                <RobotArm />
              ) : a.scrollPhoto ? (
                <ScrollPhoto src={href(a.scrollPhoto.src)} credit={a.scrollPhoto.credit} />
              ) : a.video ? (
                <ScrollVideo src={href(a.video.src)} poster={href(a.video.poster)} />
              ) : isPlaceholder(a.image) ? (
                <Placeholder value={a.image} />
              ) : (
                <img src={href(a.image)} alt="" loading="lazy" decoding="async" />
              )}
            </div>
            <h3 class="card-title article__title">
              <a class="article__link" href={href(`/insights/news/${a.slug}`)}>{a.title}</a>
            </h3>
            <p class="body article__intro">{a.intro}</p>
          </li>
        ))
      }
    </ul>
    <p class="section-link">
      <ArrowLink href={href(insights.allLink.href)} label={insights.allLink.label} />
    </p>

  </div>
</section>

<style>
  .section-title {
    margin-top: var(--cap-top); /* opens the section: capitals on the padding line */
  }
  /* Desktop: the title runs at most 6 of the 12 grid columns. */
  @media (min-width: 880.02px) {
    .section-title {
      max-width: calc((100% - 11 * var(--gutter)) / 12 * 6 + 5 * var(--gutter));
    }
  }
  .articles {
    margin: var(--space-4x) 0 0;   /* heading → content: 16px */
    padding: 0;
    list-style: none;
  }
  .article {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-half);
  }
  /* Visual: 5:7 portrait (7:5 landscape on phones), a light grey tile
     (#f5f5f5, as the robot arm's box) until the image is supplied. */
  .article__visual {
    position: relative; /* holds a scroll video, under the card's link */
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 5 / 7;
    margin-bottom: var(--gap-half);
    background: #f5f5f5; /* 4% black over white, also on the black band */
    overflow: hidden;
  }
  /* A video card (owner, 2026-11-16: a grey line showed around it on a
     phone): no grey behind it, so no hairline can show at a rounded edge. */
  .article__visual--video {
    background: transparent;
  }
  .article__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Interactive coded visuals (the robot arm) stay interactive: they sit above
     the card's full-size link, so dragging turns the model instead of
     opening the article (the title still links). */
  .article__visual--live {
    position: relative;
    z-index: 1;
    display: block;
    background: var(--white); /* the visual's own 4% grey box on white = #f5f5f5 */
  }
  /* Phones (one column): landscape 7:5, so three stacked visuals don't
     run to ~1,400px. */
  @media (max-width: 640px) {
    .article__visual {
      aspect-ratio: 7 / 5;
    }
  }
  .article__title {
    margin: 0;
  }
  /* Two lines of body copy under the title (owner, 2026-10-19; replaced the
     category · date line above it). */
  .article__intro {
    margin: 0;
    color: var(--muted);
  }
  .article__link {
    text-decoration-line: none;
  }
  .article__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .article:hover .article__link,
  .article:focus-within .article__link {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }
  .section-link {
    margin-top: var(--gap-double);
  }
</style>
