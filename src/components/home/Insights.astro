---
import { insights } from '@content/home';
import { href, isPlaceholder } from '@lib/href';
import Placeholder from '@components/ui/Placeholder.astro';
import Sentences from '@components/ui/Sentences.astro';
---

<section class="section section--dark theme-dark" data-nav-dark>
  <div class="wrap">
    <p class="eyebrow">{insights.eyebrow}</p>
    <h2 class="h-section section-title"><Sentences text={insights.title} /></h2>

    <ul class="cards articles">
      {
        insights.articles.map((a) => (
          <li class="article">
            <p class="label article__meta">
              <Placeholder value={a.category} />
              <span aria-hidden="true"> &middot; </span>
              {isPlaceholder(a.date) ? (
                <Placeholder value={a.date} />
              ) : (
                <time datetime={a.date}>{a.date}</time>
              )}
            </p>
            <h3 class="card-title article__title">
              <a class="article__link" href={href(`/insights/news/${a.slug}`)}>{a.title}</a>
            </h3>
          </li>
        ))
      }
    </ul>
    <p class="section-link">
      <a class="arrow-link" href={href(insights.allLink.href)}>{insights.allLink.label}</a>
    </p>

  </div>
</section>

<style>
  .section-title {
    margin-top: var(--gap-half);
  }
  .articles {
    margin: var(--space-4x) 0 0;   /* heading → content: 16px */
    padding: 0;
    list-style: none;
  }
  .article {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-half);
    padding-top: var(--space-4x);
    border-top: var(--hairline-w) solid var(--hairline);
  }
  .article__meta {
    margin: 0;
    color: var(--muted);
  }
  .article__title {
    margin: 0;
  }
  .article__link {
    text-decoration-line: none;
  }
  .article__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .article:hover .article__link,
  .article:focus-within .article__link {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }
  .section-link {
    margin-top: var(--gap-double);
  }
</style>
