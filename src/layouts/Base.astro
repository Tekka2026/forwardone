---
import '../../css/global.css';
// The headings' font, fetched from the start (owner, 2026-11-25: fonts
// popped in after a reload): the same files global.css declares.
import aeonikRegular from '../assets/fonts/aeonik-trial/AeonikTRIAL-Regular.woff2?url';
import aeonikSemiBold from '../assets/fonts/aeonik-trial/AeonikTRIAL-SemiBold.woff2?url';
import Header, { type Partner } from '@components/Header.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@content/nav';
import { href } from '@lib/href';

interface Props {
  title: string;
  description?: string;
  /** Header on a black intro block (homepage). */
  darkTop?: boolean;
  /** Landing page (e.g. /the-pitch): header without LP login, footer with
   *  the copyright line only, no floating navigation bar. */
  minimal?: boolean;
  /** Partner logos next to the wordmark (see Header.astro). */
  partners?: Partner[];
  /** Links in the minimal footer (see Footer.astro). */
  footerLinks?: { label: string; href: string }[];
  /** Header without its buttons (see Header.astro). */
  noHeaderActions?: boolean;
}

const { title, description = site.description, darkTop = false, minimal = false, partners = [], noHeaderActions = false, footerLinks = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- No unstyled flash (owner, 2026-11-25: "a glitch of white, some fonts
         not rendered properly"): until the site's stylesheet has loaded only
         the page's first background shows (dark for pages that open dark);
         global.css makes the page visible. Never longer than 3s, so a page
         whose stylesheet fails still appears. -->
    <style is:inline set:html={`html{background:${darkTop ? '#0F121A' : '#F5F5F5'}}body{visibility:hidden;animation:fo-show 0s 3s forwards}@keyframes fo-show{to{visibility:visible}}`} />
    <!-- No colour transitions while the page loads (a button faded in from
         the browser's link blue after a reload); on once it has loaded.
         Checked, not awaited: a password-unlocked page never fires 'load'. -->
    <style is:inline>html:not(.fo-ready) *{transition:none!important}</style>
    <script is:inline>(function r(){document.readyState==='complete'?requestAnimationFrame(function(){requestAnimationFrame(function(){document.documentElement.classList.add('fo-ready')})}):setTimeout(r,50)})();</script>
    <link rel="preload" href={aeonikRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={aeonikSemiBold} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400..600;1,400..600&display=swap"
    />
    <slot name="head" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLinkLabel}</a>
    <div class:list={['page', minimal && 'page--minimal']} data-page>
      <Header dark={darkTop} minimal={minimal} partners={partners} noActions={noHeaderActions} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer minimal={minimal} links={footerLinks} />
    </div>
    {!minimal && <Nav />}
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: var(--space-2x);
    left: var(--space-2x);
    z-index: 100;
    padding: var(--gap-half) var(--gap);
    background: var(--fg);
    color: var(--bg);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration-line: none;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
    outline: 2px solid var(--bg);
    outline-offset: -4px;
  }
  main:focus {
    outline: none;
  }

  /* Page wrapper: reserves room for the floating nav bar and is pushed back
     (scaled, darkened, inert) while the nav panel is open. */
  .page {
    padding-bottom: calc(var(--nav-height) + 2 * var(--gap));
    /* transform-origin is set by Nav.astro to the centre of the viewport */
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1); /* release mirrors push */
  }
  /* No floating nav on landing pages, so no room kept for it. */
  .page--minimal {
    padding-bottom: 0;
  }
  .page.is-pushed {
    transform: scale(0.97);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1); /* push: fluid */
  }

  /* Visible marker for content that still has to be supplied. */
  .placeholder {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    line-height: var(--lh-mono);
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
    border: 1px dashed var(--muted);
    padding: 0 var(--space);
    white-space: normal;
  }
</style>
