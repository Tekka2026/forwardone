---
import '../../css/global.css';
import Header from '@components/Header.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import { site } from '@content/nav';
import { href } from '@lib/href';

interface Props {
  title: string;
  description?: string;
  /** Header on a black intro block (homepage). */
  darkTop?: boolean;
}

const { title, description = site.description, darkTop = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..600&display=swap"
    />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <!-- Variable font (weight axis 200–700) for intermediate heading weights,
         plus static cuts as fallback. -->
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@1&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLinkLabel}</a>
    <div class="page" data-page>
      <Header dark={darkTop} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <Nav />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: var(--space-2x);
    left: var(--space-2x);
    z-index: 100;
    padding: var(--gap-half) var(--gap);
    background: var(--fg);
    color: var(--bg);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration-line: none;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
    outline: 2px solid var(--bg);
    outline-offset: -4px;
  }
  main:focus {
    outline: none;
  }

  /* Page wrapper: reserves room for the floating nav bar and is pushed back
     (scaled, darkened, inert) while the nav panel is open. */
  .page {
    padding-bottom: calc(var(--nav-height) + 2 * var(--gap));
    /* transform-origin is set by Nav.astro to the centre of the viewport */
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1); /* release mirrors push */
  }
  .page.is-pushed {
    transform: scale(0.97);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1); /* push: fluid */
  }

  /* Visible marker for content that still has to be supplied. */
  .placeholder {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-mono);
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
    border: 1px dashed var(--muted);
    padding: 0 var(--space);
    white-space: normal;
  }
</style>
