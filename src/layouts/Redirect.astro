---
/**
 * Static redirect page (meta refresh) for hosts without server redirects.
 * `to` is a site path without base; the base path is added here.
 */
import { href } from '@lib/href';

interface Props {
  to: string;
}
const { to } = Astro.props;
const target = href(to);
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {to}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical.href} />
  </head>
  <body>
    <a href={target}>Redirecting to {to}</a>
  </body>
</html>
