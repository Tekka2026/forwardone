---
/**
 * For founders (/founders, owner 2026-10-26). The homepage is written for
 * investors; this page is written for founders. It reuses the homepage's
 * section patterns, composed here from the shared tokens and classes because
 * the homepage components read their copy from home.ts:
 * 1. Black intro like the homepage: eyebrow, H1 (word reveal), lede, two
 *    buttons; the key figures at its bottom (homepage stats pattern). The
 *    header shows "For investors" (back to the homepage) instead of Pitch us.
 * 3. Why founders pick us: a scroll-driven deck after lassie.ai: one
 *    visual (placeholder, 8 columns) per card with its text beside it,
 *    alternating left and right.
 * 4. How we work with you: the homepage Playbook pattern.
 * 5. What we back: lede and sector tags.
 * 6. Founders we back: the homepage founders strip (same sliding cards,
 *    this page's eyebrow and title), then the portfolio grid and the exits
 *    line.
 * 7. The partners: the homepage team pattern, same people (home.ts).
 * 8. After you pitch: four numbered steps.
 * 9. Closing: black band, centred, the pitch button.
 * Copy and placeholders in src/content/founders.ts.
 */
import Base from '@layouts/Base.astro';
import Button from '@components/ui/Button.astro';
import Placeholder from '@components/ui/Placeholder.astro';
import Sentences from '@components/ui/Sentences.astro';
import FoundersStrip from '@components/home/Founders.astro';
import { forFounders as f } from '@content/founders';
import { partners } from '@content/home';
import { href, isPlaceholder } from '@lib/href';

// Copy with an embedded placeholder ("within [PLACEHOLDER: X days], yes or no").
const chunks = (v: string) => v.split(/(\[PLACEHOLDER:[^\]]*\])/).filter(Boolean);
const h1Words = f.hero.title.split(/\s+/).filter(Boolean).length;
const two = (i: number) => String(i + 1).padStart(2, '0');
// Portfolio logos: single-colour SVGs from src/assets/portfolio, inlined so
// they take the text colour (as the footer's partner logos).
const logos = import.meta.glob<string>('../assets/portfolio/*.svg', { query: '?raw', import: 'default', eager: true });
const logo = (name: string) => logos[`../assets/portfolio/${name}.svg`] ?? '';
const labelled = (svg: string, label: string) =>
  svg.replace('<svg ', `<svg role="img" aria-label="${label}" class="f-logo__svg" `);
---

<Base title={f.meta.title} description={f.meta.description} darkTop forFounders>
  <!-- 1–2. Black intro: hero and key figures, like the homepage. -->
  <div class="f-intro theme-dark" data-nav-dark style={`--h1-words: ${h1Words}`}>
    <section class="section section--flush f-hero">
      <div class="wrap">
        <p class="eyebrow"><Sentences text={f.hero.eyebrow} reveal tick /></p>
        <h1 class="h-display f-hero__title"><Sentences text={f.hero.title} reveal /></h1>
        <p class="lede f-hero__lede reveal-gentle">{f.hero.lede}</p>
        <div class="f-hero__actions">
          <Button href={f.hero.primary.href} class="reveal-block">{f.hero.primary.label}</Button>
          <Button href={f.hero.secondary.href} variant="ghost" class="reveal-block">{f.hero.secondary.label}</Button>
        </div>
      </div>
    </section>
    <section class="section section--flush f-stats" aria-label="Key facts">
      <div class="wrap">
        <ul class="f-stats__list" style={`--stats: ${f.stats.length}`}>
          {
            f.stats.map((s, i) => (
              <li class="f-stat" style={`--n: ${i}`}>
                <p class="f-stat__value reveal-snap">{s.value}</p>
                <p class="f-stat__label small reveal-gentle">{s.label}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <!-- 3. Why founders pick us: a scroll-driven deck (after lassie.ai) -->
  <section class="section f-why-section">
    <div class="wrap">
      <p class="eyebrow">{f.why.eyebrow}</p>
      <h2 class="h-section f-title"><Sentences text={f.why.title} /></h2>
    </div>
    <div class="f-deck" data-deck style={`--n: ${f.why.cards.length}`}>
      <div class="f-deck__stage">
        <div class="wrap">
          <ol class="f-deck__list">
            {
              f.why.cards.map((c, i) => (
                <li class:list={['f-deck__item', i % 2 ? 'is-right' : 'is-left']} data-deck-item>
                  <div class="f-deck__text">
                    <h3 class="f-deck__title">{c.title}</h3>
                    <p class="small f-deck__body">{c.body}</p>
                  </div>
                  <div class="f-deck__visual" aria-hidden="true">
                    <span class="f-deck__visual-title">{c.title}</span>
                    <Placeholder value={f.why.visual} class="f-deck__marker" />
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. How we work with you: the homepage Playbook pattern -->
  <section class="section section--feature">
    <div class="wrap">
      <p class="eyebrow">{f.how.eyebrow}</p>
      <div class="grid f-playbook">
        <div class="col-7">
          <h2 class="h-feature"><Sentences text={f.how.title} reveal onScroll /></h2>
          <p class="lede f-playbook__body">{f.how.body}</p>
        </div>
        <ol class="col-4 start-9 f-playbook__list">
          {
            f.how.steps.map((s) => (
              <li class="f-playbook__item">
                <div class="f-playbook__text">
                  <span class="f-playbook__step">{s.title}</span>
                  <span class="small f-playbook__line">{s.body}</span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. What we back -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{f.back.eyebrow}</p>
      <h2 class="h-section f-title"><Sentences text={f.back.title} /></h2>
      <p class="lede f-body">{f.back.body}</p>
      <ul class="f-tags" aria-label="Sectors">
        {f.back.sectors.map((s) => <li class="f-tag small">{s}</li>)}
      </ul>
    </div>
  </section>

  <!-- 6. Founders we back: the homepage founders strip (sliding cards), with
       this page's head; then the portfolio grid and the exits line. -->
  <FoundersStrip eyebrow={f.backed.eyebrow} title={f.backed.title} intro="" />
  <section class="section f-portfolio-section" aria-labelledby="f-portfolio-title">
    <div class="wrap">
      <h3 class="card-title f-portfolio__title" id="f-portfolio-title">{f.backed.portfolioTitle}</h3>
      <ul class="f-portfolio">
        {
          f.backed.portfolio.map((c) => {
            const svg = logo(c.logo);
            return (
              <li class="f-logo">
                {svg ? (
                  <Fragment set:html={labelled(svg, c.name)} />
                ) : (
                  <span class="f-logo__missing">
                    <span class="card-title">{c.name}</span>
                    <Placeholder value={f.backed.logoMissing} />
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="body body--wide f-exits">
        <strong>{f.backed.exits.lead}</strong> {f.backed.exits.text}
      </p>
    </div>
  </section>

  <!-- 7. The partners: the homepage team pattern -->
  <section class="section" id="partners">
    <div class="wrap">
      <p class="eyebrow">{f.partners.eyebrow}</p>
      <h2 class="h-section f-title"><Sentences text={f.partners.title} /></h2>
      <ul class="cards f-partners">
        {
          partners.people.map((p) => (
            <li class="f-partner">
              <div class="f-partner__photo">
                {isPlaceholder(p.photo) ? (
                  <Placeholder value={p.photo} />
                ) : (
                  <img src={href(p.photo)} alt={p.name} loading="lazy" />
                )}
              </div>
              <h3 class="card-title f-partner__name">{p.name}</h3>
              <p class="label f-partner__role">{p.role}</p>
              {isPlaceholder(p.quote) ? (
                <p class="small f-partner__quote">
                  <Placeholder value={p.quote} />
                </p>
              ) : (
                <blockquote class="small f-partner__quote">
                  <p>“{p.quote}”</p>
                </blockquote>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. After you pitch -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{f.after.eyebrow}</p>
      <h2 class="h-section f-title"><Sentences text={f.after.title} /></h2>
      <ol class="cards f-steps">
        {
          f.after.steps.map((s, i) => (
            <li class="f-step">
              <span class="label f-step__n" aria-hidden="true">{two(i)}</span>
              <h3 class="card-title f-step__title">{s.title}</h3>
              <p class="small f-step__body">
                {chunks(s.body).map((c) => (
                  <Placeholder value={c} />
                ))}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 9. Closing: black band, centred -->
  <section class="section section--dark theme-dark f-closing" id="pitch" data-nav-dark>
    <div class="wrap">
      <h2 class="h-feature f-closing__title"><Sentences text={f.closing.title} /></h2>
      <div class="f-closing__actions">
        {
          isPlaceholder(f.closing.cta.href) ? (
            <>
              <span class="btn" aria-disabled="true">{f.closing.cta.label}</span>
              <Placeholder value={f.closing.cta.href} />
            </>
          ) : (
            <Button href={f.closing.cta.href}>{f.closing.cta.label}</Button>
          )
        }
      </div>
      <p class="small f-closing__email">
        {f.closing.emailLead}{' '}
        {isPlaceholder(f.closing.email) ? (
          <Placeholder value={f.closing.email} />
        ) : (
          <a href={`mailto:${f.closing.email}`}>{f.closing.email}</a>
        )}
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  // The "Why founders pick us" deck (owner, 2026-10-26, after lassie.ai).
  // The page scrolls as usual; the deck's sticky stage turns the scroll
  // position into a progress value (0 = first card, n - 1 = last), followed
  // lazily (eased a little each frame), so the cards glide rather than snap.
  // Per card, d = its index minus the progress: d < 0 lifts away and fades,
  // d = 0 is in front, d > 0 waits in the stack below, smaller and lower so
  // its bottom edge peeks out (two cards deep). Text beside a card is shown
  // around d = 0. Only on wider screens with motion allowed; otherwise the
  // cards stay a plain list.
  (function () {
    var deck = document.querySelector('[data-deck]');
    if (!deck) return;
    var items = [].slice.call(deck.querySelectorAll('[data-deck-item]'));
    var wide = window.matchMedia('(min-width: 880.02px)');
    var still = window.matchMedia('(prefers-reduced-motion: reduce)');
    var n = items.length, cur = 0, raf = 0, on = false;
    function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
    function target() {
      var r = deck.getBoundingClientRect();
      var run = deck.offsetHeight - window.innerHeight;
      return run > 0 ? clamp(-r.top / run, 0, 1) * (n - 1) : 0;
    }
    function paint(p) {
      items.forEach(function (it, i) {
        var d = i - p;
        var v = it.querySelector('.f-deck__visual'), t = it.querySelector('.f-deck__text');
        var vy, vs, vo;
        // Leaving: glides up and out of the stage, opaque all the way (so the
        // next card never shows through it), fading only at the very end.
        if (d < 0) { vy = d * 115 + '%'; vs = 1; vo = clamp(1 + (d + 0.75) * 4, 0, 1); }
        else { vy = d * 22 + 'px'; vs = 1 - d * 0.06; vo = clamp(3 - d, 0, 1); }
        v.style.setProperty('--vy', vy);
        v.style.setProperty('--vs', vs.toFixed(4));
        v.style.setProperty('--vo', vo.toFixed(3));
        v.style.setProperty('--z', String(100 - Math.round(d * 10)));
        v.style.setProperty('--shade', clamp(d * 3, 0, 9).toFixed(1));
        var a = Math.abs(d);
        t.style.setProperty('--to', clamp(1 - a * 2.5, 0, 1).toFixed(3));
        t.style.setProperty('--ty', (d * 28).toFixed(1) + 'px');
        it.toggleAttribute('inert', a > 0.5);
      });
    }
    function tick() {
      var to = target();
      cur += (to - cur) * 0.12;
      if (Math.abs(to - cur) < 0.001) cur = to;
      paint(cur);
      raf = cur === to ? 0 : requestAnimationFrame(tick);
    }
    function wake() { if (on && !raf) raf = requestAnimationFrame(tick); }
    function setup() {
      var want = wide.matches && !still.matches;
      if (want === on) return;
      on = want;
      deck.classList.toggle('is-deck', on);
      if (on) { cur = target(); paint(cur); }
      else items.forEach(function (it) { it.removeAttribute('inert'); });
    }
    setup();
    window.addEventListener('scroll', wake, { passive: true });
    window.addEventListener('resize', function () { setup(); wake(); });
    wide.addEventListener('change', setup);
  })();
</script>

<style>
  /* ---- 1–2. Black intro (as .intro on the homepage) ---------------------- */
  .f-intro {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background: var(--bg);
    box-shadow: 0 0 0 100vmax var(--bg);
    clip-path: inset(-100vmax -100vmax 0);
    /* Sequence: H1 word by word, then the lede, the buttons, the figures. */
    --h1-end: calc(var(--reveal-start) + (var(--h1-words) - 1) * var(--reveal-stagger) + 9 * var(--reveal-frame));
    --buttons-at: calc(var(--h1-end) + 8 * var(--reveal-frame));
    --figures-at: calc(var(--h1-end) + var(--reveal-gentle) / 2 + 180ms + 4 * var(--reveal-frame));
  }
  .f-intro + .section {
    border-top: 0;
  }
  .f-hero {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--gap);
  }
  /* .wrap centres itself with auto margins; in a flex column that would
     shrink it to its content. */
  .f-hero > .wrap {
    width: calc(100% - 2 * var(--pad));
  }
  .f-hero .eyebrow {
    --reveal-start: 0ms;
  }
  .f-hero__title {
    margin-top: var(--gap-half);
    max-width: var(--col-10);
  }
  .f-hero__lede {
    margin-top: var(--space-4x);
    animation-delay: var(--h1-end);
  }
  .f-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-half);
    margin-top: var(--gap-double);
  }
  .f-hero__actions > :global(.btn) {
    animation-delay: var(--buttons-at);
  }
  .f-hero__actions > :global(.btn + .btn) {
    animation-delay: calc(var(--buttons-at) + var(--reveal-stagger-buttons));
  }

  /* Key figures (homepage stats pattern) */
  /* The figures sit at the bottom of the first screen; the bottom padding
     keeps their labels clear of the floating navigation bar. */
  .f-stats {
    margin-top: auto;
    padding-top: var(--gap-double);
    padding-bottom: calc(var(--nav-height) + 2 * var(--gap));
  }
  .f-stats__list {
    display: grid;
    grid-template-columns: repeat(var(--stats), minmax(min-content, 1fr));
    gap: var(--space-8x) var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .f-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2x);
    --stat-at: calc(var(--figures-at) + var(--n) * var(--reveal-stagger-figures));
  }
  .f-stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-section);
    line-height: var(--lh-section);
    letter-spacing: var(--ls-section);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    animation-delay: var(--stat-at);
  }
  .f-stat__label {
    margin: 0;
    color: var(--muted);
    animation-delay: calc(var(--stat-at) + 3 * var(--reveal-frame));
  }

  /* ---- Shared section rhythm (as on the homepage) ------------------------ */
  .f-title {
    margin-top: var(--gap-half);
  }
  .f-body {
    margin-top: var(--space-4x);
  }

  /* ---- 3. Why founders pick us: the deck -------------------------------- */
  /* Without script, with reduced motion and at ≤880px: one row per card,
     the visual (8 columns, centred) with its text beside it in the outer two
     columns, alternating left and right; stacked on phones. With script on
     wider screens (.is-deck) the rows lie on top of each other in a sticky
     stage and the page's own scrolling moves through them (see the script):
     the front card lifts away, the next one comes forward from the stack
     below it, and the text beside it fades across, left then right. */
  .f-deck {
    margin-top: var(--space-8x);
  }
  .f-deck__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .f-deck__item {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
  }
  .f-deck__item + .f-deck__item {
    margin-top: var(--gap-double);
  }
  .f-deck__visual {
    grid-column: 3 / span 8;
    grid-row: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    max-height: 62vh;
    max-height: 62svh;
    padding: var(--gap-double);
    border: var(--hairline-w) solid var(--hairline);
    background: #f5f5f5;
  }
  .f-deck__visual-title {
    max-width: var(--col-5);
    font-family: var(--font-display);
    font-size: var(--fs-section);
    line-height: var(--lh-section);
    font-weight: var(--fw-heading);
    text-align: center;
  }
  .f-deck__visual :global(.f-deck__marker) {
    position: absolute;
    left: var(--gap);
    bottom: var(--gap);
  }
  .f-deck__text {
    grid-row: 1;
  }
  .is-left .f-deck__text {
    grid-column: 1 / span 2;
  }
  .is-right .f-deck__text {
    grid-column: 11 / span 2;
  }
  .f-deck__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-metric);
    line-height: var(--lh-metric);
    font-weight: var(--fw-heading);
  }
  .f-deck__body {
    margin: var(--space-2x) 0 0;
    color: var(--muted);
  }

  /* Deck mode (set by the script, wider screens only). */
  .f-deck:global(.is-deck) {
    /* One screen of scrolling per card after the first, plus the stage. */
    height: calc((var(--n) - 1) * 70vh + 100vh);
    height: calc((var(--n) - 1) * 70svh + 100svh);
    margin-top: 0;
  }
  .f-deck:global(.is-deck) .f-deck__stage {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100vh;
    height: 100svh;
    /* Clear of the floating navigation bar at the bottom. */
    padding-bottom: calc(var(--nav-height) + var(--gap));
  }
  .f-deck:global(.is-deck) .f-deck__stage > .wrap {
    width: calc(100% - 2 * var(--pad));
  }
  .f-deck:global(.is-deck) .f-deck__item + .f-deck__item {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .f-deck:global(.is-deck) .f-deck__visual {
    z-index: var(--z, 1);
    transform-origin: 50% 100%;
    transform: translateY(var(--vy, 0)) scale(var(--vs, 1));
    opacity: var(--vo, 1);
    /* Cards further back in the stack are a shade darker. */
    background: color-mix(in srgb, #f5f5f5, #000 calc(var(--shade, 0) * 1%));
    will-change: transform, opacity;
  }
  .f-deck:global(.is-deck) .f-deck__text {
    opacity: var(--to, 1);
    transform: translateY(var(--ty, 0));
    will-change: transform, opacity;
  }

  @media (max-width: 880px) {
    .f-deck__item {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--gap);
    }
    .f-deck__visual,
    .is-left .f-deck__text,
    .is-right .f-deck__text {
      grid-column: 1;
    }
    .f-deck__text {
      grid-row: 2;
    }
    .f-deck__visual {
      padding: var(--gap);
    }
  }

  /* ---- 4. Playbook pattern ----------------------------------------------- */
  .f-playbook {
    margin-top: var(--gap-half);
    align-items: start;
  }
  .f-playbook__body {
    margin-top: var(--space-4x);
  }
  .f-playbook__list {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .f-playbook__item {
    display: flex;
    align-items: baseline;
    flex: 1 1 auto;
    gap: var(--space-4x);
    padding: var(--space-2x) 0;
    border-top: var(--hairline-w) solid var(--hairline);
    font-family: var(--font-sans);
    font-size: var(--fs-card-title);
    font-weight: 500;
    letter-spacing: var(--ls-card-title);
    line-height: var(--lh-card-title);
  }
  .f-playbook__item:last-child {
    border-bottom: var(--hairline-w) solid var(--hairline);
  }
  .f-playbook__item::before {
    counter-increment: step;
    content: '0' counter(step);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    color: var(--muted);
  }
  .f-playbook__text {
    display: flex;
    flex-direction: column;
    gap: var(--space);
  }
  .f-playbook__line {
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ---- 5. What we back: sector tags (chips as on the team profile) ------- */
  .f-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2x);
    max-width: var(--col-8);
    margin: var(--space-8x) 0 0;
    padding: 0;
    list-style: none;
  }
  .f-tag {
    padding: var(--space-2x) var(--space-4x);
    background: var(--bg-tint);
  }

  /* ---- 6. Founders we back ----------------------------------------------- */
  /* The portfolio grid continues the founders strip above it: no hairline,
     no top padding. */
  .f-portfolio-section {
    padding-top: 0;
    border-top: 0;
  }
  .f-portfolio__title {
    margin: 0;
  }
  /* Twelve square tiles, logo in the middle (owner, 2026-10-26): six per row
     (two grid columns each), three at ≤880px, two at ≤640px. */
  .f-portfolio {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gutter);
    margin: var(--space-4x) 0 0;
    padding: 0;
