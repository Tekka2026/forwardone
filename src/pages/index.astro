---
import Base from '@layouts/Base.astro';
import { meta, hero } from '@content/home';
import Hero from '@components/home/Hero.astro';
import Stats from '@components/home/Stats.astro';
import Founders from '@components/home/Founders.astro';
import TrackRecord from '@components/home/TrackRecord.astro';
import WhatWeDo from '@components/home/WhatWeDo.astro';
import CaseStudies from '@components/home/CaseStudies.astro';
import Playbook from '@components/home/Playbook.astro';
import Partners from '@components/home/Partners.astro';
import FundIII from '@components/home/FundIII.astro';
import Insights from '@components/home/Insights.astro';
import ClosingCta from '@components/home/ClosingCta.astro';
import Footnotes from '@components/home/Footnotes.astro';
// The intro sequence starts after the H1's last word has landed.
const h1Words = hero.title.split(/\s+/).filter(Boolean).length;
---

<Base title={meta.title} description={meta.description} darkTop>
  <!-- The intro and the founders strip share a wrapper: the intro stays put
       once the strip is 30px above the floating nav, and the strip scrolls
       over it (owner, 2026-11-04; as on the founders page). -->
  <div class="curtain" data-curtain>
    <!-- Black intro: header, hero and figures, 130% of the viewport high. -->
    <div class="intro theme-dark" data-nav-dark style={`--h1-words: ${h1Words}`}>
      <Hero />
      <Stats />
    </div>
    <Founders />
  </div>
  <script is:inline>
    // The curtain: the intro is sticky with a negative top, so it stops
    // moving when its bottom edge (where the strip starts) is 30px above the
    // floating nav bar; the strip, opaque and on top, then scrolls over it.
    // Measured here and on resize (window and intro height).
    (function () {
      var wrap = document.querySelector('[data-curtain]');
      if (!wrap) return;
      var intro = wrap.querySelector('.intro');
      var probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;visibility:hidden;height:calc(var(--nav-height) + var(--gap))';
      wrap.appendChild(probe);
      function place() {
        var line = window.innerHeight - probe.offsetHeight - 30;
        intro.style.setProperty('--curtain-top', Math.min(0, line - intro.offsetHeight) + 'px');
      }
      place();
      window.addEventListener('resize', place);
      window.addEventListener('load', place);
    })();
  </script>
  <TrackRecord />
  <WhatWeDo />
  <CaseStudies />
  <Playbook />
  <Partners />
  <FundIII />
  <Insights />
  <ClosingCta />
  <Footnotes />
</Base>

<style is:global>
  /* Black intro block. It starts under the header (pulled up by the header's
     height) and is at least 130% of the viewport high; the figures sit at
     its bottom. */
  .intro {
    display: flex;
    flex-direction: column;
    min-height: 130vh;
    min-height: 130svh;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background: var(--bg);
    /* Black to the window edges beyond the capped canvas, without adding
       width or scroll: a spread shadow, clipped at the block's bottom only.
       Upwards it also fills the strip uncovered above the page when the
       open menu pushes the page back (and the overscroll area). */
    box-shadow: 0 0 0 100vmax var(--bg);
    clip-path: inset(-100vmax -100vmax 0);
  }
  /* Tighter rhythm inside the block so it fits 90% where the content allows;
     on narrow screens it grows with its content. */
  /* Hero content (tag, title, body, buttons) centred vertically in the
     space between the header and the figures. */
  .intro > .hero {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--gap);
  }
  /* .wrap centres itself with auto margins; in a flex column that would
     shrink it to its content, so give it the full width minus its own
     padding (.wrap is content-box; max-width still caps it). */
  .intro > .hero > .wrap {
    width: calc(100% - 2 * var(--pad));
  }
  .intro > .stats {
    margin-top: auto;
    padding-block: var(--gap-double);
  }

  /* Sequence: H1 word by word, then the body copy, then the buttons, then
     the figures one by one. */
  .intro {
    --h1-end: calc(var(--reveal-start) + (var(--h1-words) - 1) * var(--reveal-stagger) + 9 * var(--reveal-frame));
    --buttons-at: calc(var(--h1-end) + 8 * var(--reveal-frame)); /* body copy ~half visible */
    --figures-at: calc(var(--h1-end) + var(--reveal-gentle) / 2 + 180ms + 4 * var(--reveal-frame));
  }
  .intro .hero__sub {
    animation-delay: var(--h1-end);
  }
  /* Buttons one after the other, starting just after the body copy. */
  .intro .hero__actions > .btn {
    animation-delay: var(--buttons-at);
  }
  .intro .hero__actions > .btn + .btn {
    animation-delay: calc(var(--buttons-at) + var(--reveal-stagger-buttons));
  }
  /* Figures: the number snaps in like an H1 word; its label eases in
     gently once the number has landed. */
  .intro .stat {
    --stat-at: calc(var(--figures-at) + var(--n) * var(--reveal-stagger-figures));
  }
  .intro .stat__value {
    animation-delay: var(--stat-at);
  }
  .intro .stat__label {
    animation-delay: calc(var(--stat-at) + 3 * var(--reveal-frame));
  }
  .intro + .section {
    border-top: 0;
  }
  /* The curtain (see the script after the wrapper). */
  .curtain {
    position: relative;
  }
  .curtain > .intro {
    position: sticky;
    top: var(--curtain-top, 0);
    z-index: 0;
  }
  .curtain > .section {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  /* Shared inline text link with arrow, used for section links. */
  .arrow-link {
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration-line: none;
  }
  .arrow-link::after {
    content: ' \2192';
  }
  .arrow-link:hover {
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }
</style>
