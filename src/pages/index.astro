---
import Base from '@layouts/Base.astro';
import { meta } from '@content/home';
import Hero from '@components/home/Hero.astro';
import Stats from '@components/home/Stats.astro';
import TrackRecord from '@components/home/TrackRecord.astro';
import WhatWeDo from '@components/home/WhatWeDo.astro';
import CaseStudies from '@components/home/CaseStudies.astro';
import Playbook from '@components/home/Playbook.astro';
import Partners from '@components/home/Partners.astro';
import FundIII from '@components/home/FundIII.astro';
import Insights from '@components/home/Insights.astro';
import ClosingCta from '@components/home/ClosingCta.astro';
import Footnotes from '@components/home/Footnotes.astro';
---

<Base title={meta.title} description={meta.description} darkTop>
  <!-- Black intro: header, hero and figures, 90% of the viewport high. -->
  <div class="intro theme-dark" data-nav-dark>
    <Hero />
    <Stats />
  </div>
  <TrackRecord />
  <WhatWeDo />
  <CaseStudies />
  <Playbook />
  <Partners />
  <FundIII />
  <Insights />
  <ClosingCta />
  <Footnotes />
</Base>

<style is:global>
  /* Black intro block. It starts under the header (pulled up by the header's
     height) and is at least 90% of the viewport high; the figures sit at
     its bottom. */
  .intro {
    display: flex;
    flex-direction: column;
    min-height: 90vh;
    min-height: 90svh;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background: var(--bg);
  }
  /* Tighter rhythm inside the block so it fits 90% where the content allows;
     on narrow screens it grows with its content. */
  .intro > .hero {
    padding-top: var(--space-16x);
    padding-bottom: 0;
  }
  .intro > .stats {
    margin-top: auto;
    padding-block: var(--gap-double);
  }
  .intro + .section {
    border-top: 0;
  }

  /* Shared inline text link with arrow, used for section links. */
  .arrow-link {
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
  }
  .arrow-link::after {
    content: ' \2192';
  }
  .arrow-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
