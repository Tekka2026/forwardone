---
/**
 * The ____ Pitch (owner, 2026-10-21): landing page for FORWARD.one's live
 * pitch event at Slush. White, aligned with the logo (no card; owner,
 * 2026-10-26), carrying:
 * - Eyebrow, then the H1 "The ____ Pitch" on one line. The blank is a line;
 *   as the visitor types the company name (the form's first field), the name
 *   is written onto it letter by letter in Covered By Your Grace, in a teal-to-green gradient. When the
 *   name is long the whole H1, handwriting included, scales down continuously
 *   so it never runs wider than 60% of the content width (90% on phones).
 * - A short lede on what the event is (Balnord linked).
 * - Under it the form as a fill-in-the-blanks letter (name, address, contact,
 *   what they build, deck), answers in the same handwriting, then the
 *   button and the privacy note. The event facts sit under it.
 * Copy and placeholders in src/content/pitch.ts.
 */
import Base from '@layouts/Base.astro';
import Button from '@components/ui/Button.astro';
import Placeholder from '@components/ui/Placeholder.astro';
import { pitch, type LetterPart, type PitchField } from '@content/pitch';
import { isPlaceholder } from '@lib/href';
import balnordLogo from '../assets/brand/balnord.svg?raw';
import hcvcLogo from '../assets/brand/hcvc.svg?raw';

// Each step as render tokens. Punctuation right after a blank is kept with
// it (no line break between the blank and its full stop or comma), and gets
// no space before it.
type Token = { text: string } | { field: PitchField; tail: string } | { placeholder: string };
const tokens = (parts: LetterPart[]): Token[] => {
  const out: Token[] = [];
  parts.forEach((part) => {
    const prev = out[out.length - 1];
    if (typeof part === 'string') {
      const m = prev && 'field' in prev ? part.match(/^[.,;:]+/) : null;
      if (m && prev && 'field' in prev) prev.tail = m[0];
      const rest = m ? part.slice(m[0].length).trim() : part;
      if (rest) out.push({ text: rest });
    } else if ('field' in part) out.push({ field: part.field, tail: '' });
    else out.push({ placeholder: part.placeholder });
  });
  return out;
};
const steps = pitch.steps.map(tokens);
const firstField = steps[0].findIndex((t) => 'field' in t);
// Values with an embedded placeholder ("FORWARD.one and [PLACEHOLDER: …]").
const chunks = (v: string) => v.split(/(\[PLACEHOLDER:[^\]]*\])/).filter(Boolean);
const ready = !isPlaceholder(pitch.bookingApi);
// The intro with the partner's name linked to their site.
const introParts = pitch.intro[0].split(pitch.partner.name);
// The partners' logos for the header, next to FORWARD.one.
const logos: Record<string, string> = { balnord: balnordLogo, hcvc: hcvcLogo };
const partners = pitch.hosts.map((h) => ({ name: h.name, href: h.href, svg: logos[h.logo] }));

---

<Base title={pitch.meta.title} description={pitch.meta.description} minimal partners={partners} noHeaderActions>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Covered+By+Your+Grace&display=swap"
  />
  <div class="pitch">
    <section class="section section--flush pitch__hero">
      <div class="wrap">
        <div class="pitch__sheet">
        <p class="eyebrow reveal-snap"><span class="pitch__eyebrow">{pitch.eyebrow.brand}</span>{pitch.eyebrow.rest}</p>
        <h1 class="h-display pitch__title" data-pitch-title>
          <span class="pitch__line" data-pitch-line>
            <span class="pitch__word reveal-snap" style="--i: 0">{pitch.title.before}</span>
            <span class="pitch__blank reveal-snap" style="--i: 1"
              ><span class="pitch__hand" data-pitch-hand aria-hidden="true">&#8203;</span
              ><span class="visually-hidden" data-pitch-sr></span></span
            >
            <span class="pitch__word reveal-snap" style="--i: 2">{pitch.title.after}</span>
          </span>
        </h1>

        <div class="pitch__intro reveal-gentle">
          <p class="lede">
            {introParts.map((t, i) => (
              <>
                {t}
                {i < introParts.length - 1 && <a href={pitch.partner.href} rel="noopener">{pitch.partner.name}</a>}
              </>
            ))}
          </p>
          {pitch.intro.slice(1).map((p) => <p class="small"><Placeholder value={p} /></p>)}
        </div>

        <form
          class="pitch__form"
          data-pitch-form
          data-ready={ready ? 'true' : 'false'}
          data-api={ready ? pitch.bookingApi.replace(/\/$/, '') : undefined}
          method="post"
        >
          {/* Honeypot: hidden from people, filled in by some bots. */}
          <div class="pitch__trap" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <p class="pitch__letter reveal-gentle">
            {
              steps.map((toks, si) => (
                <>
                  {si > 0 && ' '}
                  <span class="pitch__step" data-pitch-step>
                    {toks.map((t, i) => (
                      <>
                        {i > 0 && ' '}
                        {/* Phones: the company blank always starts the second line, so it
                            does not jump up once a short name fits on the first. */}
                        {si === 0 && i === firstField && <br class="pitch__break" />}
                        {'text' in t ? (
                          t.text
                        ) : 'placeholder' in t ? (
                          <Placeholder value={t.placeholder} />
                        ) : (
                          <span class="pitch__blank-wrap">
                            <label class="pitch__field">
                              <span class="visually-hidden">{t.field.label}</span>
                              {t.field.type === 'slot' ? (
                                <select
                                  class="pitch__input pitch__select is-empty"
                                  name={t.field.name}
                                  required={ready && t.field.required}
                                  data-pitch-input
                                  data-pitch-slot
                                >
                                  <option value="" selected>{t.field.hint}</option>
                                </select>
                              ) : (
                              <input
                                class="pitch__input"
                                type={t.field.type ?? 'text'}
                                name={t.field.name}
                                placeholder={t.field.hint}
                                autocomplete={t.field.autocomplete}
                                required={t.field.required}
                                spellcheck="false"
                                data-pitch-input
                                data-pitch-company={si === 0 && i === firstField ? '' : undefined}
                              />
                              )}
                            </label>
                            {t.tail}
                          </span>
                        )}
                      </>
                    ))}
                  </span>
                </>
              ))
            }
          </p>
          <div class="pitch__send">
            <Button type="submit">{pitch.submit}</Button>
            <p class="small pitch__status" data-pitch-status role="status" aria-live="polite"></p>
          </div>
          <p class="small pitch__privacy" data-pitch-final><Placeholder value={pitch.privacy} /></p>
          <template data-pitch-msg-not-sent>{pitch.notSent}</template>
          <template data-pitch-msg-sending>{pitch.sending}</template>
          <template data-pitch-msg-sent>{pitch.sent}</template>
          <template data-pitch-msg-no-slots>{pitch.noSlots}</template>
          <template data-pitch-msg-slots-failed>{pitch.slotsFailed}</template>
          <template data-pitch-msg-failed>{pitch.failed}</template>
        </form>
        </div>
      </div>
    </section>
    <section class="section section--flush pitch__info theme-dark">
      <div class="wrap">
        <dl class="pitch__facts">
          {
            pitch.facts.map((f) => (
              <div>
                <dt class="label">{f.label}</dt>
                <dd class="body">
                  {f.value.split('\n').map((line, li) => (
                    <>
                      {li > 0 && <br />}
                      {chunks(line).map((c) => (
                        <Placeholder value={c} />
                      ))}
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (function () {
    var title = document.querySelector('[data-pitch-title]');
    var line = document.querySelector('[data-pitch-line]');
    var hand = document.querySelector('[data-pitch-hand]');
    var sr = document.querySelector('[data-pitch-sr]');
    var company = document.querySelector('[data-pitch-company]');
    var form = document.querySelector('[data-pitch-form]');
    if (!title || !line || !hand || !company || !form) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Fit: the H1 never runs wider than --pitch-max of the content ----
    // width (60%, 90% on phones; owner, 2026-10-26).
    // Font size scales linearly with width, so one measurement is enough:
    // the natural width at the base size, from the current width and size.
    var probe = document.createElement('span');
    probe.className = 'pitch__probe';
    probe.setAttribute('aria-hidden', 'true');
    title.parentNode.appendChild(probe);
    function fit() {
      var base = parseFloat(getComputedStyle(probe).fontSize);
      var cur = parseFloat(getComputedStyle(title).fontSize);
      var w = line.getBoundingClientRect().width;
      if (!base || !cur || !w) return;
      var natural = (w * base) / cur;
      var max = parseFloat(getComputedStyle(title).getPropertyValue('--pitch-max')) || 0.6;
      var scale = Math.min(1, (max * title.clientWidth) / natural);
      title.style.setProperty('--pitch-scale', scale.toFixed(4));
    }

    // ---- Handwriting on the line: new letters are written in. -------------
    var shown = '';
    function write() {
      var next = company.value;
      var k = 0;
      while (k < shown.length && k < next.length && shown[k] === next[k]) k++;
      var letters = hand.querySelectorAll('.pitch__letter-hw');
      for (var i = letters.length - 1; i >= k; i--) letters[i].remove();
      for (var j = k; j < next.length; j++) {
        var s = document.createElement('span');
        s.className = 'pitch__letter-hw';
        s.textContent = next[j];
        // A slight wobble per letter, as by hand.
        s.style.setProperty('--r', (Math.random() * 4 - 2).toFixed(2) + 'deg');
        s.style.setProperty('--y', (Math.random() * 0.04 - 0.02).toFixed(3) + 'em');
        if (!reduce) s.style.animationDelay = (j - k) * 45 + 'ms';
        hand.appendChild(s);
      }
      shown = next;
      sr.textContent = next;
      title.classList.toggle('is-filled', next.length > 0);
      if (!next.trim()) done = false;
      hug();
      fit();
      paint();
    }
    company.addEventListener('input', write);

    // One gradient across the whole name (owner, 2026-10-22), though every
    // letter is its own span: each letter shows its slice of a gradient as
    // wide as the name. Measured in em, so it holds while the H1 scales.
    function paint() {
      var fs = parseFloat(getComputedStyle(hand).fontSize);
      var letters = hand.querySelectorAll('.pitch__letter-hw');
      if (!fs || !letters.length) return;
      var x0 = letters[0].offsetLeft, x1 = 0;
      letters.forEach(function (l) { x1 = Math.max(x1, l.offsetLeft + l.offsetWidth); });
      hand.style.setProperty('--hw-w', ((x1 - x0) / fs).toFixed(3) + 'em');
      letters.forEach(function (l) { l.style.setProperty('--hw-x', ((l.offsetLeft - x0) / fs).toFixed(3) + 'em'); });
    }

    // The line keeps its full length while the name is short and still being
    // typed; from 5 characters, or once the visitor leaves the field, it
    // shrinks to the name (owner, 2026-10-22).
    var done = false;
    var blank = title.querySelector('.pitch__blank');
    function hug() {
      title.classList.toggle('is-fit', company.value.trim().length >= 5 || (done && company.value.trim().length > 0));
    }
    company.addEventListener('change', function () { done = true; hug(); });

    // The H1's line is a second way in (owner, 2026-10-26): a click on it
    // types into the company name field, which the line mirrors. While that
    // field has focus the line shows a blinking caret after the name.
    if (blank) {
      blank.addEventListener('click', function () {
        company.focus({ preventScroll: true });
        var end = company.value.length;
        company.setSelectionRange(end, end);
      });
    }
    company.addEventListener('focus', function () { title.classList.add('is-typing'); });
    company.addEventListener('blur', function () { title.classList.remove('is-typing'); });
    // Re-fit the heading as the line changes length.
    if (blank) blank.addEventListener('transitionend', function () { fit(); });

    // ---- Blanks in the letter grow with what is typed. ---------------------
    var meter = document.createElement('span');
    meter.className = 'pitch__meter';
    meter.setAttribute('aria-hidden', 'true');
    form.querySelector('.pitch__letter').appendChild(meter);
    function size(input) {
      meter.textContent = input.tagName === 'SELECT'
        ? (input.selectedOptions[0] ? input.selectedOptions[0].textContent : '')
        : input.value || input.placeholder;
      // + 2px for the caret at the end.
      input.style.width = Math.ceil(meter.getBoundingClientRect().width) + 2 + 'px';
    }
    var inputs = form.querySelectorAll('[data-pitch-input]');
    inputs.forEach(function (input) {
      size(input);
      input.addEventListener('input', function () { size(input); });
      // Browser autofill (an email address, a name): the CSS starts a no-op
      // animation on :autofill, so the blank resizes and the letter opens on.
      input.addEventListener('animationstart', function (e) {
        if (e.animationName.indexOf('pitch-autofill') === -1) return;
        size(input);
        if (input === company) write();
        clearTimeout(pause);
        pause = setTimeout(advance, 300);
      });
    });

    // ---- Steps: the letter unfolds sentence by sentence. -----------------
    // Only the first sentence shows at first. The next one appears once the
    // first required field of the current one holds a valid value: after a
    // short pause in typing, on leaving the field, or on Enter (which also
    // moves to the next blank). The button and privacy note come with the
    // last sentence. Shown steps stay shown.
    var steps = [].slice.call(form.querySelectorAll('[data-pitch-step]'));
    var finals = [].slice.call(form.querySelectorAll('[data-pitch-final]'));
    var shownSteps = 1;
    function gate(step) {
      return step.querySelector('[data-pitch-input][required]');
    }
    function passed(step) {
      var g = gate(step);
      return !g || (g.value.trim() !== '' && g.checkValidity());
    }
    function showEl(el) {
      if (!el.hidden) return;
      el.hidden = false;
      if (!reduce) {
        el.classList.remove('is-entering');
        void el.offsetWidth;
        el.classList.add('is-entering');
      }
    }
    function advance() {
      while (shownSteps < steps.length && passed(steps[shownSteps - 1])) {
        showEl(steps[shownSteps]);
        steps[shownSteps].querySelectorAll('[data-pitch-input]').forEach(size);
        shownSteps++;
      }
      if (shownSteps === steps.length) finals.forEach(showEl);
      updateSend();
    }
    // The button shows from the start but stays disabled until the whole
    // letter is open and every required blank is validly filled.
    var send = form.querySelector('button[type="submit"]');
    function updateSend() {
      send.disabled = !(shownSteps === steps.length && form.checkValidity());
    }
    form.addEventListener('input', updateSend);
    steps.slice(1).forEach(function (st) { st.hidden = true; });
    finals.forEach(function (el) { el.hidden = true; });
    var pause;
    steps.forEach(function (st) {
      var g = gate(st);
      if (!g) return;
      g.addEventListener('input', function () {
        clearTimeout(pause);
        pause = setTimeout(advance, 900);
      });
      g.addEventListener('change', advance);
    });
    // Enter moves on to the next empty blank instead of sending early.
    form.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' || !e.target.matches('[data-pitch-input]')) return;
      var visible = [].slice.call(form.querySelectorAll('[data-pitch-input]')).filter(function (i) { return i.offsetParent; });
      var at = visible.indexOf(e.target);
      if (shownSteps === steps.length && at === visible.length - 1) return;
      e.preventDefault();
      if (!e.target.checkValidity()) { e.target.reportValidity(); return; }
      clearTimeout(pause);
      advance();
      visible = [].slice.call(form.querySelectorAll('[data-pitch-input]')).filter(function (i) { return i.offsetParent; });
      var next = visible[visible.indexOf(e.target) + 1];
      if (next) next.focus();
    });
    // A restored or autofilled form opens as far as it is filled.
    advance();

    var status = form.querySelector('[data-pitch-status]');
    function msg(key) {
      return form.querySelector('[data-pitch-msg-' + key + ']').content.textContent;
    }

    // ---- Pitch time: the free slots from the booking service. ------------
    // Loaded on arrival and again when the visitor opens the choice (at most
    // every 20s), so a time someone else just took disappears. A taken time
    // the visitor had chosen is cleared.
    var api = form.dataset.api;
    var slot = form.querySelector('[data-pitch-slot]');
    var slotsAt = 0;
    function slotEmpty() {
      slot.classList.toggle('is-empty', !slot.value);
      size(slot);
    }
    function loadSlots(force) {
      if (!api || !slot || (!force && Date.now() - slotsAt < 20000)) return Promise.resolve();
      slotsAt = Date.now();
      return fetch(api + '/slots', { headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw r; return r.json(); })
        .then(function (data) {
          var keep = slot.value;
          var free = data.slots.filter(function (x) { return x.available; });
          while (slot.options.length > 1) slot.remove(1);
          free.forEach(function (x) { slot.add(new Option(x.label, x.id)); });
          slot.value = free.some(function (x) { return x.id === keep; }) ? keep : '';
          slotEmpty();
          if (!free.length) status.textContent = msg('no-slots');
          else if (status.textContent === msg('no-slots') || status.textContent === msg('slots-failed')) status.textContent = '';
          updateSend();
        })
        .catch(function () { status.textContent = msg('slots-failed'); });
    }
    if (slot) {
      slot.addEventListener('change', slotEmpty);
      ['focus', 'pointerdown'].forEach(function (ev) { slot.addEventListener(ev, function () { loadSlots(false); }); });
      loadSlots(true);
    }

    // ---- Send to the booking service. Until it is set, say so instead. ---
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!api) { status.textContent = msg('not-sent'); return; }
      if (!form.reportValidity()) return;
      var body = {};
      new FormData(form).forEach(function (v, k) { body[k] = String(v); });
      send.disabled = true;
      status.textContent = msg('sending');
      fetch(api + '/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          if (res.ok) {
            status.textContent = msg('sent');
            form.classList.add('is-sent');
            [].forEach.call(form.elements, function (el) { el.disabled = true; });
            return;
          }
          status.textContent = (res.d && res.d.message) || msg('failed');
          if (res.d && (res.d.error === 'slot_taken' || res.d.error === 'unknown_slot')) {
            loadSlots(true).then(function () { slot.focus(); });
          } else if (res.d && res.d.field) {
            var f = form.querySelector('[name="' + res.d.field + '"]');
            if (f) f.focus();
          }
          updateSend();
        })
        .catch(function () {
          status.textContent = msg('failed');
          updateSend();
        });
    });

    function refit() {
      inputs.forEach(size);
      fit();
    }
    window.addEventListener('resize', refit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(refit);
    // Autofill or a restored form: write what is already there.
    if (company.value) write();
    else fit();
  })();
</script>

<style is:global>
  /* White from the header down to the facts (owner, 2026-10-26; before: a
     black block under the header, like the homepage intro). At least 80%
     of the viewport high (see .pitch__hero). */
  .pitch {
    background: var(--bg);
  }
</style>

<style>
  /* Spacing (owner, 2026-10-22: tightened throughout). The letter's line
     height is part of every gap around it, so the margins stay small. */
  .pitch__hero {
    padding-top: var(--gap); /* plus the header's own 24px bottom padding */
    padding-bottom: var(--gap-double);
    /* The white, header included, fills at least 80% of the viewport
       height (owner, 2026-10-26); the facts' black starts below it. */
    box-sizing: border-box;
    min-height: calc(80vh - var(--header-h));
    min-height: calc(80svh - var(--header-h));
  }
  /* The white ends where the facts' hairline was; the facts sit on black
     (owner, 2026-10-26), and the black footer runs on below them. */
  .pitch__info {
    background: var(--bg);
    padding-top: var(--gap);
    padding-bottom: var(--gap-double);
  }

  /* ---- H1: The ____ Pitch ------------------------------------------------ */
  /* Inter, a step heavier than body copy (owner, 2026-10-22), instead of
     the display face. */
  .pitch__title {
    --pitch-scale: 1;
    --pitch-max: 0.6; /* share of the content width the H1 may take */
    font-family: var(--font-sans);
    font-weight: 500;
    margin: var(--gap-half) 0 0;
    font-size: calc(var(--fs-display) * var(--pitch-scale));
    white-space: nowrap;
    transition: font-size 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pitch__line {
    display: inline-block;
  }
  .pitch__word,
  .pitch__blank {
    animation-delay: calc(var(--reveal-start) + var(--i) * var(--reveal-stagger));
  }
  /* "Slush" in the handwriting's gradient, so it reads as the source of
     the colours; ", Helsinki" stays ink (owner, 2026-10-26). */
  .pitch__eyebrow {
    background: var(--hand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .eyebrow.reveal-snap {
    animation-delay: calc(var(--reveal-start) - 4 * var(--reveal-frame));
  }
  /* The blank: a line on the baseline, 3.5em long while empty or short,
     growing with the handwritten name on it. */
  .pitch__blank {
    display: inline-block;
    min-width: 3.5em;
    margin-inline: 0.12em;
    padding-inline: 0.08em;
    border-bottom: max(2px, 0.035em) solid currentColor;
    line-height: 1;
    transition:
      min-width 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 240ms ease;
  }
  /* Once the name is being written the line steps back to light grey
     (owner, 2026-10-26). */
  .pitch__title.is-filled .pitch__blank {
    border-bottom-color: #c4c3be;
  }
  /* From 5 characters (or once the field is left) the line hugs the name. */
  .pitch__title.is-fit .pitch__blank {
    min-width: 0;
  }
  .pitch__hand {
    display: inline-block;
    font-family: var(--font-hand);
    font-size: var(--fs-hand);
    font-weight: 400;
    line-height: 1;
    white-space: pre;
    color: var(--hand-colour);
    transform: translateY(0.04em);
    position: relative; /* offset parent for the letters (gradient slices) */
  }
  /* Clicking the line types into the company name (see script). */
  .pitch__blank {
    cursor: text;
  }
  .pitch__title.is-typing .pitch__hand::after {
    content: '';
    display: inline-block;
    width: max(2px, 0.035em);
    height: 0.75em;
    margin-left: 0.04em;
    vertical-align: -0.05em;
    background: var(--hand-colour);
    animation: pitch-caret 1s steps(1) infinite;
  }
  @keyframes pitch-caret {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pitch__title.is-typing .pitch__hand::after {
      animation: none;
    }
  }

  /* ---- What the event is ------------------------------------------------ */
  .pitch__intro {
    max-width: var(--col-6);
    margin-top: var(--gap);
    animation-delay: calc(var(--reveal-start) + 3 * var(--reveal-stagger) + 2 * var(--reveal-frame));
  }
  .pitch__intro p {
    margin: 0;
  }
  .pitch__intro p + p {
    margin-top: var(--space-2x);
  }
  .pitch__intro a {
    text-underline-offset: 3px;
  }

  /* ---- The letter -------------------------------------------------------- */
  .pitch__form {
    margin-top: var(--gap);
  }
  .pitch__letter {
    position: relative;
    max-width: var(--col-8);
    margin: 0;
    font-size: var(--fs-metric);
    line-height: 1.35; /* normal text leading (owner, 2026-10-22) */
  }
  /* The labels and blanks take the letter's type, whatever the host page
     says about labels and inputs (Webflow styles them bold, smaller and as
     blocks; owner, 2026-10-26). */
  .pitch__field {
    display: inline;
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }
  .pitch__blank-wrap {
    white-space: nowrap;
  }
  .pitch__break {
    display: none;
  }
  .pitch__send[hidden],
  .pitch__privacy[hidden] {
    display: none;
  }
  /* Answers in Inter, a step heavier than the letter (owner, 2026-10-22),
     in the handwriting's gradient (owner, 2026-10-26; before: red); only
     the name on the H1's line is handwritten. */
  .pitch__input {
    font-family: var(--font-answer);
    font-size: 1em;
    font-weight: var(--fw-answer);
    letter-spacing: 0;
  }
  .pitch__input {
    height: auto;
    margin: 0;
    box-shadow: none;
    vertical-align: baseline;
    max-width: 100%;
    padding: 0 0.1em;
    border: 0;
    border-bottom: var(--hairline-w) solid var(--fg); /* the line stays black (owner, 2026-10-22) */
    border-radius: 0;
    background: var(--hand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    caret-color: var(--hand-colour);
    line-height: var(--lh-metric); /* inside the letter's line, so it does not push lines apart */
    outline: none;
    box-sizing: content-box;
  }
  /* While empty, no gradient: it would tint the placeholder too. */
  .pitch__input:placeholder-shown {
    background: none;
  }
  .pitch__input::placeholder {
    color: var(--muted);
    -webkit-text-fill-color: var(--muted);
    opacity: 0.75;
  }
  /* Browser autofill: browsers paint their own background and drop the
     gradient, which left the text light grey (owner, 2026-10-26). The
     answer shows in the gradient's first colour instead, on the page's own
     background (an inset shadow covers the browser's tint; the underline is
     outside it). */
  .pitch__input:-webkit-autofill,
  .pitch__input:-webkit-autofill:hover,
  .pitch__input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--hand-colour);
    caret-color: var(--hand-colour);
    box-shadow: 0 0 0 1000px var(--bg) inset;
    transition: background-color 600000s 0s;
    animation: pitch-autofill 1ms;
  }
  .pitch__input:autofill {
    -webkit-text-fill-color: var(--hand-colour);
    box-shadow: 0 0 0 1000px var(--bg) inset;
  }
  @keyframes pitch-autofill {
    from {
      opacity: 1;
    }
    to {
      opacity: 1;
    }
  }
  .pitch__input:user-invalid {
    border-bottom-style: dashed;
    border-bottom-color: var(--error-colour);
  }
  /* The pitch time: a choice styled as one more blank (no arrow box); the
     list of times opens on click. Empty, it shows its hint like the others. */
  .pitch__select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    border-radius: 0;
  }
  .pitch__select.is-empty {
    background: none;
    -webkit-text-fill-color: var(--muted);
    color: var(--muted);
    opacity: 0.75;
  }
  .pitch__select option {
    color: var(--fg);
    -webkit-text-fill-color: var(--fg);
    background: var(--bg);
  }
  /* Honeypot, off screen (not display: none, which some bots skip). */
  .pitch__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .pitch__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap);
    margin-top: var(--gap);
  }
  .pitch__letter.reveal-gentle {
    animation-delay: calc(var(--reveal-start) + 3 * var(--reveal-stagger) + 4 * var(--reveal-frame));
  }
  .pitch__status {
    margin: 0;
    color: var(--muted);
  }
  .pitch__privacy {
    max-width: var(--col-6);
    margin: var(--space-4x) 0 0;
    color: var(--muted);
  }

  /* ---- Event facts ------------------------------------------------------- */
  .pitch__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
    margin: 0;
  }
  .pitch__facts dt {
    color: var(--muted);
  }
  .pitch__facts dd {
    margin: var(--space-2x) 0 0;
  }

  @media (max-width: 880px) {
    .pitch__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .pitch__hero {
      padding-bottom: var(--space-8x);
    }
    .pitch__info {
      padding-bottom: var(--gap);
    }
    .pitch__title {
      --pitch-max: 0.9; /* 60% would make the H1 smaller than the letter */
    }
    .pitch__intro {
      margin-top: var(--space-4x);
    }
    .pitch__form {
      margin-top: var(--space-4x);
    }
    .pitch__break {
      display: inline;
    }
    .pitch__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4x);
    }
  }
</style>

<style is:global>
  /* Handwriting tokens (this page only). */
  .pitch {
    /* Covered By Your Grace (owner, 2026-10-22; before: Permanent Marker,
       Nothing You Could Do). A bold marker hand with small letters, so set
       larger than the text. */
    --font-hand: "Covered By Your Grace", "Marker Felt", "Segoe Print", cursive;
    --fs-hand: 1.3em;
    /* What the visitor types into the letter. */
    --font-answer: var(--font-sans);
    --fw-answer: 500;
    /* The handwriting and the answers: one gradient, bottom left to top
       right (owner, 2026-10-26; before: red marker #e0251b, as in the
       owner's reference of 2026-10-21). Red stays for an invalid answer. */
    --hand-colour: #04edcd;
    --hand-gradient: linear-gradient(to top right, #04edcd, #05f46b);
    --error-colour: #e0251b;
  }
  /* Measuring helpers made in script (so outside the scoped styles): the
     H1's base size, and the width of a blank's text. */
  .pitch__probe,
  .pitch__meter {
    position: absolute;
    top: 0;
    left: 0;
    visibility: hidden;
    pointer-events: none;
    white-space: pre;
  }
  .pitch__probe {
    font-size: var(--fs-display);
  }
  .pitch__meter {
    font-family: var(--font-answer);
    font-size: 1em;
    font-weight: var(--fw-answer);
  }
  /* A sentence of the letter (or the button) appearing: a gentle fade in,
     like the body copy. */
  .pitch .is-entering {
    animation: reveal-gentle var(--reveal-gentle) var(--reveal-gentle-ease) both;
  }
  /* Each new letter is written in: wiped open left to right while it settles
     from a slight lift. Spans are made in script, so the styles are global. */
  /* Gradient from #04EDCD to #05F46B, bottom left to top right, over the
     whole name (owner, 2026-10-26; before: red #FF0000 to #8A0A00, left
     to right).
     Each letter paints its slice (--hw-x of --hw-w, set by script); the
     padding, taken back by negative margins, gives overhanging strokes of the
     hand room inside the painted area. */
  .pitch__letter-hw {
    --pad: 0.2em;
    display: inline-block;
    padding: var(--pad);
    margin: calc(-1 * var(--pad));
    background-image: var(--hand-gradient);
    background-size: var(--hw-w, 1em) 100%;
    background-position: calc(-1 * var(--hw-x, 0em)) 0;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: translateY(var(--y, 0)) rotate(var(--r, 0deg));
    animation: pitch-write 300ms cubic-bezier(0.3, 0.6, 0.2, 1) backwards;
  }
  @keyframes pitch-write {
    from {
      clip-path: inset(-0.6em 100% -0.6em -0.6em);
      transform: translateY(calc(var(--y, 0em) - 0.06em)) rotate(var(--r, 0deg));
    }
    to {
      clip-path: inset(-0.6em -0.6em -0.6em -0.6em);
      transform: translateY(var(--y, 0)) rotate(var(--r, 0deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pitch__letter-hw {
      animation: none;
    }
  }
</style>
