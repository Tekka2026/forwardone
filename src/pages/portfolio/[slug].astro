---
/**
 * Company pages. Paths come from the case studies on the homepage until the
 * portfolio collection is migrated. /portfolio-companies/:slug redirects here.
 */
import Stub from '@layouts/Stub.astro';
import { allCaseStudies } from '@content/home';

export function getStaticPaths() {
  return allCaseStudies.map((c) => ({ params: { slug: c.slug }, props: { company: c } }));
}

const { company } = Astro.props;
---

<Stub
  section="Portfolio"
  title={company.name}
  intro={company.outcome}
  todos={['Company profile (migrate from current /portfolio-companies page)', 'Outcome metric: ' + company.metric, 'Logo and imagery']}
/>
